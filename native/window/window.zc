// Cross-platform window API (abstraction layer).
// Pure Zen-C — structs, enums, accessors, platform trampolines.
// Zero raw blocks.

import "std/map.zc";
import "stdio.h" as c;
import "./events.zc";

// --- Types ---

enum TitleBarStyle {
    Default,
    Hidden,
    HiddenInset,
}

// Per-button state for the macOS traffic lights (close/minimize/zoom).
// - Enabled: default, clickable.
// - Disabled: greyed out but still drawn (user sees the button as unavailable).
// - Hidden: button not drawn at all (leaves a gap — pair with a custom
//   titlebar if you want a clean look).
enum ButtonState {
    Enabled,
    Disabled,
    Hidden,
}

struct TrafficLights {
    close: ButtonState;
    minimize: ButtonState;
    zoom: ButtonState;
}

struct WindowOptions {
    title: string;
    url: string;   // Override initial URL (empty = use default)
    width: int;
    height: int;
    x: int;
    y: int;
    visible: bool;
    resizable: bool;
    closable: bool;
    minimizable: bool;
    maximizable: bool;
    fullscreen: bool;
    borderless: bool;
    transparent: bool;
    hidden: bool;
    alwaysOnTop: bool;
    titleBarStyle: TitleBarStyle;
    trafficLights: TrafficLights;
    webContentInspectable: int; // -1 = inherit, 0 = off, 1 = on
    acceptFirstMouse: bool;     // macOS: click unfocused window also activates a control
    // -1 = not a sheet. Otherwise the numeric ID of the parent window
    // this should be attached to as a sheet immediately after creation.
    // Setting this also forces visible=false so the modal never flashes
    // as a free-floating window before beginSheet wraps it.
    asSheetOfId: int;
    // Sheet presentation style on iOS — values match the int enum that
    // ios/window.m attach_modal reads:
    //   0 = page (UIModalPresentationPageSheet — default)
    //   1 = form (UIModalPresentationFormSheet)
    //   2 = fullscreen (UIModalPresentationFullScreen)
    //   3 = bottomSheet (UISheetPresentationController, iOS 15+)
    // No-op on macOS (NSWindow.beginSheet is single-style).
    sheetPresentation: int;
    // bottomSheet detents bitmask (iOS 15+ UISheetPresentationController):
    //   bit 0 = .medium
    //   bit 1 = .large
    // 0 → defaults to .large only. Ignored unless presentation == 3.
    sheetDetents: int;
    // Show the small drag-handle "grabber" at the top of the sheet —
    // makes swipe-to-dismiss obviously discoverable on iPhone full-
    // width sheets. iOS 15+ only, ignored otherwise.
    sheetGrabber: bool;
    // macOS NSVisualEffectView material — when non-empty, an
    // NSVisualEffectView with this material is mounted as the
    // window's content view and the WKWebView is added as its
    // subview with transparent drawing. The web content needs a
    // transparent or translucent CSS background for the vibrancy
    // to show through. Recognised values match macOS material
    // constants: "sidebar", "headerView", "titlebar", "menu",
    // "popover", "hudWindow", "fullScreenUI", "sheet",
    // "windowBackground", "contentBackground",
    // "underWindowBackground", "underPageBackground".
    vibrancy: string;
    _vibrancy_heap: bool;
    // Sidebar (native NSSplitViewItem sidebar; macOS only).
    sidebarUrl: string;        // empty = no sidebar
    _sidebarUrl_heap: bool;
    sidebarMaterial: string;   // default "sidebar"
    _sidebarMaterial_heap: bool;
    sidebarWidth: int;         // default 260
    sidebarMinWidth: int;      // default 180
    sidebarMaxWidth: int;      // default 400
    sidebarCollapsible: bool;  // default true
    sidebarCollapsed: bool;    // default false
    // Numeric window id pre-assigned by WindowManager.create *before*
    // the native window is built. Native code uses this so the JS
    // bootstrap user script can bake in the canonical "win-<N>" id —
    // otherwise the page loads with no windowId and Window.current()
    // throws at module-top before darwin_window_register_numeric_id
    // can finish. -1 = unassigned (treated as "use ptr fallback").
    numericIdPreAlloc: int;
    // Center on the active screen at create time. Overrides x/y if both
    // are set. With frameAutosaveName, the saved frame still wins on
    // restore — autoCenter is the first-launch fallback.
    autoCenter: bool;
    // Empty = no autosave. Otherwise calls NSWindow setFrameAutosaveName:
    // which persists frame (position + size) to NSUserDefaults under this
    // name and restores it on subsequent launches. AppKit handles the
    // round-trip; the framework just exposes the knob.
    frameAutosaveName: string;
    _frameAutosaveName_heap: bool;

    // Ownership flags for the two string fields. `window_opts_apply_json`
    // strdups values it pulls from a JsonValue tree and sets the flag;
    // `window_opts_free` frees only what it allocated. Direct assignment
    // (e.g. `opts.title = "Zapp"` with a literal or caller-owned string)
    // leaves these false — free() becomes a no-op for that field.
    _title_heap: bool;
    _url_heap: bool;
}

struct WindowSize {
    width: int;
    height: int;
}

struct WindowPosition {
    x: int;
    y: int;
}

// WindowEventData must be a raw typedef — raw blocks in callbacks.zc stack-allocate it
raw {
    #ifndef ZAPP_WINDOW_EVENT_DATA_DEFINED
    #define ZAPP_WINDOW_EVENT_DATA_DEFINED
    typedef struct WindowEventData {
        int32_t event;
        int32_t width;
        int32_t height;
        int32_t x;
        int32_t y;
    } WindowEventData;
    #endif
}

// --- WindowOptions default ---

impl WindowOptions {
    fn create(title: string) -> WindowOptions {
        return WindowOptions{
            title: title,
            url: "",
            width: 1200,
            height: 800,
            x: 0,
            y: 0,
            visible: true,
            resizable: true,
            closable: true,
            minimizable: true,
            maximizable: true,
            fullscreen: false,
            borderless: false,
            transparent: false,
            hidden: false,
            alwaysOnTop: false,
            titleBarStyle: TitleBarStyle::Default(),
            trafficLights: TrafficLights{
                close: ButtonState::Enabled(),
                minimize: ButtonState::Enabled(),
                zoom: ButtonState::Enabled(),
            },
            webContentInspectable: -1,
            acceptFirstMouse: true,
            asSheetOfId: -1,
            sheetPresentation: 0,
            sheetDetents: 0,
            sheetGrabber: false,
            vibrancy: "",
            _vibrancy_heap: false,
            sidebarUrl: "",
            _sidebarUrl_heap: false,
            sidebarMaterial: "",
            _sidebarMaterial_heap: false,
            sidebarWidth: 260,
            sidebarMinWidth: 180,
            sidebarMaxWidth: 400,
            sidebarCollapsible: true,
            sidebarCollapsed: false,
            numericIdPreAlloc: -1,
            autoCenter: false,
            frameAutosaveName: "",
            _frameAutosaveName_heap: false,
            _title_heap: false,
            _url_heap: false,
        };
    }
}

// --- WindowOptions accessor functions ---
// Called by .m code through the C header. Bridges Zen-C struct fields to C.
// Pure Zen-C — no raw blocks, auto-deref on pointer fields.

fn wopts_title(opts: WindowOptions*) -> string { return opts.title; }
fn wopts_url(opts: WindowOptions*) -> string { return opts.url; }
fn wopts_width(opts: WindowOptions*) -> int { return opts.width; }
fn wopts_height(opts: WindowOptions*) -> int { return opts.height; }
fn wopts_x(opts: WindowOptions*) -> int { return opts.x; }
fn wopts_y(opts: WindowOptions*) -> int { return opts.y; }
fn wopts_visible(opts: WindowOptions*) -> bool { return opts.visible; }
fn wopts_resizable(opts: WindowOptions*) -> bool { return opts.resizable; }
fn wopts_closable(opts: WindowOptions*) -> bool { return opts.closable; }
fn wopts_minimizable(opts: WindowOptions*) -> bool { return opts.minimizable; }
fn wopts_maximizable(opts: WindowOptions*) -> bool { return opts.maximizable; }
fn wopts_fullscreen(opts: WindowOptions*) -> bool { return opts.fullscreen; }
fn wopts_borderless(opts: WindowOptions*) -> bool { return opts.borderless; }
fn wopts_transparent(opts: WindowOptions*) -> bool { return opts.transparent; }
fn wopts_hidden(opts: WindowOptions*) -> bool { return opts.hidden; }
fn wopts_always_on_top(opts: WindowOptions*) -> bool { return opts.alwaysOnTop; }
fn wopts_inspectable(opts: WindowOptions*) -> int { return opts.webContentInspectable; }
fn wopts_accept_first_mouse(opts: WindowOptions*) -> bool { return opts.acceptFirstMouse; }
fn wopts_auto_center(opts: WindowOptions*) -> bool { return opts.autoCenter; }
fn wopts_frame_autosave_name(opts: WindowOptions*) -> string { return opts.frameAutosaveName; }
fn wopts_numeric_id_pre_alloc(opts: WindowOptions*) -> int { return opts.numericIdPreAlloc; }
fn wopts_vibrancy(opts: WindowOptions*) -> string { return opts.vibrancy; }
fn wopts_sidebar_url(opts: WindowOptions*) -> string { return opts.sidebarUrl; }
fn wopts_sidebar_material(opts: WindowOptions*) -> string { return opts.sidebarMaterial; }
fn wopts_sidebar_width(opts: WindowOptions*) -> int { return opts.sidebarWidth; }
fn wopts_sidebar_min_width(opts: WindowOptions*) -> int { return opts.sidebarMinWidth; }
fn wopts_sidebar_max_width(opts: WindowOptions*) -> int { return opts.sidebarMaxWidth; }
fn wopts_sidebar_collapsible(opts: WindowOptions*) -> bool { return opts.sidebarCollapsible; }
fn wopts_sidebar_collapsed(opts: WindowOptions*) -> bool { return opts.sidebarCollapsed; }
fn wopts_sheet_presentation(opts: WindowOptions*) -> int { return opts.sheetPresentation; }
fn wopts_sheet_detents(opts: WindowOptions*) -> int { return opts.sheetDetents; }
fn wopts_sheet_grabber(opts: WindowOptions*) -> bool { return opts.sheetGrabber; }

// Traffic light state tags (0=Enabled, 1=Disabled, 2=Hidden).
fn wopts_traffic_light_close_tag(opts: WindowOptions*) -> int {
    match opts.trafficLights.close {
        ButtonState::Enabled => { return 0; },
        ButtonState::Disabled => { return 1; },
        ButtonState::Hidden => { return 2; },
    }
    return 0;
}
fn wopts_traffic_light_minimize_tag(opts: WindowOptions*) -> int {
    match opts.trafficLights.minimize {
        ButtonState::Enabled => { return 0; },
        ButtonState::Disabled => { return 1; },
        ButtonState::Hidden => { return 2; },
    }
    return 0;
}
fn wopts_traffic_light_zoom_tag(opts: WindowOptions*) -> int {
    match opts.trafficLights.zoom {
        ButtonState::Enabled => { return 0; },
        ButtonState::Disabled => { return 1; },
        ButtonState::Hidden => { return 2; },
    }
    return 0;
}

// Apply JS-side WindowOptions (parsed into a JsonValue) onto a native
// WindowOptions struct. Used by both the webview path (router.zc's
// __window:create) and the worker path (zapp_worker_create_window_from_json)
// so Window.create({ titleBarStyle, acceptFirstMouse, ... }) plumbs every
// field, not just title/url/width/height. Fields omitted in the JSON keep
// their defaults from WindowOptions::create().
//
// String fields (title, url) are strdup'd out of the JsonValue tree so
// `opts` becomes self-contained — callers can drop the tree immediately
// after this returns without invalidating opts.title / opts.url. Pair
// with `window_opts_free(&opts)` after `app.window.create(&opts)` to
// release the heap-owned strings. Call sites that never invoke
// apply_json don't need to call free (ownership flags are false).
fn window_opts_apply_json(opts: WindowOptions*, args: JsonValue*) -> void {
    if args == NULL { return; }

    let title_opt = args.get_string("title");
    if title_opt.is_some() {
        let src = title_opt.unwrap();
        raw {
            if (opts->_title_heap && opts->title) free((void*)opts->title);
            opts->title = strdup((const char*)src);
            opts->_title_heap = 1;
        }
    }
    let url_opt = args.get_string("url");
    if url_opt.is_some() {
        let src = url_opt.unwrap();
        raw {
            if (opts->_url_heap && opts->url) free((void*)opts->url);
            opts->url = strdup((const char*)src);
            opts->_url_heap = 1;
        }
    }

    let w_opt = args.get_int("width");
    if w_opt.is_some() { opts.width = w_opt.unwrap(); }
    let h_opt = args.get_int("height");
    if h_opt.is_some() { opts.height = h_opt.unwrap(); }
    let x_opt = args.get_int("x");
    if x_opt.is_some() { opts.x = x_opt.unwrap(); }
    let y_opt = args.get_int("y");
    if y_opt.is_some() { opts.y = y_opt.unwrap(); }

    let visible_opt = args.get_bool("visible");
    if visible_opt.is_some() { opts.visible = visible_opt.unwrap(); }
    let resizable_opt = args.get_bool("resizable");
    if resizable_opt.is_some() { opts.resizable = resizable_opt.unwrap(); }
    // Legacy closable/minimizable/maximizable booleans are sugar for the
    // corresponding trafficLights.*.Disabled state. An explicit
    // trafficLights object (parsed after this block) overrides these.
    let closable_opt = args.get_bool("closable");
    if closable_opt.is_some() {
        let cb = closable_opt.unwrap();
        opts.closable = cb;
        if !cb { opts.trafficLights.close = ButtonState::Disabled(); }
    }
    let minimizable_opt = args.get_bool("minimizable");
    if minimizable_opt.is_some() {
        let mb = minimizable_opt.unwrap();
        opts.minimizable = mb;
        if !mb { opts.trafficLights.minimize = ButtonState::Disabled(); }
    }
    let maximizable_opt = args.get_bool("maximizable");
    if maximizable_opt.is_some() {
        let xb = maximizable_opt.unwrap();
        opts.maximizable = xb;
        if !xb { opts.trafficLights.zoom = ButtonState::Disabled(); }
    }
    let fullscreen_opt = args.get_bool("fullscreen");
    if fullscreen_opt.is_some() { opts.fullscreen = fullscreen_opt.unwrap(); }
    let borderless_opt = args.get_bool("borderless");
    if borderless_opt.is_some() { opts.borderless = borderless_opt.unwrap(); }
    let transparent_opt = args.get_bool("transparent");
    if transparent_opt.is_some() { opts.transparent = transparent_opt.unwrap(); }
    let hidden_opt = args.get_bool("hidden");
    if hidden_opt.is_some() { opts.hidden = hidden_opt.unwrap(); }
    let aot_opt = args.get_bool("alwaysOnTop");
    if aot_opt.is_some() { opts.alwaysOnTop = aot_opt.unwrap(); }

    let vibrancy_opt = args.get_string("vibrancy");
    if vibrancy_opt.is_some() {
        let src = vibrancy_opt.unwrap();
        raw {
            if (opts->_vibrancy_heap && opts->vibrancy) free((void*)opts->vibrancy);
            opts->vibrancy = strdup((const char*)src);
            opts->_vibrancy_heap = 1;
        }
    }
    // Sidebar: a nested object { url, material, width, minWidth, maxWidth,
    // collapsible, collapsed }. get_object returns the BORROWED child node
    // straight out of the parent's Map (no copy / no alloc), so its lifetime
    // is the parent tree's — we strdup the strings out and must NOT free the
    // node itself.
    let sb_opt = args.get_object("sidebar");
    if sb_opt.is_some() {
        let sb = sb_opt.unwrap();
        let su = (*sb).get_string("url");
        if su.is_some() {
            let src = su.unwrap();
            raw {
                if (opts->_sidebarUrl_heap && opts->sidebarUrl) free((void*)opts->sidebarUrl);
                opts->sidebarUrl = strdup((const char*)src);
                opts->_sidebarUrl_heap = 1;
            }
        }
        let sm = (*sb).get_string("material");
        if sm.is_some() {
            let src = sm.unwrap();
            raw {
                if (opts->_sidebarMaterial_heap && opts->sidebarMaterial) free((void*)opts->sidebarMaterial);
                opts->sidebarMaterial = strdup((const char*)src);
                opts->_sidebarMaterial_heap = 1;
            }
        }
        let sw = (*sb).get_int("width");        if sw.is_some() { opts.sidebarWidth = sw.unwrap(); }
        let smin = (*sb).get_int("minWidth");   if smin.is_some() { opts.sidebarMinWidth = smin.unwrap(); }
        let smax = (*sb).get_int("maxWidth");   if smax.is_some() { opts.sidebarMaxWidth = smax.unwrap(); }
        let sc = (*sb).get_bool("collapsible"); if sc.is_some() { opts.sidebarCollapsible = sc.unwrap(); }
        let sco = (*sb).get_bool("collapsed");  if sco.is_some() { opts.sidebarCollapsed = sco.unwrap(); }
    }

    let afm_opt = args.get_bool("acceptFirstMouse");
    if afm_opt.is_some() { opts.acceptFirstMouse = afm_opt.unwrap(); }

    let ac_opt = args.get_bool("autoCenter");
    if ac_opt.is_some() { opts.autoCenter = ac_opt.unwrap(); }

    let fas_opt = args.get_string("frameAutosaveName");
    if fas_opt.is_some() {
        let src = fas_opt.unwrap();
        raw {
            if (opts->_frameAutosaveName_heap && opts->frameAutosaveName) free((void*)opts->frameAutosaveName);
            opts->frameAutosaveName = strdup((const char*)src);
            opts->_frameAutosaveName_heap = 1;
        }
    }

    // asSheetOf: accept either a number (raw numeric ID) or a string
    // window ID. JS-visible window IDs are pointer-based ("win-0xPTR"),
    // not numeric, so the string path is the common one and resolves via
    // darwin_window_numeric_id_for_string. WindowManager::create then
    // attaches as a sheet atomically and forces visible=false to suppress
    // the flash.
    let aso_int = args.get_int("asSheetOf");
    if aso_int.is_some() {
        opts.asSheetOfId = aso_int.unwrap();
    } else {
        let aso_str = args.get_string("asSheetOf");
        if aso_str.is_some() {
            let s: string = aso_str.unwrap();
            raw {
                #ifdef __APPLE__
                extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                int32_t found = darwin_window_numeric_id_for_string((const char*)s);
                if (found >= 0) {
                    opts->asSheetOfId = (int)found;
                }
                #endif
            }
        }
    }

    // Sheet presentation style (iOS-only, no-op elsewhere).
    let pres_opt = args.get_string("presentation");
    if pres_opt.is_some() {
        let pres: string = pres_opt.unwrap();
        if pres == "page" { opts.sheetPresentation = 0; }
        else if pres == "form" { opts.sheetPresentation = 1; }
        else if pres == "fullscreen" { opts.sheetPresentation = 2; }
        else if pres == "bottomSheet" { opts.sheetPresentation = 3; }
    }
    let detents_opt = args.get_array("detents");
    if detents_opt.is_some() {
        let arr: JsonValue* = detents_opt.unwrap();
        let bits: int = 0;
        let n = arr.len();
        let i: usize = 0;
        while i < n {
            let item_opt = arr.at(i);
            if item_opt.is_some() {
                let item: JsonValue* = item_opt.unwrap();
                if item.is_string() {
                    let s_opt = item.as_string();
                    if s_opt.is_some() {
                        let s: string = s_opt.unwrap();
                        if s == "medium" { bits = bits | 1; }
                        else if s == "large" { bits = bits | 2; }
                        else if s == "small" { bits = bits | 4; }
                    }
                }
            }
            i = i + 1;
        }
        opts.sheetDetents = bits;
    }
    let grab_opt = args.get_bool("grabber");
    if grab_opt.is_some() { opts.sheetGrabber = grab_opt.unwrap(); }

    // titleBarStyle is a string enum on the JS side
    // ("default" | "hidden" | "hiddenInset") mapped into the native
    // TitleBarStyle tagged union.
    //
    // Note on the explicit `: string` type annotation: without it, Zen-C
    // generates `ZC_AUTO tbs = tbs_opt.unwrap();` and the subsequent
    // `tbs == "hiddenInset"` transpiles to a raw C pointer compare (!)
    // instead of `strcmp`. Type-inferring through the generic
    // `Option<T>.unwrap()` apparently loses the concrete `string` tag
    // that zc uses to pick the string-equality codegen path. Direct
    // field access (`parsed.method == "..."` in router.zc) works
    // without the hint because the field's declared type is visible.
    let tbs_opt = args.get_string("titleBarStyle");
    if tbs_opt.is_some() {
        let tbs: string = tbs_opt.unwrap();
        if tbs == "hiddenInset" {
            opts.titleBarStyle = TitleBarStyle::HiddenInset();
        } else if tbs == "hidden" {
            opts.titleBarStyle = TitleBarStyle::Hidden();
        } else {
            opts.titleBarStyle = TitleBarStyle::Default();
        }
    }

    // trafficLights: { close?, minimize?, zoom? } where each is
    // "enabled" | "disabled" | "hidden". Parsed after the legacy booleans
    // so an explicit object always wins. Fields omitted from the object
    // keep whatever state was already set (default Enabled, or Disabled
    // from a legacy boolean above).
    let tl_opt = args.get_object("trafficLights");
    if tl_opt.is_some() {
        let tl = tl_opt.unwrap();
        let close_opt = tl.get_string("close");
        if close_opt.is_some() {
            let cs: string = close_opt.unwrap();
            if cs == "hidden" {
                opts.trafficLights.close = ButtonState::Hidden();
            } else if cs == "disabled" {
                opts.trafficLights.close = ButtonState::Disabled();
            } else {
                opts.trafficLights.close = ButtonState::Enabled();
            }
        }
        let min_opt = tl.get_string("minimize");
        if min_opt.is_some() {
            let ms: string = min_opt.unwrap();
            if ms == "hidden" {
                opts.trafficLights.minimize = ButtonState::Hidden();
            } else if ms == "disabled" {
                opts.trafficLights.minimize = ButtonState::Disabled();
            } else {
                opts.trafficLights.minimize = ButtonState::Enabled();
            }
        }
        let zoom_opt = tl.get_string("zoom");
        if zoom_opt.is_some() {
            let zs: string = zoom_opt.unwrap();
            if zs == "hidden" {
                opts.trafficLights.zoom = ButtonState::Hidden();
            } else if zs == "disabled" {
                opts.trafficLights.zoom = ButtonState::Disabled();
            } else {
                opts.trafficLights.zoom = ButtonState::Enabled();
            }
        }
    }
}

// Free any heap-allocated strings that `window_opts_apply_json` strdup'd
// into the WindowOptions. Safe to call multiple times, safe on a
// WindowOptions that never saw apply_json (ownership flags are false).
// Call after `app.window.create(&opts)` — the native side copies titles
// and URLs into its own storage during construction, so the strings
// aren't needed afterwards.
fn window_opts_free(opts: WindowOptions*) -> void {
    raw {
        if (opts->_title_heap && opts->title) {
            free((void*)opts->title);
            opts->title = "";
            opts->_title_heap = 0;
        }
        if (opts->_url_heap && opts->url) {
            free((void*)opts->url);
            opts->url = "";
            opts->_url_heap = 0;
        }
        if (opts->_frameAutosaveName_heap && opts->frameAutosaveName) {
            free((void*)opts->frameAutosaveName);
            opts->frameAutosaveName = "";
            opts->_frameAutosaveName_heap = 0;
        }
        if (opts->_vibrancy_heap && opts->vibrancy) {
            free((void*)opts->vibrancy);
            opts->vibrancy = "";
            opts->_vibrancy_heap = 0;
        }
        if (opts->_sidebarUrl_heap && opts->sidebarUrl) {
            free((void*)opts->sidebarUrl);
            opts->sidebarUrl = "";
            opts->_sidebarUrl_heap = 0;
        }
        if (opts->_sidebarMaterial_heap && opts->sidebarMaterial) {
            free((void*)opts->sidebarMaterial);
            opts->sidebarMaterial = "";
            opts->_sidebarMaterial_heap = 0;
        }
    }
}

fn wopts_title_bar_style_tag(opts: WindowOptions*) -> int {
    match opts.titleBarStyle {
        TitleBarStyle::Default => { return 0; },
        TitleBarStyle::Hidden => { return 1; },
        TitleBarStyle::HiddenInset => { return 2; },
    }
    return 0;
}

// --- Window struct ---

struct Window {
    id: int;
    handle: void*;
}

impl Window {
    fn on(self, event_id: int, cb: fn*(WindowEventData*) -> int) -> void {
        zapp_window_set_event_cb(self.id, event_id, cb);
    }

    fn on_ready(self, cb: fn*(int, void*) -> void) -> void {
        zapp_window_set_on_ready(self.id, self.handle, cb);
    }

    fn show(self) -> void {
        if self.handle != NULL { window_show(self.handle); }
    }

    fn hide(self) -> void {
        if self.handle != NULL { window_hide(self.handle); }
    }

    fn close(self) -> void {
        if self.handle != NULL { window_force_close(self.handle); }
    }

    fn destroy(self) -> void {
        if self.handle != NULL { window_force_close(self.handle); }
    }

    fn set_title(self, title: string) -> void {
        if self.handle != NULL { window_set_title(self.handle, title); }
    }

    fn set_size(self, width: int, height: int) -> void {
        if self.handle != NULL { window_set_size(self.handle, width, height); }
    }

    fn set_position(self, x: int, y: int) -> void {
        if self.handle != NULL { window_set_position(self.handle, x, y); }
    }

    fn minimize(self) -> void {
        if self.handle != NULL { window_minimize(self.handle); }
    }

    fn maximize(self) -> void {
        if self.handle != NULL { window_maximize(self.handle); }
    }

    fn set_fullscreen(self, on: bool) -> void {
        if self.handle != NULL { window_set_fullscreen(self.handle, on); }
    }

    fn set_always_on_top(self, on: bool) -> void {
        if self.handle != NULL { window_set_always_on_top(self.handle, on); }
    }

    fn size(self) -> WindowSize {
        if self.handle != NULL { return window_get_size(self.handle); }
        return WindowSize{ width: 0, height: 0 };
    }

    fn position(self) -> WindowPosition {
        if self.handle != NULL { return window_get_position(self.handle); }
        return WindowPosition{ x: 0, y: 0 };
    }

    fn is_valid(self) -> bool { return self.handle != NULL; }

    fn set_close_guard(self, enabled: bool) -> void {
        let wid = self.id;
        raw {
            extern void zapp_window_set_close_guard(int id, int enabled);
            zapp_window_set_close_guard(wid, enabled ? 1 : 0);
        }
    }

    fn load_url(self, url: string) -> void {
        window_load_url(self.id, url);
    }

    // Attach `modal` as a sheet on `self`. Modal is shown anchored to the
    // parent's titlebar and blocks interaction with the parent (but not
    // the rest of the app) until dismissed.
    //
    // Compatible WindowOptions on the modal: title, url, width, height,
    // transparent, webContentInspectable. Position/fullscreen/borderless/
    // titleBarStyle/trafficLights/alwaysOnTop are ignored — sheets are
    // chrome-less and anchored to the parent.
    //
    // Dismiss either by closing the modal (window button, modal.close(),
    // or modal.destroy()) or explicitly with parent.detach_modal(modal).
    fn attach_modal(self, modal: Window) -> void {
        if self.handle == NULL || modal.handle == NULL { return; }
        window_attach_modal(self.handle, modal.handle);
    }

    // Dismiss a previously-attached modal sheet without closing the modal
    // window itself. Use `modal.close()` if you also want the modal gone.
    fn detach_modal(self, modal: Window) -> void {
        if self.handle == NULL || modal.handle == NULL { return; }
        window_detach_modal(self.handle, modal.handle);
    }
}

// --- Window Manager ---

struct App;

struct WindowManager {
    app: App*;
    webContentInspectable: bool;
    handles: Map<void*>;
    next_id: int;
}

impl WindowManager {
    fn new() -> Self {
        return WindowManager{
            app: NULL,
            webContentInspectable: true,
            handles: Map<void*>::new(),
            next_id: 0,
        };
    }

    fn create(self, options: WindowOptions*) -> Window {
        if options.webContentInspectable < 0 {
            if self.webContentInspectable {
                options.webContentInspectable = 1;
            } else {
                options.webContentInspectable = 0;
            }
        }
        // asSheetOf forces visible=false so the modal never appears as a
        // free-floating window before beginSheet wraps it. This eliminates
        // the visible-flash race that callers otherwise have to dodge by
        // remembering visible:false manually.
        if options.asSheetOfId >= 0 {
            options.visible = false;
        }
        // Pre-assign the numeric id so the native window-creation path
        // can bake "win-<N>" into the bootstrap user script. Otherwise
        // the page loads with no windowId and Window.current() throws
        // at module-top.
        let id = self.next_id;
        self.next_id += 1;
        options.numericIdPreAlloc = id;
        let handle = window_create(options);
        let key: char[32];
        c::snprintf(key, 32, "win-%d", id);
        self.handles.put(key, handle);
        window_register_numeric_id(handle, id);
        let new_window = Window{ id: id, handle: handle };

        // Atomic create+attach. The parent must already exist in the
        // manager — if it doesn't, the modal is created but free-floating
        // (caller can still `parent.attach_modal(modal)` later).
        if options.asSheetOfId >= 0 {
            let parent = self.get(options.asSheetOfId);
            if parent.is_valid() {
                parent.attach_modal(new_window);
            }
        }
        return new_window;
    }

    fn get(self, id: int) -> Window {
        let key: char[32];
        c::snprintf(key, 32, "win-%d", id);
        let maybe = self.handles.get(key);
        if maybe.is_some() {
            return Window{ id: id, handle: maybe.unwrap() };
        }
        return Window{ id: id, handle: NULL };
    }

    fn close(self, id: int) -> void {
        let key: char[32];
        c::snprintf(key, 32, "win-%d", id);
        let maybe = self.handles.get(key);
        if maybe.is_some() {
            self.handles.remove(key);
            window_destroy(maybe.unwrap());
        }
    }
}

// --- Platform dispatch trampolines ---
// Import the C header, call through to .m implementations.

@cfg(apple)
import "../platform/darwin/window.h" as darwin_win;
@cfg(apple)
import "../platform/darwin/webview.h" as darwin_webview;

@cfg(apple)
fn window_create(options: WindowOptions*) -> void* { return darwin_win::darwin_window_create(options); }
@cfg(apple)
fn window_destroy(handle: void*) -> void { darwin_win::darwin_window_destroy(handle); }
@cfg(apple)
fn window_show(handle: void*) -> void { darwin_win::darwin_window_show(handle); }
@cfg(apple)
fn window_hide(handle: void*) -> void { darwin_win::darwin_window_hide(handle); }
@cfg(apple)
fn window_force_close(handle: void*) -> void { darwin_win::darwin_window_force_close(handle); }
@cfg(apple)
fn window_register_numeric_id(handle: void*, id: int) -> void { darwin_win::darwin_window_register_numeric_id(handle, id); }
@cfg(apple)
fn window_minimize(handle: void*) -> void { darwin_win::darwin_window_minimize(handle); }
@cfg(apple)
fn window_focus(handle: void*) -> void { darwin_win::darwin_window_focus(handle); }
@cfg(apple)
fn window_maximize(handle: void*) -> void { darwin_win::darwin_window_maximize(handle); }
@cfg(apple)
fn window_set_title(handle: void*, title: string) -> void { darwin_win::darwin_window_set_title(handle, title); }
@cfg(apple)
fn window_set_size(handle: void*, w: int, h: int) -> void { darwin_win::darwin_window_set_size(handle, w, h); }
@cfg(apple)
fn window_set_position(handle: void*, x: int, y: int) -> void { darwin_win::darwin_window_set_position(handle, x, y); }
@cfg(apple)
fn window_set_fullscreen(handle: void*, on: bool) -> void { darwin_win::darwin_window_set_fullscreen(handle, on); }
@cfg(apple)
fn window_set_always_on_top(handle: void*, on: bool) -> void { darwin_win::darwin_window_set_always_on_top(handle, on); }

@cfg(apple)
fn window_get_size(handle: void*) -> WindowSize {
    let w: int = 0;
    let h: int = 0;
    darwin_win::darwin_window_get_size(handle, &w, &h);
    return WindowSize{ width: w, height: h };
}

@cfg(apple)
fn window_get_position(handle: void*) -> WindowPosition {
    let x: int = 0;
    let y: int = 0;
    darwin_win::darwin_window_get_position(handle, &x, &y);
    return WindowPosition{ x: x, y: y };
}

@cfg(apple)
fn window_load_url(id: int, url: string) -> void { darwin_webview::darwin_window_load_url(id, url); }

@cfg(apple)
fn window_attach_modal(parent: void*, modal: void*) -> void { darwin_win::darwin_window_attach_modal(parent, modal); }
@cfg(apple)
fn window_detach_modal(parent: void*, modal: void*) -> void { darwin_win::darwin_window_detach_modal(parent, modal); }

@cfg(windows)
import "../platform/windows/window.h" as win_window;

@cfg(windows)
fn window_create(options: WindowOptions*) -> void* { return win_window::windows_window_create(options); }
@cfg(windows)
fn window_destroy(handle: void*) -> void { win_window::windows_window_destroy(handle); }
@cfg(windows)
fn window_show(handle: void*) -> void { win_window::windows_window_show(handle); }
@cfg(windows)
fn window_hide(handle: void*) -> void { win_window::windows_window_hide(handle); }
@cfg(windows)
fn window_force_close(handle: void*) -> void { win_window::windows_window_force_close(handle); }
@cfg(windows)
fn window_register_numeric_id(handle: void*, id: int) -> void { win_window::windows_window_register_numeric_id(handle, id); }
@cfg(windows)
fn window_minimize(handle: void*) -> void { win_window::windows_window_minimize(handle); }
@cfg(windows)
fn window_focus(handle: void*) -> void { /* no-op on Windows — see #167 */ }
@cfg(windows)
fn window_maximize(handle: void*) -> void { win_window::windows_window_maximize(handle); }
@cfg(windows)
fn window_set_title(handle: void*, title: string) -> void { win_window::windows_window_set_title(handle, title); }
@cfg(windows)
fn window_set_size(handle: void*, w: int, h: int) -> void { win_window::windows_window_set_size(handle, w, h); }
@cfg(windows)
fn window_set_position(handle: void*, x: int, y: int) -> void { win_window::windows_window_set_position(handle, x, y); }
@cfg(windows)
fn window_set_fullscreen(handle: void*, on: bool) -> void { win_window::windows_window_set_fullscreen(handle, on); }
@cfg(windows)
fn window_set_always_on_top(handle: void*, on: bool) -> void { win_window::windows_window_set_always_on_top(handle, on); }

@cfg(windows)
fn window_attach_modal(parent: void*, modal: void*) -> void { win_window::windows_window_attach_modal(parent, modal); }
@cfg(windows)
fn window_detach_modal(parent: void*, modal: void*) -> void { win_window::windows_window_detach_modal(parent, modal); }

@cfg(windows)
fn window_get_size(handle: void*) -> WindowSize {
    let w: int = 0;
    let h: int = 0;
    win_window::windows_window_get_size(handle, &w, &h);
    return WindowSize{ width: w, height: h };
}

@cfg(windows)
fn window_get_position(handle: void*) -> WindowPosition {
    let x: int = 0;
    let y: int = 0;
    win_window::windows_window_get_position(handle, &x, &y);
    return WindowPosition{ x: x, y: y };
}
