// Worker engine abstraction — dispatches to JSC or txiki by per-worker
// engine selection (G8). The engine is captured at create time and
// stored on the registry entry; subsequent post / terminate look it
// up there so the rest of the framework just calls the unified
// `worker_*` functions without caring which engine owns each worker.
//
// Build flags:
//   - `ZAPP_WORKER_ENGINE_JSC`   — JSC engine present (Apple-only)
//   - `ZAPP_WORKER_ENGINE_TXIKI` — txiki engine present
// Both can be defined together for true per-worker mixing. When only
// one is defined, requests for the missing engine are silently
// downgraded to the present one (with a log line so the surprise is
// visible in dev).

import "./registry.zc";

// Engine .zc files just import their respective C headers so the
// extern symbols are visible to the raw-block dispatchers below.
import "./engines/jsc.zc";
import "./engines/txiki.zc";

fn workers_enabled() -> bool {
    raw {
        #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI)
        return true;
        #else
        return false;
        #endif
    }
    return false;
}

// Stub C symbols when no engine is defined — keeps the link clean
// for builds that don't enable either engine.
raw {
    #if !defined(ZAPP_WORKER_ENGINE_JSC) && !defined(ZAPP_WORKER_ENGINE_TXIKI)
    bool jsc_worker_create(const char* a, const char* b, const char* c) {
        (void)a; (void)b; (void)c; return false;
    }
    void jsc_worker_post_message(const char* a, const char* b) { (void)a; (void)b; }
    void jsc_worker_terminate(const char* a) { (void)a; }
    void jsc_worker_terminate_owner(const char* a) { (void)a; }
    bool txiki_worker_create(const char* a, const char* b, const char* c) {
        (void)a; (void)b; (void)c; return false;
    }
    void txiki_worker_post_message(const char* a, const char* b) { (void)a; (void)b; }
    void txiki_worker_terminate(const char* a) { (void)a; }
    void txiki_worker_terminate_owner(const char* a) { (void)a; }
    #endif
}

// --- Unified dispatchers ---
//
// `engine` matches `ZAPP_ENGINE_*` constants from registry.zc:
//   0 = JSC, 1 = txiki.
// The dispatcher logs a downgrade if the requested engine isn't
// compiled in, then falls back to whichever IS available.

fn worker_create(app: App*, script_url: string, owner_id: string,
                 worker_id: string, engine: int) -> bool {
    let _app = app;
    let result: bool = false;
    raw {
        int eng = (int)engine;
        #if defined(ZAPP_WORKER_ENGINE_TXIKI) && defined(ZAPP_WORKER_ENGINE_JSC)
        if (eng == 1) {
            result = txiki_worker_create((const char*)script_url, (const char*)owner_id, (const char*)worker_id);
        } else {
            result = jsc_worker_create((const char*)script_url, (const char*)owner_id, (const char*)worker_id);
        }
        #elif defined(ZAPP_WORKER_ENGINE_TXIKI)
        if (eng == 0) {
            fprintf(stderr, "[zapp] worker '%s' requested JSC but only txiki is compiled — using txiki.\n",
                (const char*)worker_id);
        }
        result = txiki_worker_create((const char*)script_url, (const char*)owner_id, (const char*)worker_id);
        #elif defined(ZAPP_WORKER_ENGINE_JSC)
        if (eng == 1) {
            fprintf(stderr, "[zapp] worker '%s' requested txiki but only JSC is compiled — using JSC.\n",
                (const char*)worker_id);
        }
        result = jsc_worker_create((const char*)script_url, (const char*)owner_id, (const char*)worker_id);
        #else
        result = false;
        #endif
    }
    return result;
}

fn worker_post_message(worker_id: string, data: string) -> void {
    raw {
        extern int zapp_worker_registry_get_engine(const char* worker_id);
        int eng = zapp_worker_registry_get_engine((const char*)worker_id);
        #if defined(ZAPP_WORKER_ENGINE_TXIKI) && defined(ZAPP_WORKER_ENGINE_JSC)
        if (eng == 1) txiki_worker_post_message((const char*)worker_id, (const char*)data);
        else          jsc_worker_post_message((const char*)worker_id, (const char*)data);
        #elif defined(ZAPP_WORKER_ENGINE_TXIKI)
        (void)eng;
        txiki_worker_post_message((const char*)worker_id, (const char*)data);
        #elif defined(ZAPP_WORKER_ENGINE_JSC)
        (void)eng;
        jsc_worker_post_message((const char*)worker_id, (const char*)data);
        #endif
    }
}

fn worker_terminate(worker_id: string) -> void {
    raw {
        extern int zapp_worker_registry_get_engine(const char* worker_id);
        int eng = zapp_worker_registry_get_engine((const char*)worker_id);
        #if defined(ZAPP_WORKER_ENGINE_TXIKI) && defined(ZAPP_WORKER_ENGINE_JSC)
        if (eng == 1) txiki_worker_terminate((const char*)worker_id);
        else          jsc_worker_terminate((const char*)worker_id);
        #elif defined(ZAPP_WORKER_ENGINE_TXIKI)
        (void)eng;
        txiki_worker_terminate((const char*)worker_id);
        #elif defined(ZAPP_WORKER_ENGINE_JSC)
        (void)eng;
        jsc_worker_terminate((const char*)worker_id);
        #endif
    }
}

// terminate_owner doesn't have a worker_id to look up — owner kills
// every worker spawned by that owner regardless of engine, so call
// both engines' implementations. They each iterate their own slot
// table and skip any worker that doesn't match.
fn worker_terminate_owner(owner_id: string) -> void {
    raw {
        #ifdef ZAPP_WORKER_ENGINE_JSC
        jsc_worker_terminate_owner((const char*)owner_id);
        #endif
        #ifdef ZAPP_WORKER_ENGINE_TXIKI
        txiki_worker_terminate_owner((const char*)owner_id);
        #endif
    }
}

// --- Workers namespace (Zen-C) ---
//
// Mirrors the runtime/worker.ts `Workers` namespace so Zen-C services
// and native code can manage workers by ID without raw blocks. Since
// Zen-C doesn't have a free-floating `module.fn` syntax, we use the
// established `struct Foo {} impl Foo { fn ... }` namespace pattern
// (also used by `Zapp` in app.zc).
//
// Usage:
//   Workers::terminate("h-sync");
//
// Recognised ID forms match the JS side: dedicated workers ("w-N"),
// headless workers ("h-<key>"), shared workers ("sw-N" — silently
// no-op since shared workers are refcount-based).
struct Workers {}

impl Workers {
    fn terminate(id: string) -> void {
        if id == "" { return; }
        // The native router already has all the policy (shared-vs-dedicated
        // refcount handling, registry cleanup) — the Zen-C wrapper just
        // forwards. Bypassing the router would duplicate that policy.
        raw {
            #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI)
            extern int zapp_worker_registry_is_shared(const char* worker_id);
            extern void zapp_worker_registry_remove(const char* worker_id);
            if (!zapp_worker_registry_is_shared((const char*)id)) {
                worker_terminate((char*)id);
                zapp_worker_registry_remove((const char*)id);
            }
            #endif
        }
    }
}
