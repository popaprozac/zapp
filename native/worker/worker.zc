// Worker engine abstraction — dispatches to one of several engines
// per-worker. Engine is captured at create time and stored on the
// registry entry; subsequent post / terminate look it up there so the
// rest of the framework just calls the unified `worker_*` functions
// without caring which engine owns each worker.
//
// Build flags:
//   - `ZAPP_WORKER_ENGINE_JSC`          — legacy: native Cocoa JSC
//   - `ZAPP_WORKER_ENGINE_TXIKI`        — legacy: txiki.js (QuickJS)
//   - `ZAPP_WORKER_ENGINE_BARE_JSC`     — Bare + libjsc
//   - `ZAPP_WORKER_ENGINE_BARE_V8`      — Bare + libjs (V8)
//   - `ZAPP_WORKER_ENGINE_BARE_QUICKJS` — Bare + libqjs
//   - `ZAPP_WORKER_ENGINE_BARE_MQJS`    — Bare + libmqjs
// Any combination can be defined together for per-worker mixing. When
// the requested engine isn't compiled in, the dispatcher logs a
// downgrade and falls back to the first available engine.

import "./registry.zc";

// Engine .zc files just import their respective C headers so the
// extern symbols are visible to the raw-block dispatchers below.
import "./engines/jsc.zc";
import "./engines/txiki.zc";
import "./engines/bare.zc";

raw {
    #define ZAPP_HAS_BARE \
        (defined(ZAPP_WORKER_ENGINE_BARE_V8)      || \
         defined(ZAPP_WORKER_ENGINE_BARE_JSC)     || \
         defined(ZAPP_WORKER_ENGINE_BARE_QUICKJS) || \
         defined(ZAPP_WORKER_ENGINE_BARE_MQJS))
}

fn workers_enabled() -> bool {
    raw {
        #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI) || ZAPP_HAS_BARE
        return true;
        #else
        return false;
        #endif
    }
    return false;
}

// Stub C symbols for engines that aren't compiled in — keeps the link
// clean. Each block emits stubs only when the corresponding engine is
// disabled, so the dispatcher below can call the same symbol names
// regardless of which engines were chosen at build time.
raw {
    #if !defined(ZAPP_WORKER_ENGINE_JSC)
    bool jsc_worker_create(const char* a, const char* b, const char* c) {
        (void)a; (void)b; (void)c; return false;
    }
    void jsc_worker_post_message(const char* a, const char* b) { (void)a; (void)b; }
    void jsc_worker_terminate(const char* a) { (void)a; }
    void jsc_worker_terminate_owner(const char* a) { (void)a; }
    #endif

    #if !defined(ZAPP_WORKER_ENGINE_TXIKI)
    bool txiki_worker_create(const char* a, const char* b, const char* c) {
        (void)a; (void)b; (void)c; return false;
    }
    void txiki_worker_post_message(const char* a, const char* b) { (void)a; (void)b; }
    void txiki_worker_terminate(const char* a) { (void)a; }
    void txiki_worker_terminate_owner(const char* a) { (void)a; }
    #endif

    #if !ZAPP_HAS_BARE
    bool bare_worker_create(const char* a, const char* b, const char* c) {
        (void)a; (void)b; (void)c; return false;
    }
    void bare_worker_post_message(const char* a, const char* b) { (void)a; (void)b; }
    void bare_worker_terminate(const char* a) { (void)a; }
    void bare_worker_terminate_owner(const char* a) { (void)a; }
    #endif
}

// --- Unified dispatchers ---
//
// `engine` matches `ZAPP_ENGINE_*` constants from registry.zc:
//   0 = JSC, 1 = txiki, 2 = bare-jsc, 3 = bare-v8,
//   4 = bare-quickjs, 5 = bare-mqjs.
//
// Dispatch is a runtime switch — engines that aren't compiled in are
// stubbed (see the raw block above) so calls go to no-ops rather than
// link errors. When the requested engine isn't compiled in we log a
// downgrade and fall back to whichever IS available, in priority
// order: bare-jsc > bare-v8 > bare-quickjs > bare-mqjs > txiki > jsc.

raw {
    // Helper: which engine should we actually run on? Returns the
    // requested engine if compiled in, otherwise the first available
    // fallback. Logs the downgrade once per worker create.
    static int zapp_resolve_engine(int requested, const char* worker_id) {
        int present[8] = {0};  // index = ZAPP_ENGINE_*
        #ifdef ZAPP_WORKER_ENGINE_JSC
        present[0] = 1;
        #endif
        #ifdef ZAPP_WORKER_ENGINE_TXIKI
        present[1] = 1;
        #endif
        #ifdef ZAPP_WORKER_ENGINE_BARE_JSC
        present[2] = 1;
        #endif
        #ifdef ZAPP_WORKER_ENGINE_BARE_V8
        present[3] = 1;
        #endif
        #ifdef ZAPP_WORKER_ENGINE_BARE_QUICKJS
        present[4] = 1;
        #endif
        #ifdef ZAPP_WORKER_ENGINE_BARE_MQJS
        present[5] = 1;
        #endif
        if (requested >= 0 && requested < 8 && present[requested]) return requested;
        // Fallback order: prefer richer/newer.
        int order[6] = {2, 3, 4, 5, 1, 0};
        const char* names[8] = {"jsc","txiki","bare-jsc","bare-v8","bare-quickjs","bare-mqjs","",""};
        for (int i = 0; i < 6; i++) {
            if (present[order[i]]) {
                if (requested != order[i]) {
                    fprintf(stderr,
                        "[zapp] worker '%s' requested %s but it's not compiled in — using %s.\n",
                        worker_id ? worker_id : "?",
                        (requested >= 0 && requested < 8) ? names[requested] : "?",
                        names[order[i]]);
                }
                return order[i];
            }
        }
        return -1;
    }

    static bool zapp_dispatch_worker_create(int eng, const char* script_url, const char* owner_id, const char* worker_id) {
        switch (eng) {
            case 0: return jsc_worker_create(script_url, owner_id, worker_id);
            case 1: return txiki_worker_create(script_url, owner_id, worker_id);
            case 2: case 3: case 4: case 5:
                return bare_worker_create(script_url, owner_id, worker_id);
        }
        return false;
    }

    static void zapp_dispatch_worker_post(int eng, const char* worker_id, const char* data) {
        switch (eng) {
            case 0: jsc_worker_post_message(worker_id, data); break;
            case 1: txiki_worker_post_message(worker_id, data); break;
            case 2: case 3: case 4: case 5:
                bare_worker_post_message(worker_id, data); break;
        }
    }

    static void zapp_dispatch_worker_terminate(int eng, const char* worker_id) {
        switch (eng) {
            case 0: jsc_worker_terminate(worker_id); break;
            case 1: txiki_worker_terminate(worker_id); break;
            case 2: case 3: case 4: case 5:
                bare_worker_terminate(worker_id); break;
        }
    }
}

fn worker_create(app: App*, script_url: string, owner_id: string,
                 worker_id: string, engine: int) -> bool {
    let _app = app;
    let result: bool = false;
    raw {
        int eng = zapp_resolve_engine((int)engine, (const char*)worker_id);
        if (eng < 0) {
            result = false;
        } else {
            result = zapp_dispatch_worker_create(eng,
                (const char*)script_url, (const char*)owner_id, (const char*)worker_id);
        }
    }
    return result;
}

fn worker_post_message(worker_id: string, data: string) -> void {
    raw {
        extern int zapp_worker_registry_get_engine(const char* worker_id);
        int eng = zapp_worker_registry_get_engine((const char*)worker_id);
        zapp_dispatch_worker_post(eng, (const char*)worker_id, (const char*)data);
    }
}

fn worker_terminate(worker_id: string) -> void {
    raw {
        extern int zapp_worker_registry_get_engine(const char* worker_id);
        int eng = zapp_worker_registry_get_engine((const char*)worker_id);
        zapp_dispatch_worker_terminate(eng, (const char*)worker_id);
    }
}

// terminate_owner doesn't take an engine — call every compiled-in
// engine's terminate_owner; each iterates its own slot table.
fn worker_terminate_owner(owner_id: string) -> void {
    raw {
        #ifdef ZAPP_WORKER_ENGINE_JSC
        jsc_worker_terminate_owner((const char*)owner_id);
        #endif
        #ifdef ZAPP_WORKER_ENGINE_TXIKI
        txiki_worker_terminate_owner((const char*)owner_id);
        #endif
        #if ZAPP_HAS_BARE
        bare_worker_terminate_owner((const char*)owner_id);
        #endif
    }
}

// --- Workers namespace (Zen-C) ---
//
// Mirrors the runtime/worker.ts `Workers` namespace so Zen-C services
// and native code can manage workers by ID without raw blocks. Since
// Zen-C doesn't have a free-floating `module.fn` syntax, we use the
// established `struct Foo {} impl Foo { fn ... }` namespace pattern
// (also used by `Zapp` in app.zc).
//
// Usage:
//   Workers::terminate("h-sync");
//
// Recognised ID forms match the JS side: dedicated workers ("w-N"),
// headless workers ("h-<key>"), shared workers ("sw-N" — silently
// no-op since shared workers are refcount-based).
struct Workers {}

impl Workers {
    fn terminate(id: string) -> void {
        if id == "" { return; }
        // The native router already has all the policy (shared-vs-dedicated
        // refcount handling, registry cleanup) — the Zen-C wrapper just
        // forwards. Bypassing the router would duplicate that policy.
        raw {
            #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI) || ZAPP_HAS_BARE
            extern int zapp_worker_registry_is_shared(const char* worker_id);
            extern void zapp_worker_registry_remove(const char* worker_id);
            if (!zapp_worker_registry_is_shared((const char*)id)) {
                worker_terminate((char*)id);
                zapp_worker_registry_remove((const char*)id);
            }
            #endif
        }
    }
}
