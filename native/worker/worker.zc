// Worker engine abstraction — dispatches to JSC or txiki.js.
// Workers are opt-in. Without an engine defined, stubs do nothing.

import "./registry.zc";

// Engine imports — only the defined engine is active.
// Both files must exist (Zen-C resolves imports at parse time).
@cfg(ZAPP_WORKER_ENGINE_JSC)
import "./engines/jsc.zc";

@cfg(ZAPP_WORKER_ENGINE_TXIKI)
import "./engines/txiki.zc";

// When no engine is defined, the jsc.zc / txiki.zc files provide
// the worker_* functions. Without either define, we need stubs.
// The simplest approach: always include stubs, engines override via @cfg.
// But Zen-C doesn't allow duplicate function definitions.
//
// Solution: the router checks if workers are enabled before calling.
// The worker_* functions only exist when an engine is defined.
// The router gates on a build config flag.

fn workers_enabled() -> bool {
    raw {
        #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI)
        return true;
        #else
        return false;
        #endif
    }
    return false;
}

// Stub worker functions when no engine is defined.
// These are called by router_handle_worker but gated behind workers_enabled().
// The C compiler still needs to resolve the symbols.
raw {
    #if !defined(ZAPP_WORKER_ENGINE_JSC) && !defined(ZAPP_WORKER_ENGINE_TXIKI)
    bool worker_create(void* app, char* script_url, char* owner_id, char* worker_id) {
        (void)app; (void)script_url; (void)owner_id; (void)worker_id;
        return false;
    }
    void worker_post_message(char* worker_id, char* data) {
        (void)worker_id; (void)data;
    }
    void worker_terminate(char* worker_id) {
        (void)worker_id;
    }
    void worker_terminate_owner(char* owner_id) {
        (void)owner_id;
    }
    #endif
}

// --- Workers namespace (Zen-C) ---
//
// Mirrors the runtime/worker.ts `Workers` namespace so Zen-C services
// and native code can manage workers by ID without raw blocks. Since
// Zen-C doesn't have a free-floating `module.fn` syntax, we use the
// established `struct Foo {} impl Foo { fn ... }` namespace pattern
// (also used by `Zapp` in app.zc).
//
// Usage:
//   Workers::terminate("h-sync");
//
// Recognised ID forms match the JS side: dedicated workers ("w-N"),
// headless workers ("h-<key>"), shared workers ("sw-N" — silently
// no-op since shared workers are refcount-based).
struct Workers {}

impl Workers {
    fn terminate(id: string) -> void {
        if id == "" { return; }
        // The native router already has all the policy (shared-vs-dedicated
        // refcount handling, registry cleanup) — the Zen-C wrapper just
        // forwards. Bypassing the router would duplicate that policy.
        raw {
            #if defined(ZAPP_WORKER_ENGINE_JSC) || defined(ZAPP_WORKER_ENGINE_TXIKI)
            extern int zapp_worker_registry_is_shared(const char* worker_id);
            extern void zapp_worker_registry_remove(const char* worker_id);
            if (!zapp_worker_registry_is_shared((const char*)id)) {
                worker_terminate((char*)id);
                zapp_worker_registry_remove((const char*)id);
            }
            #endif
        }
    }
}
