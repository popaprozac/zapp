// zjs worker engine — Zen-C trampolines.
//
// The unified `worker_create` / `worker_post_message` /
// `worker_terminate` dispatchers in `worker.zc` call the
// engine-prefixed C symbols (`zjs_worker_*`) directly. This file
// pulls the C header into scope so the dispatcher's raw blocks see
// the symbols.

@cfg(ZAPP_WORKER_ENGINE_ZJS)
import "./zjs.h" as zjs_engine;
