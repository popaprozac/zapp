// Worker registry — tracks which workers belong to which window.
// Supports both dedicated (single-owner) and shared (multi-owner, refcounted) workers.

import "string.h" as str;
import "stdlib.h";
import "stdio.h";
import "stdarg.h";

raw {
    #define ZAPP_MAX_WORKERS 64
    #define ZAPP_MAX_OWNERS_PER_WORKER 16

    // Engine selector — tracked per-worker so dispatchers can route
    // post / terminate / restart to the right engine without
    // re-passing the choice on every call.
    // Values 0 and 1 were jsc/txiki (removed). Keep numeric slots intact
    // so existing serialised IDs and the dispatch switch in worker.zc
    // don't need renumbering.
    #define ZAPP_ENGINE_BARE_JSC     2
    #define ZAPP_ENGINE_BARE_V8      3
    #define ZAPP_ENGINE_BARE_QUICKJS 4
    #define ZAPP_ENGINE_BARE_MQJS    5
    #define ZAPP_ENGINE_BARE_HERMES  6
    #define ZAPP_ENGINE_ZJS          7

    typedef struct {
        char worker_id[64];
        char name[64];    // display label from zapp.config.ts; empty string when unset
        char script_url[256];
        char owners[ZAPP_MAX_OWNERS_PER_WORKER][64];
        int owner_count;
        int shared;       // 0 = dedicated, 1 = shared
        int active;
        int engine;       // ZAPP_ENGINE_BARE_JSC | ZAPP_ENGINE_BARE_V8 | ... | ZAPP_ENGINE_ZJS

        // --- Supervisor / restart policy ---
        // Failures inside a sliding window of `restart_window_ms` are
        // counted; once `fail_count` reaches `restart_max` the worker
        // is marked `gave_up` and no further restarts are attempted.
        // restart_max == 0 means "no auto-restart" (default).
        int restart_max;
        int restart_window_ms;
        int fail_count;
        long long fail_window_start_ms;
        int gave_up;
    } ZappWorkerEntry;

    static ZappWorkerEntry zapp_worker_registry[ZAPP_MAX_WORKERS] = {{0}};

    // Add a dedicated worker (backward-compatible)
    static int zapp_worker_registry_add(const char* worker_id, const char* owner_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (!zapp_worker_registry[i].active) {
                strncpy(zapp_worker_registry[i].worker_id, worker_id, 63);
                zapp_worker_registry[i].name[0] = 0;
                strncpy(zapp_worker_registry[i].owners[0], owner_id, 63);
                zapp_worker_registry[i].owner_count = 1;
                zapp_worker_registry[i].shared = 0;
                zapp_worker_registry[i].script_url[0] = '\0';
                zapp_worker_registry[i].active = 1;
                return i;
            }
        }
        return -1;
    }

    // Add a worker with full options (shared flag + script URL +
    // engine). Non-static so app.zc can register headless workers
    // (they don't go through the router add path). Idempotent: a
    // duplicate id is refreshed in place rather than double-allocated.
    int zapp_worker_registry_add_full_with_engine(const char* worker_id, const char* owner_id,
                                                   int shared, const char* script_url, int engine) {
        // Update an existing entry if present.
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                zapp_worker_registry[i].shared = shared;
                zapp_worker_registry[i].engine = engine;
                if (script_url) {
                    strncpy(zapp_worker_registry[i].script_url, script_url, 255);
                    zapp_worker_registry[i].script_url[255] = '\0';
                }
                return i;
            }
        }
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (!zapp_worker_registry[i].active) {
                strncpy(zapp_worker_registry[i].worker_id, worker_id, 63);
                zapp_worker_registry[i].name[0] = 0;
                strncpy(zapp_worker_registry[i].owners[0], owner_id, 63);
                zapp_worker_registry[i].owner_count = 1;
                zapp_worker_registry[i].shared = shared;
                zapp_worker_registry[i].engine = engine;
                if (script_url)
                    strncpy(zapp_worker_registry[i].script_url, script_url, 255);
                else
                    zapp_worker_registry[i].script_url[0] = '\0';
                zapp_worker_registry[i].active = 1;
                return i;
            }
        }
        return -1;
    }

    // Backward-compat wrapper — defaults engine to -1 (resolver picks).
    // Existing callsites in router / app.zc keep working without a sweep.
    int zapp_worker_registry_add_full(const char* worker_id, const char* owner_id,
                                      int shared, const char* script_url) {
        return zapp_worker_registry_add_full_with_engine(worker_id, owner_id, shared, script_url, -1);
    }

    // As add_full_with_engine, but also records a display `name`. The name
    // is copied into the slot the underlying add resolved (new or refreshed),
    // so a non-empty name always wins over whatever was there before. An
    // empty/NULL name leaves the slot's existing name untouched.
    int zapp_worker_registry_add_full_with_engine_and_name(const char* worker_id, const char* owner_id,
                                                            int shared, const char* script_url,
                                                            int engine, const char* name) {
        int slot = zapp_worker_registry_add_full_with_engine(worker_id, owner_id, shared, script_url, engine);
        if (slot >= 0 && name && name[0]) {
            strncpy(zapp_worker_registry[slot].name, name, 63);
            zapp_worker_registry[slot].name[63] = 0;
        }
        return slot;
    }

    // Backward-compat wrapper — defaults engine to -1 (resolver picks),
    // matching zapp_worker_registry_add_full.
    int zapp_worker_registry_add_full_with_name(const char* worker_id, const char* owner_id,
                                                int shared, const char* script_url, const char* name) {
        return zapp_worker_registry_add_full_with_engine_and_name(
            worker_id, owner_id, shared, script_url, -1, name);
    }

    // Look up the engine for a worker. Returns -1 (resolver picks) if not found.
    int zapp_worker_registry_get_engine(const char* worker_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                return zapp_worker_registry[i].engine;
            }
        }
        return -1;
    }

    // Update the engine recorded for a worker. Called from worker_create
    // after `zapp_resolve_engine` picks the engine that actually ran (which
    // may differ from the one the user requested when fallback fires).
    // Without
    // this update the registry keeps the *requested* engine, and
    // post_message/terminate dispatch routes to the wrong engine's
    // (no-op stub) functions, silently dropping every message.
    void zapp_worker_registry_set_engine(const char* worker_id, int engine) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                zapp_worker_registry[i].engine = engine;
                return;
            }
        }
    }

    void zapp_worker_registry_remove(const char* worker_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                zapp_worker_registry[i].active = 0;
                break;
            }
        }
    }

    // Returns first owner_id for a worker, or NULL (dedicated workers have exactly one)
    static const char* zapp_worker_registry_owner(const char* worker_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                if (zapp_worker_registry[i].owner_count > 0)
                    return zapp_worker_registry[i].owners[0];
                return NULL;
            }
        }
        return NULL;
    }

    int zapp_worker_registry_is_shared(const char* worker_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                return zapp_worker_registry[i].shared;
            }
        }
        return 0;
    }

    // Find an existing shared worker by script URL. Returns worker_id or NULL.
    static const char* zapp_worker_registry_find_shared(const char* script_url) {
        if (!script_url) return NULL;
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active && zapp_worker_registry[i].shared &&
                strcmp(zapp_worker_registry[i].script_url, script_url) == 0) {
                return zapp_worker_registry[i].worker_id;
            }
        }
        return NULL;
    }

    // Add an owner to a shared worker. Returns 0 on success, -1 if not found or full.
    static int zapp_worker_registry_add_owner(const char* worker_id, const char* owner_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                int c = zapp_worker_registry[i].owner_count;
                // Check for duplicate
                for (int j = 0; j < c; j++) {
                    if (strcmp(zapp_worker_registry[i].owners[j], owner_id) == 0) return 0;
                }
                if (c >= ZAPP_MAX_OWNERS_PER_WORKER) return -1;
                strncpy(zapp_worker_registry[i].owners[c], owner_id, 63);
                zapp_worker_registry[i].owner_count++;
                return 0;
            }
        }
        return -1;
    }

    // Remove an owner from a shared worker. Returns remaining owner count, or -1 if not found.
    int zapp_worker_registry_remove_owner(const char* worker_id, const char* owner_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                for (int j = 0; j < zapp_worker_registry[i].owner_count; j++) {
                    if (strcmp(zapp_worker_registry[i].owners[j], owner_id) == 0) {
                        // Shift remaining owners down
                        for (int k = j; k < zapp_worker_registry[i].owner_count - 1; k++) {
                            strcpy(zapp_worker_registry[i].owners[k],
                                   zapp_worker_registry[i].owners[k + 1]);
                        }
                        zapp_worker_registry[i].owner_count--;
                        return zapp_worker_registry[i].owner_count;
                    }
                }
                return zapp_worker_registry[i].owner_count;
            }
        }
        return -1;
    }

    // Get the registry entry for a worker (for iteration). Returns pointer or NULL.
    static ZappWorkerEntry* zapp_worker_registry_get(const char* worker_id) {
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            if (zapp_worker_registry[i].active &&
                strcmp(zapp_worker_registry[i].worker_id, worker_id) == 0) {
                return &zapp_worker_registry[i];
            }
        }
        return NULL;
    }

    // Display label for a worker: the configured `name` if set, otherwise
    // the worker_id. Returns the literal "" for a NULL id, and falls back to
    // the passed-in worker_id when the worker isn't registered. Used by the
    // log-format revamp and any human-facing worker listing.
    const char* zapp_worker_registry_get_display_name(const char* worker_id) {
        if (!worker_id) return "";
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        if (!e) return worker_id;
        if (e->name[0]) return e->name;
        return e->worker_id;
    }

    // Compact a millisecond duration for logs: <1000ms -> "500ms"; >=1000ms -> "30s" or "1.5s".
    // Returns a static buffer (single-use per call site — consumed immediately by the log).
    const char* zapp_fmt_compact_ms(int ms) {
        static char buf[32];
        if (ms < 1000) {
            snprintf(buf, sizeof(buf), "%dms", ms);
        } else {
            int s = ms / 1000;
            int frac = (ms % 1000) / 100;
            if (frac == 0) snprintf(buf, sizeof(buf), "%ds", s);
            else snprintf(buf, sizeof(buf), "%d.%ds", s, frac);
        }
        return buf;
    }

    // Escape a string for a JSON double-quoted context. Escapes ", \, the
    // named control chars (\b \f \n \r \t) and any other char < 0x20 as
    // \u00xx. Returns a freshly malloc'd buffer the caller frees, or NULL on
    // OOM. NOTE: bridge/dispatch.zc's zapp_escape_dup is for JS single-quoted
    // strings and does NOT escape ", so it is wrong for JSON — hence this.
    static char* zapp_json_escape_dup(const char* s) {
        if (!s) s = "";
        size_t len = strlen(s);
        char* out = (char*)malloc(len * 6 + 1);   // worst case every char -> \u00xx
        if (!out) return NULL;
        size_t o = 0;
        for (size_t i = 0; i < len; i++) {
            unsigned char c = (unsigned char)s[i];
            switch (c) {
                case '"':  out[o++]='\\'; out[o++]='"';  break;
                case '\\': out[o++]='\\'; out[o++]='\\'; break;
                case '\b': out[o++]='\\'; out[o++]='b';  break;
                case '\f': out[o++]='\\'; out[o++]='f';  break;
                case '\n': out[o++]='\\'; out[o++]='n';  break;
                case '\r': out[o++]='\\'; out[o++]='r';  break;
                case '\t': out[o++]='\\'; out[o++]='t';  break;
                default:
                    if (c < 0x20) { o += (size_t)sprintf(out + o, "\\u%04x", c); }
                    else out[o++] = (char)c;
            }
        }
        out[o] = 0;
        return out;
    }

    // Append formatted text to *buf, growing the allocation as needed. The
    // grow-on-truncation loop reads vsnprintf's return value (the length it
    // WOULD have written) to decide whether the write fit; if not it doubles
    // capacity and retries. This is provably correct regardless of how large
    // an escaped entry serialises to — no fixed-headroom guessing, so the
    // offset can never be pushed past capacity (which previously underflowed
    // cap - off and produced an unbounded heap write). Returns 0 on success,
    // -1 on allocation failure.
    static int zapp_json_append(char** buf, size_t* cap, size_t* off, const char* fmt, ...) {
        while (1) {
            va_list ap;
            va_start(ap, fmt);
            int n = vsnprintf(*buf + *off, *cap - *off, fmt, ap);
            va_end(ap);
            if (n < 0) return -1;
            if ((size_t)n < *cap - *off) { *off += (size_t)n; return 0; }
            size_t need = *off + (size_t)n + 1;
            size_t newcap = *cap ? *cap : 256;
            while (newcap < need) newcap *= 2;
            char* nb = (char*)realloc(*buf, newcap);
            if (!nb) return -1;
            *buf = nb; *cap = newcap;
        }
    }

    // Heap-allocated JSON array of all ACTIVE workers. Caller frees with
    // free(). Single source of truth for Workers.list() — consumed by the
    // per-engine host objects (zjs.c / bare.c) and the webview IPC route.
    char* zapp_workers_registry_list_json() {
        size_t cap = 1024;
        size_t off = 0;
        char* buf = (char*)malloc(cap);
        if (!buf) return NULL;
        buf[0] = 0;
        if (zapp_json_append(&buf, &cap, &off, "[") < 0) { free(buf); return NULL; }
        int first = 1;
        for (int i = 0; i < ZAPP_MAX_WORKERS; i++) {
            ZappWorkerEntry* e = &zapp_worker_registry[i];
            if (!e->active) continue;

            // Unresolved/unknown engine (including the resolver-default -1)
            // is reported as "pending" rather than misleadingly coerced to
            // "zjs" in this debug dump.
            const char* engine_str = "pending";
            switch (e->engine) {
                case ZAPP_ENGINE_ZJS:           engine_str = "zjs"; break;
                case ZAPP_ENGINE_BARE_JSC:      engine_str = "bare-jsc"; break;
                case ZAPP_ENGINE_BARE_V8:       engine_str = "bare-v8"; break;
                case ZAPP_ENGINE_BARE_QUICKJS:  engine_str = "bare-quickjs"; break;
                case ZAPP_ENGINE_BARE_MQJS:     engine_str = "bare-mqjs"; break;
                case ZAPP_ENGINE_BARE_HERMES:   engine_str = "bare-hermes"; break;
            }

            // Escape every user-influenced string into a JSON-safe temp.
            // worker_id / script_url can carry quotes or backslashes; name is
            // author-supplied in zapp.config.ts. Each temp is freed the moment
            // it has been appended (or on the error path below).
            char* eid = zapp_json_escape_dup(e->worker_id);
            if (!eid) { free(buf); return NULL; }
            if (zapp_json_append(&buf, &cap, &off, "%s{\"id\":\"%s\"", first ? "" : ",", eid) < 0) {
                free(eid); free(buf); return NULL;
            }
            free(eid);

            if (e->name[0]) {
                char* ename = zapp_json_escape_dup(e->name);
                if (!ename) { free(buf); return NULL; }
                if (zapp_json_append(&buf, &cap, &off, ",\"name\":\"%s\"", ename) < 0) {
                    free(ename); free(buf); return NULL;
                }
                free(ename);
            }

            char* eurl = zapp_json_escape_dup(e->script_url);
            if (!eurl) { free(buf); return NULL; }
            if (zapp_json_append(&buf, &cap, &off,
                    ",\"scriptUrl\":\"%s\",\"engine\":\"%s\",\"shared\":%s,\"owners\":[",
                    eurl, engine_str, e->shared ? "true" : "false") < 0) {
                free(eurl); free(buf); return NULL;
            }
            free(eurl);

            for (int o = 0; o < e->owner_count; o++) {
                char* eowner = zapp_json_escape_dup(e->owners[o]);
                if (!eowner) { free(buf); return NULL; }
                if (zapp_json_append(&buf, &cap, &off, "%s\"%s\"", o == 0 ? "" : ",", eowner) < 0) {
                    free(eowner); free(buf); return NULL;
                }
                free(eowner);
            }
            if (zapp_json_append(&buf, &cap, &off, "]") < 0) { free(buf); return NULL; }

            if (e->restart_max > 0) {
                if (zapp_json_append(&buf, &cap, &off,
                        ",\"supervisor\":{\"maxRetries\":%d,\"withinMs\":%d,\"failCount\":%d,\"gaveUp\":%s}",
                        e->restart_max, e->restart_window_ms, e->fail_count,
                        e->gave_up ? "true" : "false") < 0) {
                    free(buf); return NULL;
                }
            }
            if (zapp_json_append(&buf, &cap, &off, "}") < 0) { free(buf); return NULL; }
            first = 0;
        }
        if (zapp_json_append(&buf, &cap, &off, "]") < 0) { free(buf); return NULL; }
        return buf;
    }

    // --- Supervisor public API ---
    //
    // Engines call these on uncaught worker errors. The split is deliberate:
    // the engine knows when a fault has fired, the supervisor knows whether
    // to retry. Engine-agnostic policy lives here so adding a new engine
    // doesn't duplicate it.

    #include <sys/time.h>

    static long long zapp_supervisor_now_ms(void) {
        struct timeval tv;
        gettimeofday(&tv, NULL);
        return (long long)tv.tv_sec * 1000LL + (long long)tv.tv_usec / 1000LL;
    }

    // Configure the restart policy for a worker. max == 0 disables
    // auto-restart (default). Setting after the worker is created is
    // fine — failures before policy was set won't have been counted.
    void zapp_worker_supervisor_set_policy(const char* worker_id, int max, int window_ms) {
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        if (!e) return;
        e->restart_max = max;
        e->restart_window_ms = window_ms > 0 ? window_ms : 60000;
        e->fail_count = 0;
        e->fail_window_start_ms = 0;
        e->gave_up = 0;
    }

    // Record a worker failure. Returns:
    //   0  — ignore (no policy configured; engine should NOT restart)
    //   1  — restart approved (engine should tear down + rerun script)
    //   2  — gave up (this and all future calls return 2 until policy reset)
    //
    // Sliding-window logic: failures within `restart_window_ms` of the
    // first failure in the current window count toward `restart_max`.
    // Once max is reached, gave_up flips to 1 permanently. If a failure
    // arrives after the window expires, the window resets and the
    // counter starts at 1.
    int zapp_worker_supervisor_record_failure(const char* worker_id) {
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        if (!e) return 0;
        if (e->restart_max <= 0) return 0;
        if (e->gave_up) return 2;

        long long now = zapp_supervisor_now_ms();
        if (e->fail_count == 0 ||
            (now - e->fail_window_start_ms) > (long long)e->restart_window_ms) {
            e->fail_count = 1;
            e->fail_window_start_ms = now;
            return 1;
        }
        e->fail_count++;
        if (e->fail_count > e->restart_max) {
            e->gave_up = 1;
            return 2;
        }
        return 1;
    }

    // Helpers the engine needs to recreate a worker on restart.
    const char* zapp_worker_supervisor_get_script_url(const char* worker_id) {
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        return e ? e->script_url : NULL;
    }
    const char* zapp_worker_supervisor_get_owner(const char* worker_id) {
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        if (!e || e->owner_count == 0) return "";
        return e->owners[0];
    }

    // Read-only window-state inspection. Used by engine dev logs on
    // restart ("incarnation N, fail_count X/cap in Yms window"). Returns
    // 0 on success, -1 if the worker isn't registered.
    int zapp_worker_supervisor_get_window_state(
        const char* worker_id,
        int* out_count,
        int* out_cap,
        int* out_window_ms
    ) {
        ZappWorkerEntry* e = zapp_worker_registry_get(worker_id);
        if (!e) return -1;
        if (out_count)     *out_count     = e->fail_count;
        if (out_cap)       *out_cap       = e->restart_max;
        if (out_window_ms) *out_window_ms = e->restart_window_ms;
        return 0;
    }
}
