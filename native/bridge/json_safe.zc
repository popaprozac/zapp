// Heap-allocating JSON parser — drop-in replacement for JsonValue::parse.
//
// Background: zc's std/json.zc _json_parse_string uses a `char buf[4096]`
// stack buffer with no bounds check. Any JSON string token longer than
// 4096 chars overruns the stack guard, triggering __stack_chk_fail →
// SIGABRT. The webview→native leg hits this on realistic payloads
// (data URLs, large text fields, file contents).
//
// This file re-implements the parser with a heap-allocated dynamic
// buffer so string tokens of any length work. The resulting tree uses
// the same stdlib JsonValue struct, so downstream code (get_string,
// get_object, Drop_glue, etc.) is unchanged.
//
// Upstream: the right fix is in zc itself — patch std/json.zc to heap-
// allocate or enforce a clean error. Until that lands, we keep our
// own parser and prefer it at every framework parse site.

import "std/json.zc";
import "string.h" as str;
import "stdlib.h";

raw {
    // Vec/Map constructors — exported from stdlib, available for us to
    // populate the same tree shape the stdlib parser does.
    Vec__JsonValuePtr Vec__JsonValuePtr__new();
    void Vec__JsonValuePtr__push(Vec__JsonValuePtr* self, JsonValue* item);
    Map__JsonValuePtr Map__JsonValuePtr__new();
    void Map__JsonValuePtr__put(Map__JsonValuePtr* self, char* key, JsonValue* val);

    static void _zapp_json_skip_ws(const char** p) {
        while (**p == ' ' || **p == '\t' || **p == '\n' || **p == '\r') (*p)++;
    }

    // Heap-allocated string token parse. Starts with a 128-byte buffer
    // that doubles on overflow; no hard cap beyond available memory.
    // Returned pointer is heap — caller (or the containing JsonValue)
    // owns it.
    static char* _zapp_json_parse_string(const char** p) {
        if (**p != '"') return NULL;
        (*p)++;
        size_t cap = 128;
        char* buf = (char*)malloc(cap);
        if (!buf) return NULL;
        size_t len = 0;
        while (**p && **p != '"') {
            if (len + 2 >= cap) {
                size_t ncap = cap * 2;
                char* nb = (char*)realloc(buf, ncap);
                if (!nb) { free(buf); return NULL; }
                buf = nb;
                cap = ncap;
            }
            if (**p == '\\' && (*p)[1]) {
                (*p)++;
                char c = **p;
                if (c == 'n') buf[len++] = '\n';
                else if (c == 't') buf[len++] = '\t';
                else if (c == 'r') buf[len++] = '\r';
                else if (c == '"') buf[len++] = '"';
                else if (c == '\\') buf[len++] = '\\';
                else if (c == '/') buf[len++] = '/';
                else if (c == 'b') buf[len++] = '\b';
                else if (c == 'f') buf[len++] = '\f';
                else buf[len++] = c;
            } else {
                buf[len++] = **p;
            }
            (*p)++;
        }
        if (**p == '"') (*p)++;
        buf[len] = '\0';
        return buf;
    }

    static struct JsonValue* _zapp_json_parse_value(const char** p);

    static struct JsonValue* _zapp_json_parse_array(const char** p) {
        if (**p != '[') return NULL;
        (*p)++;
        struct JsonValue* arr = (struct JsonValue*)malloc(sizeof(struct JsonValue));
        if (!arr) return NULL;
        arr->kind = JsonType__JSON_ARRAY();
        arr->string_val = 0; arr->number_val = 0; arr->bool_val = 0; arr->object_val = 0;
        arr->array_val = (Vec__JsonValuePtr*)malloc(sizeof(Vec__JsonValuePtr));
        if (!arr->array_val) { free(arr); return NULL; }
        *(arr->array_val) = Vec__JsonValuePtr__new();

        _zapp_json_skip_ws(p);
        if (**p == ']') { (*p)++; return arr; }

        while (1) {
            _zapp_json_skip_ws(p);
            struct JsonValue* val = _zapp_json_parse_value(p);
            if (!val) return NULL;
            Vec__JsonValuePtr__push(arr->array_val, val);
            _zapp_json_skip_ws(p);
            if (**p == ']') { (*p)++; return arr; }
            if (**p != ',') return NULL;
            (*p)++;
        }
    }

    static struct JsonValue* _zapp_json_parse_object(const char** p) {
        if (**p != '{') return NULL;
        (*p)++;
        struct JsonValue* obj = (struct JsonValue*)malloc(sizeof(struct JsonValue));
        if (!obj) return NULL;
        obj->kind = JsonType__JSON_OBJECT();
        obj->string_val = 0; obj->number_val = 0; obj->bool_val = 0; obj->array_val = 0;
        obj->object_val = (Map__JsonValuePtr*)malloc(sizeof(Map__JsonValuePtr));
        if (!obj->object_val) { free(obj); return NULL; }
        *(obj->object_val) = Map__JsonValuePtr__new();

        _zapp_json_skip_ws(p);
        if (**p == '}') { (*p)++; return obj; }

        while (1) {
            _zapp_json_skip_ws(p);
            char* key = _zapp_json_parse_string(p);
            if (!key) return NULL;
            _zapp_json_skip_ws(p);
            if (**p != ':') { free(key); return NULL; }
            (*p)++;
            _zapp_json_skip_ws(p);
            struct JsonValue* val = _zapp_json_parse_value(p);
            if (!val) { free(key); return NULL; }
            Map__JsonValuePtr__put(obj->object_val, key, val);
            free(key);
            _zapp_json_skip_ws(p);
            if (**p == '}') { (*p)++; return obj; }
            if (**p != ',') return NULL;
            (*p)++;
        }
    }

    static struct JsonValue* _zapp_json_parse_value(const char** p) {
        _zapp_json_skip_ws(p);
        if (**p == '\0') return NULL;

        if (strncmp(*p, "null", 4) == 0) {
            *p += 4;
            struct JsonValue* v = (struct JsonValue*)malloc(sizeof(struct JsonValue));
            if (!v) return NULL;
            v->kind = JsonType__JSON_NULL();
            v->string_val = 0; v->number_val = 0; v->bool_val = 0; v->array_val = 0; v->object_val = 0;
            return v;
        }
        if (strncmp(*p, "true", 4) == 0) {
            *p += 4;
            struct JsonValue* v = (struct JsonValue*)malloc(sizeof(struct JsonValue));
            if (!v) return NULL;
            v->kind = JsonType__JSON_BOOL();
            v->string_val = 0; v->number_val = 0; v->bool_val = 1; v->array_val = 0; v->object_val = 0;
            return v;
        }
        if (strncmp(*p, "false", 5) == 0) {
            *p += 5;
            struct JsonValue* v = (struct JsonValue*)malloc(sizeof(struct JsonValue));
            if (!v) return NULL;
            v->kind = JsonType__JSON_BOOL();
            v->string_val = 0; v->number_val = 0; v->bool_val = 0; v->array_val = 0; v->object_val = 0;
            return v;
        }
        if (**p == '"') {
            char* s = _zapp_json_parse_string(p);
            if (!s) return NULL;
            struct JsonValue* v = (struct JsonValue*)malloc(sizeof(struct JsonValue));
            if (!v) { free(s); return NULL; }
            v->kind = JsonType__JSON_STRING();
            v->string_val = s; v->number_val = 0; v->bool_val = 0; v->array_val = 0; v->object_val = 0;
            return v;
        }
        if (**p == '-' || (**p >= '0' && **p <= '9')) {
            char* end;
            double num = strtod(*p, &end);
            if (end == *p) return NULL;
            *p = end;
            struct JsonValue* v = (struct JsonValue*)malloc(sizeof(struct JsonValue));
            if (!v) return NULL;
            v->kind = JsonType__JSON_NUMBER();
            v->string_val = 0; v->number_val = num; v->bool_val = 0; v->array_val = 0; v->object_val = 0;
            return v;
        }
        if (**p == '[') return _zapp_json_parse_array(p);
        if (**p == '{') return _zapp_json_parse_object(p);
        return NULL;
    }

    // Public entry. Returns NULL on any parse failure (unterminated
    // string, malformed object/array, OOM, empty input). Caller assumes
    // ownership of the returned tree and must Drop+free it.
    static struct JsonValue* _zapp_json_parse_root(const char* input) {
        if (!input) return NULL;
        const char* p = input;
        _zapp_json_skip_ws(&p);
        if (*p == '\0') return NULL;
        return _zapp_json_parse_value(&p);
    }
}

// Drop-in replacement for `JsonValue::parse`. Same Result<JsonValue*>
// shape so callers just swap the function name. NULL-vs-pointer checks
// for JsonValue* must live in a raw block — JsonValue derives Eq, so
// `ptr == NULL` in Zen-C context generates a struct-equality call.
fn zapp_json_parse(input: string) -> Result<JsonValue*> {
    let ptr: JsonValue* = NULL;
    let parsed_ok: bool = false;
    raw {
        ptr = _zapp_json_parse_root((const char*)input);
        parsed_ok = (ptr != NULL);
    }
    if !parsed_ok {
        return Result<JsonValue*>::Err("json parse failed");
    }
    return Result<JsonValue*>::Ok(ptr);
}
