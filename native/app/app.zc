// Application lifecycle and configuration — pure Zen-C.

import "../window/window.zc";
import "../window/callbacks.zc";
import "../service/service.zc";
import "../dialog/dialog.zc";
import "../notification/notification.zc";
import "../platform/platform.zc";
import "../sync/sync.zc";
import "../menu/menu.zc";
import "../dock/dock.zc";
import "../tray/tray.zc";
