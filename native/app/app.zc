// Application lifecycle and configuration — pure Zen-C.

import "../window/window.zc";
import "../window/callbacks.zc";
import "../service/service.zc";
import "../dialog/dialog.zc";
import "../notification/notification.zc";
import "../platform/platform.zc";
import "../sync/sync.zc";
import "../menu/menu.zc";
import "../dock/dock.zc";
import "./app_events.zc";

import "string.h" as str;

// --- Global app state (accessed by .m files via extern) ---

raw {
    static void* zapp_active_app = NULL;
    static char zapp_security_nav_json[4096] = "";
}

fn app_set_active(app: App*) -> void {
    raw { zapp_active_app = (void*)app; }
}

fn app_get_active() -> void* {
    let result: void* = NULL;
    raw { result = zapp_active_app; }
    return result;
}

// Bootstrap config accessors (called by webview.m)
fn app_get_bootstrap_name() -> string {
    let app = (App*)app_get_active();
    if app != NULL { return app.config.name; }
    return "Zapp";
}

fn app_get_bootstrap_web_content_inspectable() -> bool {
    let app = (App*)app_get_active();
    if app == NULL { return false; }
    match app.config.webContentInspectable {
        ZappInspectable::On => { return true; },
        ZappInspectable::Off => { return false; },
        ZappInspectable::Auto => { return zapp_build_dev_tools_default() > 0; },
    }
    return false;
}

fn app_get_bootstrap_application_should_terminate_after_last_window_closed() -> bool {
    let app = (App*)app_get_active();
    if app != NULL { return app.config.applicationShouldTerminateAfterLastWindowClosed; }
    return true;
}

fn app_get_bootstrap_max_workers() -> int {
    let app = (App*)app_get_active();
    if app != NULL { return app.config.maxWorkers; }
    return 0;
}

// Navigation allowlist. Returns a JSON array of glob patterns, or "" when
// unset. Called by the webview's navigation delegate before every top-level
// load. Built by SecurityManager::allow_navigation at startup.
fn app_get_allowed_navigation_json() -> string {
    let result: string = "";
    raw { result = zapp_security_nav_json; }
    return result;
}

import "./router.zc";
import "../worker/worker.zc";
@cfg(ZAPP_WORKER_ENGINE_JSC)
import "../worker/engines/jsc.h" as jsc_engine;
@cfg(ZAPP_WORKER_ENGINE_TXIKI)
import "../worker/engines/txiki.h" as txiki_engine;

// zapp_start_headless_workers is provided by .zapp/zapp_headless_workers.zc,
// generated by the CLI from zappConfig.headless. When no headless workers are
// configured the generated function is an empty body.
extern fn zapp_start_headless_workers() -> void;

// Helper the generated headless startup file calls for each configured worker.
// Owner ID is empty — headless workers have no parent window.
fn zapp_start_headless_worker(id: string, script_url: string) -> void {
    let app = (App*)app_get_active();
    if app == NULL { return; }
    worker_create(app, script_url, "", id);
}

// Called from workers via the createWindow host object. Always runs on the
// main queue (the ObjC-side dispatch_sync handles that). Builds a
// WindowOptions and creates the window using the normal WindowManager path.
fn zapp_worker_create_window(title: string, url: string, width: int, height: int) -> int {
    let app = (App*)app_get_active();
    if app == NULL { return -1; }
    let opts = WindowOptions::create(title);
    raw {
        if (url && url[0] != '\0') opts.url = url;
    }
    if width > 0 { opts.width = width; }
    if height > 0 { opts.height = height; }
    opts.visible = true;
    let win = app.window.create(&opts);
    return win.id;
}

// Dispatch worker message to a single window by owner_id
fn worker_dispatch_to_window(worker_id: string, data_json: string, owner_id: string) -> void {
    let window_id: int = -1;
    raw {
        #ifdef __APPLE__
        extern const char* darwin_window_id_string(int32_t numeric_id);
        #define zapp_window_id_string_fn darwin_window_id_string
        #else
        extern const char* windows_window_id_string(int32_t numeric_id);
        #define zapp_window_id_string_fn windows_window_id_string
        #endif
        for (int i = 0; i < 64; i++) {
            const char* wid = zapp_window_id_string_fn(i);
            if (wid && strcmp(wid, (const char*)owner_id) == 0) {
                window_id = i;
                break;
            }
        }
        #undef zapp_window_id_string_fn
    }
    if window_id < 0 { return; }

    raw {
        // Thread-local: multiple worker threads may call this concurrently.
        // darwin_window_eval_js now copies the buffer before queueing.
        static _Thread_local char wk_buf[4096];
        extern int zapp_escape_into(char* dst, int dst_size, const char* src);
        char escaped_wid[128];
        char escaped_data[3072];
        zapp_escape_into(escaped_wid, sizeof(escaped_wid), (const char*)worker_id);
        zapp_escape_into(escaped_data, sizeof(escaped_data), (const char*)data_json);

        snprintf(wk_buf, sizeof(wk_buf),
            "(function(){var b=globalThis[Symbol.for('zapp.bridge')];"
            "if(b&&typeof b._onWorkerMessage==='function'){"
            "b._onWorkerMessage('%s','%s');}})();",
            escaped_wid, escaped_data);

        #ifdef __APPLE__
        extern void darwin_window_eval_js(int32_t window_id, const char* js);
        darwin_window_eval_js(window_id, wk_buf);
        #else
        extern void windows_window_eval_js(int32_t window_id, const char* js);
        windows_window_eval_js(window_id, wk_buf);
        #endif
    }
}

// Worker → WebView dispatch (called by jsc.m host object postToWebview)
// For shared workers, broadcasts to all connected windows.
fn worker_dispatch_to_webview(worker_id: string, data_json: string) -> void {
    // Check if shared — broadcast to all owners
    let is_shared: bool = false;
    raw {
        is_shared = zapp_worker_registry_is_shared((const char*)worker_id) != 0;
    }

    if is_shared {
        // Broadcast to all owners
        raw {
            ZappWorkerEntry* entry = zapp_worker_registry_get((const char*)worker_id);
            if (entry) {
                for (int i = 0; i < entry->owner_count; i++) {
                    worker_dispatch_to_window(worker_id, data_json, (char*)entry->owners[i]);
                }
            }
        }
        return;
    }

    // Dedicated worker — single owner
    let owner_id: string = "";
    raw {
        const char* oid = zapp_worker_registry_owner((const char*)worker_id);
        if (oid) owner_id = (char*)oid;
    }
    if owner_id == "" { return; }
    worker_dispatch_to_window(worker_id, data_json, owner_id);
}

// Message handler with window ID (called by webview.m — knows which WebView sent it)
fn zapp_handle_message_from_window(app_ptr: void*, msg: string, window_id: int) -> void {
    let app = (App*)app_ptr;
    if app == NULL { return; }
    router_handle_message(app, msg, window_id);
}

// Build config functions — provided by CLI-generated .zapp/zapp_build_config.zc
// If compiling standalone (without CLI), define these in your build.zc.

// Bootstrap script — generated from bootstrap/webview.ts by bootstrap/codegen.ts.
// The function zapp_webview_bootstrap_script() is provided by .zapp/zapp_bootstrap.zc.

// Service bindings — provided by service/service.zc (imported via router.zc)

// Whether the webview inspector (devtools) is available.
//   Auto — inherit from build mode (dev → on, prod → off)
//   On   — always available (useful for debugging)
//   Off  — never available (hardened production)
enum ZappInspectable {
    Auto,
    On,
    Off,
}

struct AppConfig {
    name: string;
    applicationShouldTerminateAfterLastWindowClosed: bool;
    webContentInspectable: ZappInspectable;
    maxWorkers: int;
    qjsStackSize: int;
}

// ---------------------------------------------------------------------------
// Zapp namespace — convenience accessors for framework enums and values.
//
// Usage:
//   webContentInspectable: Zapp::inspectable_auto(),
//   webContentInspectable: Zapp::inspectable_on(),
//   webContentInspectable: Zapp::inspectable_off(),
//
// These return the proper enum type so you get match exhaustiveness and
// type checking. The enum constructors also work directly if you prefer:
//   webContentInspectable: ZappInspectable::Auto(),
//
// As Zapp adds more framework-level options (log levels, security modes,
// etc.), new accessors will appear here under the same Zapp:: namespace.
// ---------------------------------------------------------------------------
struct Zapp {}
impl Zapp {
    fn inspectable_auto() -> ZappInspectable { return ZappInspectable::Auto(); }
    fn inspectable_on() -> ZappInspectable { return ZappInspectable::On(); }
    fn inspectable_off() -> ZappInspectable { return ZappInspectable::Off(); }
}

// Runtime security policy — navigation allowlist, future CSP, etc.
// Lives on App so webview delegates can read through `app_get_active()`.
struct SecurityManager {}

impl SecurityManager {
    fn new() -> Self { return SecurityManager{}; }

    // Declare the set of URL patterns the webview is allowed to navigate to
    // for top-level loads. Patterns are globs ("https://api.example.com/*").
    // Built-in schemes (zapp, about, blob) and localhost in dev mode are
    // always allowed. Call before app.run().
    fn allow_navigation(self, patterns: string*, count: int) -> void {
        raw {
            char* out = zapp_security_nav_json;
            size_t cap = sizeof(zapp_security_nav_json);
            size_t used = 0;
            if (cap > 0) out[used++] = '[';
            for (int i = 0; i < count && used + 2 < cap; i++) {
                if (i > 0) { out[used++] = ','; }
                out[used++] = '"';
                const char* p = ((const char**)patterns)[i];
                while (p && *p && used + 2 < cap) {
                    if (*p == '"' || *p == '\\') out[used++] = '\\';
                    out[used++] = *p++;
                }
                if (used + 1 < cap) out[used++] = '"';
            }
            if (used + 1 < cap) out[used++] = ']';
            if (used < cap) out[used] = '\0';
        }
    }
}

struct App {
    config: AppConfig;
    window: WindowManager;
    service: ServiceManager;
    menu: MenuManager;
    dialog: DialogManager;
    notification: NotificationManager;
    sync: SyncManager;
    dock: DockManager;
    security: SecurityManager;
}

impl App {
    fn new(config: AppConfig) -> App {
        let wm = WindowManager::new();
        match config.webContentInspectable {
            ZappInspectable::On => { wm.webContentInspectable = true; },
            ZappInspectable::Off => { wm.webContentInspectable = false; },
            ZappInspectable::Auto => {
                wm.webContentInspectable = zapp_build_dev_tools_default() > 0;
            },
        }

        platform_init(config.name);

        return App{
            config: config,
            window: wm,
            service: ServiceManager::new(),
            menu: MenuManager::new(),
            dialog: DialogManager::new(),
            notification: NotificationManager::new(),
            sync: SyncManager::new(),
            dock: DockManager::new(),
            security: SecurityManager::new(),
        };
    }

    fn run(self) -> int {
        self.window.app = (App*)self;
        app_set_active((App*)self);

        // Run service startup (in registration order, before windows)
        service_run_startup_all();

        // Start configured headless workers. Generated function — empty body
        // when zappConfig.headless is empty or omitted.
        zapp_start_headless_workers();

        return platform_run(self.config.applicationShouldTerminateAfterLastWindowClosed);
    }

    fn on(self, event_id: int, cb: fn*(int, string) -> void) -> void {
        raw {
            zapp_app_on(event_id, (void (*)(int, const char*))cb);
        }
    }

    fn open_external(self, url: string) -> void {
        raw {
            #ifdef __APPLE__
            extern void darwin_open_external(const char* url);
            darwin_open_external((const char*)url);
            #else
            extern void windows_open_external(const char* url);
            windows_open_external((const char*)url);
            #endif
        }
    }
}
