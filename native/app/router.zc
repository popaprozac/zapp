// Message routing — parses bridge messages and dispatches to handlers.

import "std/json.zc";
import "string.h" as str;
import "../bridge/protocol.zc";
import "../bridge/dispatch.zc";
import "../bridge/json_builder.zc";
import "../service/service.zc";
import "../window/events.zc";
import "../fs/fs.zc";
import "../permissions/permissions.zc";
// darwin_win imported via dispatch.zc → darwin/window.h
@cfg(apple)
import "../platform/darwin/dialog.h" as darwin_dialog;
@cfg(windows)
import "../platform/windows/dialog.h" as win_dialog;

// Map a t:1 invoke method to a permission id ("" = ungated: __app:,
// __zapp:, __protocol:respond, user services). Spec catalog:
// docs/superpowers/specs/2026-06-09-permissions-system-design.md
fn permission_id_for_invoke(method: string) -> string {
    if str::strncmp(method, "__clipboard:", 12) == 0 {
        // read* / has → :read; write* / clear → :write
        let rest: string = "";
        raw { rest = (char*)((const char*)method + 12); }
        if str::strncmp(rest, "read", 4) == 0 { return "clipboard:read"; }
        if str::strncmp(rest, "has", 3) == 0 { return "clipboard:read"; }
        return "clipboard:write";
    }
    if str::strncmp(method, "__dialog:", 9) == 0 { return "dialog"; }
    if str::strncmp(method, "__notif:", 8) == 0 { return "notifications"; }
    if str::strncmp(method, "__shortcuts:", 12) == 0 { return "shortcuts"; }
    if str::strncmp(method, "__screen:", 9) == 0 { return "screen"; }
    if method == "__window:create" { return "window:create"; }
    return "";
}

// Map a t:4 fire-and-forget action to a permission id ("" = ungated:
// window ops on existing windows, app lifecycle, plumbing).
fn permission_id_for_action(action: string) -> string {
    if str::strncmp(action, "tray:", 5) == 0 { return "tray"; }
    if str::strncmp(action, "dock:", 5) == 0 { return "dock"; }
    // sidebar:* = window ops on an existing window — ungated by design (docs/security.md).
    if action == "panelCreate" || action == "panelSetBounds" || action == "panelLoadUrl" ||
       action == "panelExecJs" || action == "panelPostMessage" || action == "panelShow" ||
       action == "panelHide" || action == "panelReload" || action == "panelBack" ||
       action == "panelForward" || action == "panelDestroy" { return "embed"; }
    if action == "setMenu" { return "menu"; }
    if action == "showContextMenu" { return "menu"; }
    if action == "openExternal" { return "shell:open"; }
    if action == "openPath" { return "shell:open"; }
    if action == "showItemInFolder" { return "shell:reveal"; }
    if action == "trashItem" { return "shell:trash"; }
    return "";
}

fn router_handle_message(app: App*, msg: string, window_id: int) -> void {
    let parsed = bridge_parse(msg);
    if !parsed.valid { return; }

    if parsed.msg_type == MsgType.INVOKE {
        // Permission gate (t:1). Maps the invoke method to a catalog id;
        // ungated methods ("") fall straight through. When a manifest is
        // active and the id isn't granted, reply so the JS promise rejects.
        let perm_id = permission_id_for_invoke(parsed.method);
        let perm_gated: bool = false;
        raw { perm_gated = ((const char*)perm_id)[0] != '\0'; }
        if perm_gated {
            if !permissions_check(perm_id, parsed.method) {
                // Reply so the JS promise rejects (bootstrap rejects with
                // new Error(payload)); runtime detects the prefix and
                // decorates with code/permission fields.
                raw {
                    char denied[160];
                    snprintf(denied, sizeof(denied), "PERMISSION_DENIED:%s", (const char*)perm_id);
                    dispatch_invoke_response(window_id, parsed.request_id, false, denied);
                }
                return;
            }
        }

        // Check for __dialog: prefix
        let is_dialog: bool = false;
        is_dialog = str::strncmp(parsed.method, "__dialog:", 9) == 0;
        if is_dialog {
            router_handle_dialog(parsed.method, parsed.payload, window_id, parsed.request_id);
            return;
        }

        // Check for __notif: prefix
        let is_notif: bool = false;
        is_notif = str::strncmp(parsed.method, "__notif:", 8) == 0;
        if is_notif {
            router_handle_notification(parsed.method, parsed.payload, window_id, parsed.request_id);
            return;
        }

        // Check for __clipboard: prefix
        let is_clipboard: bool = false;
        is_clipboard = str::strncmp(parsed.method, "__clipboard:", 12) == 0;
        if is_clipboard {
            router_handle_clipboard(parsed.method, parsed.args, parsed.has_args, window_id, parsed.request_id);
            return;
        }

        // Check for __shortcuts: prefix
        let is_shortcuts: bool = false;
        is_shortcuts = str::strncmp(parsed.method, "__shortcuts:", 12) == 0;
        if is_shortcuts {
            router_handle_shortcuts(parsed.method, parsed.args, parsed.has_args, window_id, parsed.request_id);
            return;
        }

        // Check for __zapp: prefix (framework introspection — Workers.list(), etc.)
        let is_zapp: bool = false;
        is_zapp = str::strncmp(parsed.method, "__zapp:", 7) == 0;
        if is_zapp {
            router_handle_zapp(parsed.method, window_id, parsed.request_id);
            return;
        }

        // Check for __screen: prefix (display enumeration — Screen.getAll(), etc.)
        let is_screen: bool = false;
        is_screen = str::strncmp(parsed.method, "__screen:", 9) == 0;
        if is_screen {
            screen_route(parsed.method, window_id, parsed.request_id, parsed.args);
            return;
        }

        // Check for __app: prefix (app-level request/response — setLoginItem, etc.)
        let is_app: bool = false;
        is_app = str::strncmp(parsed.method, "__app:", 6) == 0;
        if is_app {
            router_handle_app(parsed.method, parsed.args, parsed.has_args, window_id, parsed.request_id);
            return;
        }

        // __protocol:respond — runtime calls this from
        // Protocols.register's handler with { id, body, contentType,
        // status }. Route directly to the native respond function;
        // no acknowledgement needed back to JS.
        if parsed.method == "__protocol:respond" {
            if parsed.has_args {
                let id_opt = parsed.args.get_string("id");
                let body_opt = parsed.args.get_string("body");
                let ct_opt = parsed.args.get_string("contentType");
                let status_opt = parsed.args.get_int("status");
                let id_s: string = "";
                let body_s: string = "";
                let ct_s: string = "";
                let status_i: int = 200;
                if id_opt.is_some() { id_s = id_opt.unwrap(); }
                if body_opt.is_some() { body_s = body_opt.unwrap(); }
                if ct_opt.is_some() { ct_s = ct_opt.unwrap(); }
                if status_opt.is_some() { status_i = status_opt.unwrap(); }
                raw {
                    #ifdef __APPLE__
                    extern void darwin_protocol_respond(const char* request_id,
                                                        const char* body_base64,
                                                        const char* content_type,
                                                        int32_t status);
                    darwin_protocol_respond((const char*)id_s, (const char*)body_s,
                                            (const char*)ct_s, (int32_t)status_i);
                    #else
                    extern void windows_protocol_respond(const char* request_id,
                                                         const char* body_base64,
                                                         const char* content_type,
                                                         int32_t status);
                    windows_protocol_respond((const char*)id_s, (const char*)body_s,
                                             (const char*)ct_s, (int32_t)status_i);
                    #endif
                }
            }
            // Fire-and-forget — but the runtime awaits this invoke,
            // so send a minimal ok response. Empty-JSON literal goes
            // through a C string to dodge Zen-C's f-string parser
            // (curly braces are interpolation outside raw blocks).
            let empty_obj: string = "";
            raw { empty_obj = (char*)"{}"; }
            dispatch_invoke_response(window_id, parsed.request_id, true, empty_obj);
            return;
        }

        // Check for __window:create
        let is_window_create: bool = false;
        is_window_create = parsed.method == "__window:create";
        if is_window_create {
            // Create a new window from the frontend. window_opts_apply_json
            // strdups the title/url fields so opts is self-contained after
            // it returns — no lifetime dependency on parsed.args / the
            // BridgeMessage's JSON tree. Strings are freed via
            // window_opts_free after create.
            let opts = WindowOptions::create("Zapp");
            if parsed.has_args {
                window_opts_apply_json(&opts, parsed.args);
            }
            // Honor the caller's visible flag — `visible: false` is a
            // legitimate use case (e.g. tray.attachWindow needs the
            // popover hidden until tray click toggles it on). The
            // default from WindowOptions::create is already true, so
            // omitted callers still auto-show.
            let win = app.window.create(&opts);
            window_opts_free(&opts);
            // Return the window ID to the caller
            raw {
                char resp[128];
                snprintf(resp, sizeof(resp), "{\"windowId\":\"win-%d\"}", win.id);
                dispatch_invoke_response(window_id, parsed.request_id, true, resp);
            }
            return;
        }

        // __popover:create — persistent popover owned by a window. Resolves
        // the payload windowId (attachModal pattern, sender-slot fallback),
        // allocates the pane's dispatch slot, returns {"popoverId":"pop-<n>"}.
        let is_popover_create: bool = false;
        is_popover_create = parsed.method == "__popover:create";
        if is_popover_create {
            let target = window_id;
            let url_s: string = "";
            let behavior_s: string = "transient";
            let pw = 320;
            let ph = 400;
            if parsed.has_args {
                let wid_opt = parsed.args.get_string("windowId");
                if wid_opt.is_some() {
                    raw {
                        #ifdef __APPLE__
                        extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                        int32_t resolved = darwin_window_numeric_id_for_string((const char*)wid_opt.val);
                        if (resolved >= 0) target = resolved;
                        #endif
                    }
                }
                let url_opt = parsed.args.get_string("url");
                if url_opt.is_some() { url_s = url_opt.unwrap(); }
                let b_opt = parsed.args.get_string("behavior");
                if b_opt.is_some() { behavior_s = b_opt.unwrap(); }
                let pw_opt = parsed.args.get_int("width");
                if pw_opt.is_some() { pw = pw_opt.unwrap(); }
                let ph_opt = parsed.args.get_int("height");
                if ph_opt.is_some() { ph = ph_opt.unwrap(); }
            }
            let created = false;
            if url_s != "" {
                let slot = app.window.alloc_slot();
                raw {
                    #ifdef __APPLE__
                    extern void* darwin_window_get_by_numeric_id(int32_t numeric_id);
                    extern void darwin_popover_create(void* window_ptr, const char* popover_id,
                                                      const char* url, int32_t width, int32_t height,
                                                      const char* behavior, int32_t host_slot,
                                                      int32_t popover_slot);
                    void* host = darwin_window_get_by_numeric_id((int32_t)target);
                    if (host) {
                        char pid[32];
                        snprintf(pid, sizeof(pid), "pop-%d", slot);
                        darwin_popover_create(host, pid, (const char*)url_s, (int32_t)pw, (int32_t)ph,
                                              (const char*)behavior_s, (int32_t)target, (int32_t)slot);
                        created = true;
                    }
                    #endif
                }
                if created {
                    raw {
                        char resp[64];
                        snprintf(resp, sizeof(resp), "{\"popoverId\":\"pop-%d\"}", slot);
                        dispatch_invoke_response(window_id, parsed.request_id, true, resp);
                    }
                    return;
                }
            }
            raw {
                dispatch_invoke_response(window_id, parsed.request_id, false,
                    (char*)"[zapp] popover: window not found or url missing");
            }
            return;
        }

        let result = service_invoke(app, parsed.method, parsed.args);
        if result.is_ok() {
            dispatch_invoke_response(window_id, parsed.request_id, true, result.unwrap());
        } else {
            dispatch_invoke_response(window_id, parsed.request_id, false, "NOT_FOUND");
        }
        return;
    }

    if parsed.msg_type == MsgType.CANCEL {
        raw { zapp_cancel_request(parsed.request_id); }
        return;
    }

    if parsed.msg_type == MsgType.EMIT {
        // Extract just the "a" (args) field — parsed.payload is the full
        // {t,m,a} envelope, but listeners expect their user payload directly.
        // Worker emits already pass the unwrapped payload; this matches that.
        let args_json: string = "";
        raw {
            #ifdef __APPLE__
            extern const char* darwin_dialog_extract_args(const char* full_json);
            args_json = (char*)darwin_dialog_extract_args((const char*)parsed.payload);
            #else
            extern const char* windows_dialog_extract_args(const char* full_json);
            args_json = (char*)windows_dialog_extract_args((const char*)parsed.payload);
            #endif
        }
        dispatch_event_to_all(parsed.method, args_json);
        return;
    }

    if parsed.msg_type == MsgType.WINDOW_ACTION {
        // parsed.args is already a JsonValue* (borrowed pointer into parsed.root).
        // Pass it directly — no copy, no move, no drop in the handler.
        router_handle_window_action(app, parsed.method, parsed.payload, window_id, parsed.args, parsed.has_args);
        return;
    }

    if parsed.msg_type == MsgType.WORKER {
        router_handle_worker(app, parsed.method, parsed.payload, window_id, parsed.args, parsed.has_args);
        return;
    }

    if parsed.msg_type == MsgType.SYNC {
        raw {
            #ifdef __APPLE__
            extern void darwin_sync_handle(const char* action, const char* payload_json);
            darwin_sync_handle((const char*)parsed.method, (const char*)parsed.payload);
            #else
            extern void windows_sync_handle(const char* action, const char* payload_json);
            windows_sync_handle((const char*)parsed.method, (const char*)parsed.payload);
            #endif
        }
        return;
    }
}

// Map "window:eventname" → event ID for bitmask
fn event_name_to_id(name: string) -> int {
    raw {
        const char* n = (const char*)name;
        // Skip "window:" prefix
        if (strncmp(n, "window:", 7) == 0) n += 7;
        if (strcmp(n, "ready") == 0)        return 0;
        if (strcmp(n, "focus") == 0)        return 1;
        if (strcmp(n, "blur") == 0)         return 2;
        if (strcmp(n, "resize") == 0)       return 3;
        if (strcmp(n, "move") == 0)         return 4;
        if (strcmp(n, "close") == 0)        return 5;
        if (strcmp(n, "minimize") == 0)     return 6;
        if (strcmp(n, "maximize") == 0)     return 7;
        if (strcmp(n, "restore") == 0)      return 8;
        if (strcmp(n, "fullscreen") == 0)   return 9;
        if (strcmp(n, "unfullscreen") == 0) return 10;
    }
    return -1;
}

fn router_handle_window_action(app: App*, action: string, payload: string, window_id: int, pre_args: JsonValue*, has_pre_args: bool) -> void {
    // Permission gate (t:4 fire-and-forget). Gated actions (tray/dock/
    // panel/menu/shell) have no reply channel — denial logs once per id
    // and drops the action. Ungated actions ("") fall straight through.
    let act_perm = permission_id_for_action(action);
    let act_gated: bool = false;
    raw { act_gated = ((const char*)act_perm)[0] != '\0'; }
    if act_gated {
        if !permissions_check(act_perm, action) { return; } // log + drop (no reply channel)
    }

    // Handle bridge ready signal
    let is_ready = action == "ready";
    if is_ready {
        let wid: string = NULL;
        raw {
            #ifdef __APPLE__
            extern const char* darwin_window_id_string(int32_t numeric_id);
            wid = (char*)darwin_window_id_string(window_id);
            #else
            extern const char* windows_window_id_string(int32_t numeric_id);
            wid = (char*)windows_window_id_string(window_id);
            #endif
        }
        if wid != NULL {
            // Terminate any existing workers owned by this window (handles page refresh)
            raw {
                #if defined(ZAPP_WORKER_ENGINE_ZJS) || defined(ZAPP_WORKER_ENGINE_BARE_JSC) \
                 || defined(ZAPP_WORKER_ENGINE_BARE_V8) || defined(ZAPP_WORKER_ENGINE_BARE_QUICKJS) \
                 || defined(ZAPP_WORKER_ENGINE_BARE_MQJS) || defined(ZAPP_WORKER_ENGINE_BARE_HERMES)
                extern void worker_terminate_owner(char* owner_id);
                worker_terminate_owner((char*)wid);
                #endif
            }
            raw {
                #ifdef __APPLE__
                extern void darwin_window_set_bridge_ready(const char* window_id);
                darwin_window_set_bridge_ready((const char*)wid);
                #else
                extern void windows_window_set_bridge_ready(const char* window_id);
                windows_window_set_bridge_ready((const char*)wid);
                #endif
            }
        }
        // NOTE: notification event flush moved to subscribe handler (lazy flush)
        // so buffered events only dispatch after user code registers handlers

        // Fire the native on_ready callback for this window
        raw {
            extern void zapp_window_trigger_on_ready(int id);
            zapp_window_trigger_on_ready(window_id);
        }
        return;
    }

    // Use pre-parsed args (eliminates double JSON parse).
    // pre_args is borrowed — owned by caller's `parsed`. Method calls compile
    // to JsonValue__get_string(pre_args, ...) — pointer receiver, no copy.
    if !has_pre_args { return; }

    // App-level lifecycle actions (no window handle needed). macOS-only;
    // raw blocks no-op elsewhere (Windows -> #167).
    let is_set_quit_guard = action == "setQuitGuard";
    if is_set_quit_guard {
        let on_opt = pre_args.get_bool("enabled");
        let on: bool = false;
        if on_opt.is_some() { on = on_opt.unwrap(); }
        raw {
            #ifdef __APPLE__
            extern void darwin_set_quit_guard(bool enabled);
            darwin_set_quit_guard(on);
            #else
            extern void windows_set_quit_guard(bool enabled);
            windows_set_quit_guard(on);
            #endif
        }
        return;
    }
    let is_quit = action == "quit";
    if is_quit {
        let force_opt = pre_args.get_bool("force");
        let force: bool = false;
        if force_opt.is_some() { force = force_opt.unwrap(); }
        raw {
            #ifdef __APPLE__
            extern void darwin_app_quit(bool force);
            darwin_app_quit(force);
            #else
            extern void windows_app_quit(bool force);
            windows_app_quit(force);
            #endif
        }
        return;
    }
    let is_activate = action == "activate";
    if is_activate {
        raw {
            #ifdef __APPLE__
            extern void darwin_app_activate(void);
            darwin_app_activate();
            #else
            extern void windows_app_activate(void);
            windows_app_activate();
            #endif
        }
        return;
    }

    // Accessory-pane sender resolution. A window action (t:4) carries the
    // SENDER's transport slot as window_id. For the host pane (or a standalone
    // window) that slot IS a WindowManager window. But a sidebar/inspector/
    // popover pane registers under its OWN dispatch slot, which is NOT a
    // WindowManager entry — only the host is. So a window action posted from
    // INSIDE an accessory pane (e.g. Window.current().inspector.toggle() in the
    // inspector pane's own JS) arrives with an accessory slot that fails the
    // is_valid() guard below and gets silently dropped — even though every
    // accessory action block resolves its real target afterward.
    //
    // Accessory slots are registered under the HOST's "win-<host>" id string
    // (window.m zapp_register_webview), so slot -> string -> numeric round-trips
    // to the host slot (first-match-wins). Remap the sender to its host window
    // when it isn't a WindowManager window itself; window-scoped actions then
    // operate on the host, matching the launcher path. (t:3 Events skip this
    // path entirely — EMIT never validates the sender — which is why sidebar
    // Events.emit always worked while this t:4 path did not.)
    let sender_probe = app.window.get(window_id);
    if !sender_probe.is_valid() {
        raw {
            #ifdef __APPLE__
            extern const char* darwin_window_id_string(int32_t numeric_id);
            extern int32_t darwin_window_numeric_id_for_string(const char* wid);
            const char* host_str = darwin_window_id_string(window_id);
            if (host_str) {
                int32_t host_id = darwin_window_numeric_id_for_string(host_str);
                if (host_id >= 0) window_id = host_id;
            }
            #else
            // Windows has no accessory panes (sidebar/inspector are Apple-only),
            // so every sender slot is already a real window — this branch is a
            // no-op in practice. Parse "win-N" back to N (same approach as the
            // attachModal Windows path) rather than depend on a numeric-id
            // reverse-lookup symbol that doesn't exist on Windows.
            extern const char* windows_window_id_string(int32_t numeric_id);
            const char* host_str = windows_window_id_string(window_id);
            if (host_str) {
                int parsed_host = -1;
                if (sscanf(host_str, "win-%d", &parsed_host) == 1 && parsed_host >= 0) {
                    window_id = parsed_host;
                }
            }
            #endif
        }
    }

    // Window operations — get the window handle from the manager
    let win = app.window.get(window_id);
    if !win.is_valid() { return; }

    let is_show = action == "show";
    let is_hide = action == "hide";
    let is_minimize = action == "minimize";
    let is_set_focus = action == "setFocus";
    let is_maximize = action == "maximize";
    let is_subscribe = action == "subscribe";
    let is_unsubscribe = action == "unsubscribe";
    let is_set_title = action == "setTitle";
    let is_set_fullscreen = action == "setFullscreen";
    let is_set_always_on_top = action == "setAlwaysOnTop";
    let is_set_size = action == "setSize";
    let is_set_position = action == "setPosition";

    // openExternal — open URL in system browser
    let is_open_external: bool = false;
    is_open_external = action == "openExternal";
    if is_open_external {
        let url_opt = pre_args.get_string("url");
        if url_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern void darwin_open_external(const char* url);
                darwin_open_external((const char*)url_opt.val);
                #else
                extern void windows_open_external(const char* url);
                windows_open_external((const char*)url_opt.val);
                #endif
            }
        }
        return;
    }

    // Finder integration — reveal / open / trash a filesystem path.
    // All three take the same { path: string } payload; they're grouped
    // here rather than scattered because the wire shape is identical.
    //
    // Path expansion: all three resolve `$userData` / `~/` prefixes via
    // fs_expand_path so callers can write the same paths they'd pass to
    // `app.fs.*`. Empty / unexpandable inputs pass through and the
    // darwin helpers no-op on them.
    //
    // Allowlist policy: showItemInFolder and openPath are non-destructive
    // (delegate to user-visible OS actions; the user sees what's happening
    // and can cancel). trashItem moves data — gate by the FS allowlist,
    // the same `config.fs.allow` list that gates `app.fs.remove`. Without
    // this gate, JS could trashItem any path on disk, bypassing the
    // allowlist that gates every other path-mutating call. Dialog grants
    // still extend the session allowlist, so user-picked files work.
    let is_show_item = action == "showItemInFolder";
    let is_open_path = action == "openPath";
    let is_trash_item = action == "trashItem";
    if is_show_item || is_open_path || is_trash_item {
        let path_opt = pre_args.get_string("path");
        if !path_opt.is_some() { return; }
        let path: string = path_opt.unwrap();
        let abs = fs_expand_path(path);

        if is_trash_item {
            if !fs_is_allowed(abs) { return; }
        }

        raw {
            #ifdef __APPLE__
            extern void darwin_show_item_in_folder(const char* p);
            extern void darwin_open_path(const char* p);
            extern void darwin_trash_item(const char* p);
            if (is_show_item) darwin_show_item_in_folder((const char*)abs);
            else if (is_open_path) darwin_open_path((const char*)abs);
            else if (is_trash_item) darwin_trash_item((const char*)abs);
            #else
            extern void windows_show_item_in_folder(const char* p);
            extern void windows_open_path(const char* p);
            extern void windows_trash_item(const char* p);
            if (is_show_item) windows_show_item_in_folder((const char*)abs);
            else if (is_open_path) windows_open_path((const char*)abs);
            else if (is_trash_item) windows_trash_item((const char*)abs);
            #endif
        }
        return;
    }

    // Draggable regions
    let is_set_drag: bool = false;
    is_set_drag = action == "setDragRegion";
    if is_set_drag {
        let drag_opt = pre_args.get_bool("drag");
        if drag_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern void darwin_webview_set_drag_region(int32_t window_id, bool drag);
                darwin_webview_set_drag_region(window_id, drag_opt.val);
                #else
                extern void windows_webview_set_drag_region(int32_t window_id, bool drag);
                windows_webview_set_drag_region(window_id, drag_opt.val);
                #endif
            }
        }
        return;
    }

    // Close guard — JS can prevent window close
    let is_set_close_guard = action == "setCloseGuard";
    let is_close = action == "close";
    if is_set_close_guard {
        let on_opt = pre_args.get_bool("on");
        if on_opt.is_some() {
            raw {
                extern void zapp_window_set_close_guard(int id, int enabled);
                zapp_window_set_close_guard(window_id, on_opt.val ? 1 : 0);
            }
        }
        return;
    }
    if is_close {
        // Force close — clear guard, then close (bypasses windowShouldClose)
        raw {
            extern void zapp_window_set_close_guard(int id, int enabled);
            zapp_window_set_close_guard(window_id, 0);
        }
        window_force_close(win.handle);
        return;
    }

    // attachModal / detachModal — show another window as a sheet on the
    // parent. JS-visible window IDs are pointer-based strings, so the
    // primary path is to look them up via darwin_window_numeric_id_for_string;
    // raw numeric IDs (from the int branch) are accepted for symmetry
    // with asSheetOf and for callers that already have the numeric form.
    let is_attach_modal = action == "attachModal";
    let is_detach_modal = action == "detachModal";
    if is_attach_modal || is_detach_modal {
        let parent_numeric: int = -1;
        let modal_numeric: int = -1;
        let parent_int_opt = pre_args.get_int("parentId");
        if parent_int_opt.is_some() { parent_numeric = parent_int_opt.unwrap(); }
        let modal_int_opt = pre_args.get_int("modalId");
        if modal_int_opt.is_some() { modal_numeric = modal_int_opt.unwrap(); }
        if parent_numeric < 0 {
            let p_str = pre_args.get_string("parentId");
            if p_str.is_some() {
                let ps: string = p_str.unwrap();
                raw {
                    #ifdef __APPLE__
                    extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                    parent_numeric = (int)darwin_window_numeric_id_for_string((const char*)ps);
                    #else
                    int parsed = -1;
                    if (sscanf((const char*)ps, "win-%d", &parsed) == 1) parent_numeric = parsed;
                    #endif
                }
            }
        }
        if modal_numeric < 0 {
            let m_str = pre_args.get_string("modalId");
            if m_str.is_some() {
                let ms: string = m_str.unwrap();
                raw {
                    #ifdef __APPLE__
                    extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                    modal_numeric = (int)darwin_window_numeric_id_for_string((const char*)ms);
                    #else
                    int parsed = -1;
                    if (sscanf((const char*)ms, "win-%d", &parsed) == 1) modal_numeric = parsed;
                    #endif
                }
            }
        }
        if parent_numeric < 0 || modal_numeric < 0 { return; }
        let parent = app.window.get(parent_numeric);
        let modal = app.window.get(modal_numeric);
        if parent.is_valid() && modal.is_valid() {
            if is_attach_modal { parent.attach_modal(modal); }
            else { parent.detach_modal(modal); }
        }
        return;
    }

    // loadUrl — navigate WebView to a new URL
    let is_load_url: bool = false;
    is_load_url = action == "loadUrl";
    if is_load_url {
        let url_opt = pre_args.get_string("url");
        if url_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern void darwin_window_load_url(int32_t window_id, const char* url);
                darwin_window_load_url(window_id, (const char*)url_opt.val);
                #else
                extern void windows_window_load_url(int32_t window_id, const char* url);
                windows_window_load_url(window_id, (const char*)url_opt.val);
                #endif
            }
        }
        return;
    }

    // Embedded-webview (panel) actions — delegate to panel.zc.
    if panel_route(window_id, action, pre_args) { return; }

    // Dock actions
    if action == "dock:showIcon" { dock_show_icon(); return; }
    if action == "dock:hideIcon" { dock_hide_icon(); return; }
    if action == "dock:removeBadge" { dock_remove_badge(); return; }
    if action == "dock:resetIcon" { dock_reset_icon(); return; }
    if action == "dock:setBadge" {
        let label_opt = pre_args.get_string("label");
        if label_opt.is_some() { dock_set_badge(label_opt.unwrap()); }
        return;
    }
    if action == "dock:bounce" {
        let type_opt = pre_args.get_int("type");
        let t = 0;
        if type_opt.is_some() { t = type_opt.unwrap(); }
        dock_bounce(t);
        return;
    }
    if action == "dock:setProgress" {
        // permille 0..1000 (<0 clears); mode 0 normal/1 indeterminate/2 error/
        // 3 paused/4 none. Runtime sends ints to avoid float JSON parsing.
        let pm_opt = pre_args.get_int("permille");
        let mode_opt = pre_args.get_int("mode");
        let pm = -1;
        let mode = 0;
        if pm_opt.is_some() { pm = pm_opt.unwrap(); }
        if mode_opt.is_some() { mode = mode_opt.unwrap(); }
        dock_set_progress(pm, mode);
        return;
    }
    if action == "dock:setIcon" {
        let path_opt = pre_args.get_string("path");
        if path_opt.is_some() { dock_set_icon(path_opt.unwrap()); }
        return;
    }

    // Sidebar actions — native NSSplitViewItem sidebar (macOS only).
    // Target resolution: SidebarHandle always sends the host window's id in
    // the payload — resolve it (same pattern as attachModal above) so handles
    // held OUTSIDE the sidebar window (e.g. the creator's Window.create
    // handle) target the right window. Fall back to the SENDER's transport
    // slot, which from either pane resolves to the owning window via the
    // sidebar registry.
    let is_sb_toggle = action == "sidebar:toggle";
    let is_sb_collapse = action == "sidebar:collapse";
    let is_sb_expand = action == "sidebar:expand";
    let is_sb_set_width = action == "sidebar:setWidth";
    if is_sb_toggle || is_sb_collapse || is_sb_expand || is_sb_set_width {
        let sb_target = window_id;
        let sb_wid_opt = pre_args.get_string("windowId");
        if sb_wid_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                int32_t sb_resolved = darwin_window_numeric_id_for_string((const char*)sb_wid_opt.val);
                if (sb_resolved >= 0) sb_target = sb_resolved;
                #endif
            }
        }
        let sb_w = 0;
        if is_sb_set_width {
            let width_opt = pre_args.get_int("width");
            if width_opt.is_some() { sb_w = width_opt.unwrap(); }
        }
        raw {
            #ifdef __APPLE__
            extern void darwin_sidebar_toggle(int32_t window_id);
            extern void darwin_sidebar_collapse(int32_t window_id);
            extern void darwin_sidebar_expand(int32_t window_id);
            extern void darwin_sidebar_set_width(int32_t window_id, int32_t width);
            if (is_sb_toggle) darwin_sidebar_toggle((int32_t)sb_target);
            else if (is_sb_collapse) darwin_sidebar_collapse((int32_t)sb_target);
            else if (is_sb_expand) darwin_sidebar_expand((int32_t)sb_target);
            else darwin_sidebar_set_width((int32_t)sb_target, (int32_t)sb_w);
            #endif
        }
        return;
    }

    let is_in_toggle = action == "inspector:toggle";
    let is_in_collapse = action == "inspector:collapse";
    let is_in_expand = action == "inspector:expand";
    let is_in_set_width = action == "inspector:setWidth";
    if is_in_toggle || is_in_collapse || is_in_expand || is_in_set_width {
        let in_target = window_id;
        let in_wid_opt = pre_args.get_string("windowId");
        if in_wid_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                int32_t in_resolved = darwin_window_numeric_id_for_string((const char*)in_wid_opt.val);
                if (in_resolved >= 0) in_target = in_resolved;
                #endif
            }
        }
        let in_w = 0;
        if is_in_set_width {
            let width_opt = pre_args.get_int("width");
            if width_opt.is_some() { in_w = width_opt.unwrap(); }
        }
        raw {
            #ifdef __APPLE__
            extern void darwin_inspector_toggle(int32_t window_id);
            extern void darwin_inspector_collapse(int32_t window_id);
            extern void darwin_inspector_expand(int32_t window_id);
            extern void darwin_inspector_set_width(int32_t window_id, int32_t width);
            if (is_in_toggle) darwin_inspector_toggle((int32_t)in_target);
            else if (is_in_collapse) darwin_inspector_collapse((int32_t)in_target);
            else if (is_in_expand) darwin_inspector_expand((int32_t)in_target);
            else darwin_inspector_set_width((int32_t)in_target, (int32_t)in_w);
            #endif
        }
        return;
    }

    // Popover actions — keyed by popoverId (popover.m registry). show passes
    // the raw args subtree through: popover.m parses anchor/edge itself
    // (tray-style payload-driven extraction).
    let is_pop_show = action == "popover:show";
    let is_pop_hide = action == "popover:hide";
    let is_pop_destroy = action == "popover:destroy";
    if is_pop_show || is_pop_hide || is_pop_destroy {
        let pid_opt = pre_args.get_string("popoverId");
        if !pid_opt.is_some() { return; }
        let pid: string = pid_opt.unwrap();
        raw {
            #ifdef __APPLE__
            extern void darwin_popover_show(const char* popover_id, const char* args_json, int32_t sender_slot);
            extern void darwin_popover_hide(const char* popover_id);
            extern void darwin_popover_destroy(const char* popover_id);
            extern const char* darwin_dialog_extract_args(const char* full_json);
            if (is_pop_show) {
                const char* args_json = darwin_dialog_extract_args((const char*)payload);
                darwin_popover_show((const char*)pid, args_json, (int32_t)window_id);
            } else if (is_pop_hide) {
                darwin_popover_hide((const char*)pid);
            } else {
                darwin_popover_destroy((const char*)pid);
            }
            #endif
        }
        return;
    }

    // Toolbar lifecycle — window ops on an existing window, ungated like
    // sidebar:* (docs/security.md). Payload-windowId resolution (sidebar
    // pattern) so handles work from the creator, either pane, anywhere;
    // fall back to the SENDER's slot. The numeric id doubles as the
    // host_slot for chrome-metrics injection (window.m slot == window id).
    let is_tb_set = action == "toolbar:setItems";
    let is_tb_update = action == "toolbar:updateItem";
    let is_tb_remove = action == "toolbar:remove";
    if is_tb_set || is_tb_update || is_tb_remove {
        let tb_target = window_id;
        let tb_wid_opt = pre_args.get_string("windowId");
        if tb_wid_opt.is_some() {
            raw {
                #ifdef __APPLE__
                extern int32_t darwin_window_numeric_id_for_string(const char* wid);
                int32_t tb_resolved = darwin_window_numeric_id_for_string((const char*)tb_wid_opt.val);
                if (tb_resolved >= 0) tb_target = tb_resolved;
                #endif
            }
        }
        let tb_json: string = "";
        if is_tb_set {
            let tj_opt = pre_args.get_string("toolbarJson");
            if !tj_opt.is_some() { return; }
            tb_json = tj_opt.unwrap();
        }
        if is_tb_update {
            let ij_opt = pre_args.get_string("itemJson");
            if !ij_opt.is_some() { return; }
            tb_json = ij_opt.unwrap();
        }
        raw {
            #ifdef __APPLE__
            extern void* darwin_window_get_by_numeric_id(int32_t numeric_id);
            extern void darwin_toolbar_set_items(void* window_ptr, const char* toolbar_json, int32_t host_slot);
            extern void darwin_toolbar_update_item(void* window_ptr, const char* item_json);
            extern void darwin_toolbar_remove(void* window_ptr);
            void* tb_wptr = darwin_window_get_by_numeric_id((int32_t)tb_target);
            if (tb_wptr) {
                if (is_tb_set) darwin_toolbar_set_items(tb_wptr, (const char*)tb_json, (int32_t)tb_target);
                else if (is_tb_update) darwin_toolbar_update_item(tb_wptr, (const char*)tb_json);
                else darwin_toolbar_remove(tb_wptr);
            }
            #endif
        }
        return;
    }

    // Tray actions — payload-driven (the .m side extracts "a" itself).
    // Each maps directly to a darwin_tray_*_from_payload entry point.
    let is_tray_create = action == "tray:create";
    let is_tray_set_icon = action == "tray:setIcon";
    let is_tray_set_title = action == "tray:setTitle";
    let is_tray_set_tooltip = action == "tray:setTooltip";
    let is_tray_set_menu = action == "tray:setMenu";
    let is_tray_destroy = action == "tray:destroy";
    let is_tray_attach_window = action == "tray:attachWindow";
    let is_tray_detach_window = action == "tray:detachWindow";
    if is_tray_create {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_create_from_payload(const char* payload_json);
            darwin_tray_create_from_payload((const char*)payload);
            #else
            extern void windows_tray_create_from_payload(const char* payload_json);
            windows_tray_create_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_set_icon {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_set_icon_from_payload(const char* payload_json);
            darwin_tray_set_icon_from_payload((const char*)payload);
            #else
            extern void windows_tray_set_icon_from_payload(const char* payload_json);
            windows_tray_set_icon_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_set_title {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_set_title_from_payload(const char* payload_json);
            darwin_tray_set_title_from_payload((const char*)payload);
            #else
            extern void windows_tray_set_title_from_payload(const char* payload_json);
            windows_tray_set_title_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_set_tooltip {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_set_tooltip_from_payload(const char* payload_json);
            darwin_tray_set_tooltip_from_payload((const char*)payload);
            #else
            extern void windows_tray_set_tooltip_from_payload(const char* payload_json);
            windows_tray_set_tooltip_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_set_menu {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_set_menu_from_payload(const char* payload_json);
            darwin_tray_set_menu_from_payload((const char*)payload);
            #else
            extern void windows_tray_set_menu_from_payload(const char* payload_json);
            windows_tray_set_menu_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_destroy {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_destroy_from_payload(const char* payload_json);
            darwin_tray_destroy_from_payload((const char*)payload);
            #else
            extern void windows_tray_destroy_from_payload(const char* payload_json);
            windows_tray_destroy_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_attach_window {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_attach_window_from_payload(const char* payload_json);
            darwin_tray_attach_window_from_payload((const char*)payload);
            #else
            extern void windows_tray_attach_window_from_payload(const char* payload_json);
            windows_tray_attach_window_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_tray_detach_window {
        raw {
            #ifdef __APPLE__
            extern void darwin_tray_detach_window_from_payload(const char* payload_json);
            darwin_tray_detach_window_from_payload((const char*)payload);
            #else
            extern void windows_tray_detach_window_from_payload(const char* payload_json);
            windows_tray_detach_window_from_payload((const char*)payload);
            #endif
        }
        return;
    }

    // Menu actions — use the full payload (ObjC extracts "a" items array)
    let is_set_menu = action == "setMenu";
    let is_show_ctx = action == "showContextMenu";
    if is_set_menu {
        raw {
            #ifdef __APPLE__
            extern void darwin_menu_set_from_payload(const char* payload_json);
            darwin_menu_set_from_payload((const char*)payload);
            #else
            extern void windows_menu_set_from_payload(const char* payload_json);
            windows_menu_set_from_payload((const char*)payload);
            #endif
        }
        return;
    }
    if is_show_ctx {
        raw {
            #ifdef __APPLE__
            extern void darwin_menu_show_context_from_payload(const char* payload_json, int32_t window_id);
            darwin_menu_show_context_from_payload((const char*)payload, window_id);
            #else
            extern void windows_menu_show_context_from_payload(const char* payload_json, int32_t window_id);
            windows_menu_show_context_from_payload((const char*)payload, window_id);
            #endif
        }
        return;
    }

    if is_show { win.show(); return; }
    if is_hide { win.hide(); return; }
    if is_minimize { window_minimize(win.handle); return; }
    if is_set_focus { window_focus(win.handle); return; }
    if is_maximize { window_maximize(win.handle); return; }

    if is_set_title {
        let title_opt = pre_args.get_string("title");
        if title_opt.is_some() {
            window_set_title(win.handle, title_opt.unwrap());
        }
        return;
    }

    if is_set_size {
        let w_opt = pre_args.get_int("width");
        let h_opt = pre_args.get_int("height");
        if w_opt.is_some() && h_opt.is_some() {
            window_set_size(win.handle, w_opt.unwrap(), h_opt.unwrap());
        }
        return;
    }

    if is_set_position {
        let x_opt = pre_args.get_int("x");
        let y_opt = pre_args.get_int("y");
        if x_opt.is_some() && y_opt.is_some() {
            window_set_position(win.handle, x_opt.unwrap(), y_opt.unwrap());
        }
        return;
    }

    if is_set_fullscreen {
        let on_opt = pre_args.get_bool("on");
        if on_opt.is_some() {
            window_set_fullscreen(win.handle, on_opt.unwrap());
        }
        return;
    }

    if is_set_always_on_top {
        let on_opt = pre_args.get_bool("on");
        if on_opt.is_some() {
            window_set_always_on_top(win.handle, on_opt.unwrap());
        }
        return;
    }

    // Subscribe/unsubscribe for event bitmask
    if !is_subscribe && !is_unsubscribe { return; }

    let event_opt = pre_args.get_string("event");
    if !event_opt.is_some() { return; }
    let event_name = event_opt.unwrap();

    // Lazy flush: when JS subscribes to notification events, flush any buffered
    // notification responses. This ensures the handler is registered before events fire.
    if is_subscribe {
        if str::strncmp(event_name, "__notif:", 7) == 0 {
            raw {
                #ifdef __APPLE__
                extern void darwin_notification_set_bridge_ready(void);
                darwin_notification_set_bridge_ready();
                #else
                extern void windows_notification_set_bridge_ready(void);
                windows_notification_set_bridge_ready();
                #endif
            }
        }
    }

    let event_id = event_name_to_id(event_name);
    if event_id < 0 { return; }

    // Set/clear the JS listener bitmask (is_subscribe already set above)
    raw {
        extern void zapp_window_set_js_listener(int id, int event_id, int has_listener);
        zapp_window_set_js_listener(window_id, event_id, is_subscribe ? 1 : 0);
    }
}

// --- Worker message handler ---

fn router_handle_worker(app: App*, action: string, payload: string, window_id: int, pre_args: JsonValue*, has_pre_args: bool) -> void {
    if !workers_enabled() { return; }
    if !has_pre_args { return; }
    // pre_args is borrowed — owned by caller's `parsed`. See window-action handler.

    let is_create = action == "create";
    let is_post = action == "post";
    let is_terminate = action == "terminate";
    let is_disconnect = action == "disconnect";

    if is_create {
        let url_opt = pre_args.get_string("scriptUrl");
        let wid_opt = pre_args.get_string("workerId");
        if !url_opt.is_some() || !wid_opt.is_some() { return; }
        let script_url = url_opt.unwrap();
        let worker_id = wid_opt.unwrap();

        // Owner ID derived from window's string ID
        let owner_id: string = NULL;
        raw {
            #ifdef __APPLE__
            extern const char* darwin_window_id_string(int32_t numeric_id);
            owner_id = (char*)darwin_window_id_string(window_id);
            #else
            extern const char* windows_window_id_string(int32_t numeric_id);
            owner_id = (char*)windows_window_id_string(window_id);
            #endif
        }
        if owner_id == NULL { return; }

        // Check if this is a shared worker
        let is_shared: bool = false;
        let shared_opt = pre_args.get_bool("shared");
        if shared_opt.is_some() { is_shared = shared_opt.unwrap(); }

        // Per-worker engine selection (G8). JS callers pass
        // `engine: "bare-jsc" | "bare-v8" | "bare-quickjs" | "bare-mqjs"
        //         | "bare-hermes" | "zjs"`. Default -1 = "no preference"
        // — the resolver picks the highest-priority engine compiled
        // into the binary (priority order documented in
        // worker.zc:fallback, currently zjs > bare-jsc > bare-v8 > …).
        // Constants mirror worker/registry.zc and cli/src/build-config.ts.
        let engine: int = -1;
        let engine_str_opt = pre_args.get_string("engine");
        if engine_str_opt.is_some() {
            let s = engine_str_opt.unwrap();
            if s == "bare-jsc"      { engine = 2; }
            else if s == "bare-v8"      { engine = 3; }
            else if s == "bare-quickjs" { engine = 4; }
            else if s == "bare-mqjs"    { engine = 5; }
            else if s == "bare-hermes"  { engine = 6; }
            else if s == "zjs"          { engine = 7; }
        }

        // Optional display name (`new Worker(url, { name })`). Defaults to
        // "" when absent; the registry treats an empty name as "leave the
        // slot's existing name untouched".
        let worker_name: string = "";
        let name_opt = pre_args.get_string("name");
        if name_opt.is_some() { worker_name = name_opt.unwrap(); }

        if is_shared {
            // Check for existing shared worker with same script URL
            let existing_id: string = "";
            raw {
                const char* eid = zapp_worker_registry_find_shared((const char*)script_url);
                if (eid) existing_id = (char*)eid;
            }
            if existing_id != "" {
                // Connect to existing shared worker — just add this window as an owner
                raw {
                    zapp_worker_registry_add_owner((const char*)existing_id, owner_id);
                }
                // Notify JS of the actual worker ID (may differ from requested)
                dispatch_invoke_response(window_id, 0, true, existing_id);
                return;
            }
            // First shared worker with this URL — create it
            raw {
                zapp_worker_registry_add_full_with_engine_and_name((const char*)worker_id, owner_id,
                    1, (const char*)script_url, (int)engine, (const char*)worker_name);
            }
        } else {
            // Dedicated worker
            raw {
                zapp_worker_registry_add_full_with_engine_and_name((const char*)worker_id, owner_id,
                    0, (const char*)script_url, (int)engine, (const char*)worker_name);
            }
        }

        worker_create(app, script_url, owner_id, worker_id, engine);
        return;
    }

    if is_post {
        let wid_opt = pre_args.get_string("workerId");
        let data_opt = pre_args.get_string("data");
        if !wid_opt.is_some() { return; }
        let data_json: string = "";
        if data_opt.is_some() { data_json = data_opt.unwrap(); }
        worker_post_message(wid_opt.unwrap(), data_json);
        return;
    }

    if is_terminate {
        let wid_opt = pre_args.get_string("workerId");
        if !wid_opt.is_some() { return; }
        let wid = wid_opt.unwrap();

        // For shared workers, check refcount before terminating
        let should_terminate: bool = true;
        raw {
            if (zapp_worker_registry_is_shared((const char*)wid)) {
                // Shared workers can't be terminated by a single window — use disconnect instead
                should_terminate = false;
            }
        }
        if should_terminate {
            worker_terminate(wid);
            raw {
                zapp_worker_registry_remove((const char*)wid);
            }
        }
        return;
    }

    // Disconnect from a shared worker (remove owner reference, terminate if refcount=0)
    if is_disconnect {
        let wid_opt = pre_args.get_string("workerId");
        if !wid_opt.is_some() { return; }
        let wid = wid_opt.unwrap();

        let owner_id: string = NULL;
        raw {
            #ifdef __APPLE__
            extern const char* darwin_window_id_string(int32_t numeric_id);
            owner_id = (char*)darwin_window_id_string(window_id);
            #else
            extern const char* windows_window_id_string(int32_t numeric_id);
            owner_id = (char*)windows_window_id_string(window_id);
            #endif
        }
        if owner_id == NULL { return; }

        let remaining: int = 0;
        raw {
            remaining = zapp_worker_registry_remove_owner((const char*)wid, owner_id);
        }
        if remaining <= 0 {
            worker_terminate(wid);
            raw {
                zapp_worker_registry_remove((const char*)wid);
            }
        }
        return;
    }
}

// --- Zapp framework introspection handler ---
//
// Webview path for framework-level queries. Today the only method is
// __zapp:workers-list, which backs Workers.list() from a webview context:
// it returns the active worker registry as a JSON array. Workers query the
// same registry via their per-engine host object and never hit this route.
//
// Memory: zapp_workers_registry_list_json() returns a heap string the
// caller must free(). dispatch_invoke_response escapes + copies the payload
// into its own heap buffer synchronously (and the platform eval primitives
// copy that synchronously too — see bridge/dispatch.zc), so freeing the
// registry string immediately after the call is safe.
fn router_handle_zapp(method: string, window_id: int, request_id: int) -> void {
    if method == "__zapp:workers-list" {
        let json: string = NULL;
        raw {
            extern char* zapp_workers_registry_list_json(void);
            json = zapp_workers_registry_list_json();
        }
        if json == NULL {
            dispatch_invoke_response(window_id, request_id, false, "ALLOC_FAILED");
            return;
        }
        dispatch_invoke_response(window_id, request_id, true, json);
        raw { free((void*)json); }
        return;
    }
    if method == "__zapp:permissions" {
        dispatch_invoke_response(window_id, request_id, true, permissions_bootstrap_json());
        return;
    }
    dispatch_invoke_response(window_id, request_id, false, "UNKNOWN_ZAPP_METHOD");
}

// __app:* request/response handlers. macOS-only (SMAppService, 13+);
// returns "false" (a JSON boolean the runtime JSON.parses) elsewhere or
// when the OS API is unavailable.
fn router_handle_app(method: string, args: JsonValue*, has_args: bool, window_id: int, request_id: int) -> void {
    let is_set = method == "__app:setLoginItem";
    let is_get = method == "__app:getLoginItem";
    if !is_set && !is_get { dispatch_invoke_response(window_id, request_id, false, "UNKNOWN"); return; }

    let result: bool = false;
    if is_set {
        let enabled: bool = false;
        if has_args {
            let e_opt = args.get_bool("enabled");
            if e_opt.is_some() { enabled = e_opt.unwrap(); }
        }
        raw {
            #ifdef __APPLE__
            extern bool darwin_set_login_item(bool enabled);
            result = darwin_set_login_item(enabled);
            #else
            extern bool windows_set_login_item(bool enabled);
            result = windows_set_login_item(enabled);
            #endif
        }
    } else {
        raw {
            #ifdef __APPLE__
            extern bool darwin_get_login_item(void);
            result = darwin_get_login_item();
            #else
            extern bool windows_get_login_item(void);
            result = windows_get_login_item();
            #endif
        }
    }

    if result { dispatch_invoke_response(window_id, request_id, true, "true"); }
    else      { dispatch_invoke_response(window_id, request_id, true, "false"); }
}

// --- Dialog handler ---

fn router_handle_dialog(method: string, payload: string, window_id: int, request_id: int) -> void {
    // Extract "a" (args) from the full message JSON
    let args_json: string = "";
    raw {
        #ifdef __APPLE__
        extern const char* darwin_dialog_extract_args(const char* full_json);
        args_json = (char*)darwin_dialog_extract_args((const char*)payload);
        #else
        extern const char* windows_dialog_extract_args(const char* full_json);
        args_json = (char*)windows_dialog_extract_args((const char*)payload);
        #endif
    }

    let result: string = "";
    let is_ios_async: bool = false;
    raw {
        const char* m = (const char*)method;
        #ifdef __APPLE__
        #include <TargetConditionals.h>
        if (strcmp(m, "__dialog:open") == 0) {
            #if TARGET_OS_IPHONE
            // iOS: UIDocumentPickerViewController is async-presentation
            // only. dialog_open_response_cb_zc extends the FS allowlist
            // with picked paths before resolving the invoke (matching
            // the macOS sync flow's router_grant_paths_from_dialog).
            typedef void (*zapp_ios_dialog_cb_t)(int32_t, int32_t, bool, const char*);
            extern void dialog_open_response_cb_zc(int wid, int rid, bool ok, char* json);
            extern void darwin_dialog_open_file_async(int32_t, int32_t, const char*, zapp_ios_dialog_cb_t);
            darwin_dialog_open_file_async(window_id, request_id, (const char*)args_json,
                (zapp_ios_dialog_cb_t)dialog_open_response_cb_zc);
            is_ios_async = true;
            #else
            result = (char*)darwin_dialog_open_file((const char*)args_json);
            #endif
        } else if (strcmp(m, "__dialog:save") == 0) {
            #if TARGET_OS_IPHONE
            typedef void (*zapp_ios_dialog_cb_t)(int32_t, int32_t, bool, const char*);
            extern void notif_response_cb(int32_t wid, int32_t rid, bool ok, const char* json);
            extern void darwin_dialog_save_file_async(int32_t, int32_t, const char*, zapp_ios_dialog_cb_t);
            darwin_dialog_save_file_async(window_id, request_id, (const char*)args_json, notif_response_cb);
            is_ios_async = true;
            #else
            result = (char*)darwin_dialog_save_file((const char*)args_json);
            #endif
        } else if (strcmp(m, "__dialog:message") == 0) {
            #if TARGET_OS_IPHONE
            // iOS: UIAlertController is async-only. Fire and let the
            // tap handler resolve the invoke promise via the same
            // callback shape notifications use.
            typedef void (*zapp_ios_dialog_cb_t)(int32_t, int32_t, bool, const char*);
            extern void notif_response_cb(int32_t wid, int32_t rid, bool ok, const char* json);
            extern void darwin_dialog_message_async(int32_t, int32_t, const char*, zapp_ios_dialog_cb_t);
            darwin_dialog_message_async(window_id, request_id, (const char*)args_json, notif_response_cb);
            is_ios_async = true;
            #else
            result = (char*)darwin_dialog_message((const char*)args_json);
            #endif
        }
        #else
        extern const char* windows_dialog_open_file(const char*);
        extern const char* windows_dialog_save_file(const char*);
        extern const char* windows_dialog_message(const char*);
        if (strcmp(m, "__dialog:open") == 0) {
            result = (char*)windows_dialog_open_file((const char*)args_json);
        } else if (strcmp(m, "__dialog:save") == 0) {
            result = (char*)windows_dialog_save_file((const char*)args_json);
        } else if (strcmp(m, "__dialog:message") == 0) {
            result = (char*)windows_dialog_message((const char*)args_json);
        }
        #endif
    }

    // iOS async path dispatches its own response via the tap handler.
    if is_ios_async { return; }

    // If the user picked files, extend the FS session allowlist with
    // each picked path. Lets apps read the file back via FS.readFile
    // without having to put the directory in zapp.config.ts.
    if method == "__dialog:open" && result != "" {
        router_grant_paths_from_dialog(result);
    }

    if result != "" {
        dispatch_invoke_response(window_id, request_id, true, result);
    } else {
        dispatch_invoke_response(window_id, request_id, false, "UNKNOWN_DIALOG");
    }
}

// Parse `{"cancelled":false,"paths":["…","…"]}` from an open-dialog result
// and grant each path. Tolerant: silently no-ops if cancelled or malformed.
fn router_grant_paths_from_dialog(result_json: string) -> void {
    raw {
        const char* s = (const char*)result_json;
        if (!s || !s[0]) return;
        if (strstr(s, "\"cancelled\":true") != NULL) return;
        const char* p = strstr(s, "\"paths\"");
        if (!p) return;
        p = strchr(p, '[');
        if (!p) return;
        p++;
        while (*p) {
            while (*p == ' ' || *p == ',' || *p == '\t' || *p == '\n') p++;
            if (*p == ']' || *p == '\0') break;
            if (*p != '"') break;
            p++;
            char grant[2048];
            size_t glen = 0;
            while (*p && *p != '"' && glen + 1 < sizeof(grant)) {
                if (*p == '\\' && p[1]) { grant[glen++] = p[1]; p += 2; }
                else grant[glen++] = *p++;
            }
            grant[glen] = '\0';
            if (*p == '"') p++;
            if (glen > 0) {
                fs_grant_path((const char*)grant);
            }
        }
    }
}

// --- Notification handler ---

fn router_handle_notification(method: string, payload: string, window_id: int, request_id: int) -> void {
    let args_json: string = "";
    raw {
        #ifdef __APPLE__
        extern const char* darwin_dialog_extract_args(const char* full_json);
        args_json = (char*)darwin_dialog_extract_args((const char*)payload);
        #else
        extern const char* windows_dialog_extract_args(const char* full_json);
        args_json = (char*)windows_dialog_extract_args((const char*)payload);
        #endif
    }

    raw {
        typedef void (*notif_callback_fn)(int32_t, int32_t, bool, const char*);
        extern void dispatch_invoke_response(int32_t window_id, int32_t request_id, bool ok, char* payload);
        extern void notif_response_cb(int32_t wid, int32_t rid, bool ok, const char* json);

        #ifdef __APPLE__
        extern void darwin_notification_request_permission(int32_t wid, int32_t rid, notif_callback_fn cb);
        extern const char* darwin_notification_get_permission(void);
        extern void darwin_notification_show(const char* opts, int32_t wid, int32_t rid, notif_callback_fn cb);
        extern void darwin_notification_schedule(const char* opts, int32_t wid, int32_t rid, notif_callback_fn cb);
        extern void darwin_notification_cancel(const char* id);
        extern void darwin_notification_cancel_all(void);
        #define notif_request_permission darwin_notification_request_permission
        #define notif_get_permission darwin_notification_get_permission
        #define notif_show darwin_notification_show
        #define notif_schedule darwin_notification_schedule
        #define notif_cancel darwin_notification_cancel
        #define notif_cancel_all darwin_notification_cancel_all
        #else
        extern void windows_notification_request_permission(int32_t wid, int32_t rid, notif_callback_fn cb);
        extern const char* windows_notification_get_permission(void);
        extern void windows_notification_show(const char* opts, int32_t wid, int32_t rid, notif_callback_fn cb);
        extern void windows_notification_schedule(const char* opts, int32_t wid, int32_t rid, notif_callback_fn cb);
        extern void windows_notification_cancel(const char* id);
        extern void windows_notification_cancel_all(void);
        #define notif_request_permission windows_notification_request_permission
        #define notif_get_permission windows_notification_get_permission
        #define notif_show windows_notification_show
        #define notif_schedule windows_notification_schedule
        #define notif_cancel windows_notification_cancel
        #define notif_cancel_all windows_notification_cancel_all
        #endif

        const char* m = (const char*)method;

        if (strcmp(m, "__notif:requestPermission") == 0) {
            notif_request_permission(window_id, request_id, notif_response_cb);
            return;
        } else if (strcmp(m, "__notif:getPermission") == 0) {
            const char* r = notif_get_permission();
            dispatch_invoke_response(window_id, request_id, true, (char*)r);
            return;
        } else if (strcmp(m, "__notif:show") == 0) {
            notif_show((const char*)args_json, window_id, request_id, notif_response_cb);
            return;
        } else if (strcmp(m, "__notif:schedule") == 0) {
            notif_schedule((const char*)args_json, window_id, request_id, notif_response_cb);
            return;
        } else if (strcmp(m, "__notif:cancel") == 0) {
            const char* a = (const char*)args_json;
            const char* p = strstr(a, "\"id\":\"");
            if (p) {
                p += 6;
                char id_buf[128];
                int i = 0;
                while (*p && *p != '"' && i < 127) id_buf[i++] = *p++;
                id_buf[i] = '\0';
                notif_cancel(id_buf);
            }
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:cancelAll") == 0) {
            notif_cancel_all();
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:registerCategory") == 0) {
            const char* a = (const char*)args_json;
            const char* p = strstr(a, "\"id\":\"");
            if (p) {
                p += 6;
                char cat_id[128];
                int i = 0;
                while (*p && *p != '"' && i < 127) cat_id[i++] = *p++;
                cat_id[i] = '\0';
                #ifdef __APPLE__
                extern void darwin_notification_register_category(const char*, const char*);
                darwin_notification_register_category(cat_id, (const char*)args_json);
                #else
                extern void windows_notification_register_category(const char*, const char*);
                windows_notification_register_category(cat_id, (const char*)args_json);
                #endif
            }
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:removeCategory") == 0) {
            const char* a = (const char*)args_json;
            const char* p = strstr(a, "\"id\":\"");
            if (p) {
                p += 6;
                char cat_id[128];
                int i = 0;
                while (*p && *p != '"' && i < 127) cat_id[i++] = *p++;
                cat_id[i] = '\0';
                #ifdef __APPLE__
                extern void darwin_notification_remove_category(const char*);
                darwin_notification_remove_category(cat_id);
                #else
                extern void windows_notification_remove_category(const char*);
                windows_notification_remove_category(cat_id);
                #endif
            }
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:removeDelivered") == 0) {
            #ifdef __APPLE__
            extern void darwin_notification_remove_delivered_json(const char* json);
            darwin_notification_remove_delivered_json((const char*)args_json);
            #endif
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:removeAllDelivered") == 0) {
            #ifdef __APPLE__
            extern void darwin_notification_remove_all_delivered(void);
            darwin_notification_remove_all_delivered();
            #endif
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        } else if (strcmp(m, "__notif:update") == 0) {
            #ifdef __APPLE__
            extern void darwin_notification_update_json(const char* json);
            darwin_notification_update_json((const char*)args_json);
            #endif
            dispatch_invoke_response(window_id, request_id, true, "{}");
            return;
        }

        dispatch_invoke_response(window_id, request_id, false, "UNKNOWN_NOTIFICATION");

        #undef notif_request_permission
        #undef notif_get_permission
        #undef notif_show
        #undef notif_schedule
        #undef notif_cancel
        #undef notif_cancel_all
    }
}

// Notification async callback — bridges to invoke response (must be at file scope)
raw {
    void notif_response_cb(int32_t wid, int32_t rid, bool ok, const char* json) {
        extern void dispatch_invoke_response(int32_t, int32_t, bool, char*);
        dispatch_invoke_response(wid, rid, ok, (char*)json);
    }

}

// iOS dialog-open variant — extends the FS allowlist with picked paths
// (mirroring the macOS sync call to router_grant_paths_from_dialog)
// before resolving the invoke promise. Other dialog paths
// (save / message) use notif_response_cb directly.
fn dialog_open_response_cb_zc(wid: int, rid: int, ok: bool, json: string) -> void {
    if json != "" {
        router_grant_paths_from_dialog(json);
    }
    raw {
        extern void dispatch_invoke_response(int32_t, int32_t, bool, char*);
        dispatch_invoke_response((int32_t)wid, (int32_t)rid, (bool)ok, (char*)json);
    }
}

// --- Shortcuts handler ---
//
// Webview path. Workers use the host fast path
// (`__zappBridge.shortcuts(action, args)`) and skip this entirely.
// register / unregister / isRegistered all return a boolean; the
// runtime promise resolves to that boolean. unregisterAll returns null.
fn router_handle_shortcuts(method: string, args: JsonValue*, has_args: bool, window_id: int, request_id: int) -> void {
    let result: string = "null";
    let did_handle: bool = false;

    if method == "__shortcuts:register" {
        if has_args {
            let acc_opt = args.get_string("accelerator");
            if acc_opt.is_some() {
                let ok = Shortcuts::register(acc_opt.unwrap());
                result = "false";
                if ok { result = "true"; }
                did_handle = true;
            }
        }
    } else if method == "__shortcuts:unregister" {
        if has_args {
            let acc_opt = args.get_string("accelerator");
            if acc_opt.is_some() {
                let ok = Shortcuts::unregister(acc_opt.unwrap());
                result = "false";
                if ok { result = "true"; }
                did_handle = true;
            }
        }
    } else if method == "__shortcuts:isRegistered" {
        if has_args {
            let acc_opt = args.get_string("accelerator");
            if acc_opt.is_some() {
                let ok = Shortcuts::is_registered(acc_opt.unwrap());
                result = "false";
                if ok { result = "true"; }
                did_handle = true;
            }
        }
    } else if method == "__shortcuts:unregisterAll" {
        Shortcuts::unregister_all();
        did_handle = true;
    }

    if !did_handle {
        dispatch_invoke_response(window_id, request_id, false, "UNKNOWN_SHORTCUT");
        return;
    }
    dispatch_invoke_response(window_id, request_id, true, result);
}

// --- Clipboard handler ---
//
// Webview path. The Clipboard Zen-C namespace is the canonical layer;
// JS calls land here and dispatch to it. Workers invoke the same
// Zen-C namespace directly via `__zappBridge.clipboard(action, args)`
// without crossing the IPC boundary.
fn router_handle_clipboard(method: string, args: JsonValue*, has_args: bool, window_id: int, request_id: int) -> void {
    let result: string = "";
    let is_string_result: bool = false;
    let did_handle: bool = false;

    if method == "__clipboard:readText" {
        result = Clipboard::read_text();
        is_string_result = true;
        did_handle = true;
    } else if method == "__clipboard:readHtml" {
        result = Clipboard::read_html();
        is_string_result = true;
        did_handle = true;
    } else if method == "__clipboard:readFiles" {
        // Already JSON-shaped — pass through verbatim.
        result = Clipboard::read_files();
        did_handle = true;
    } else if method == "__clipboard:has" {
        if has_args {
            let fmt_opt = args.get_string("format");
            if fmt_opt.is_some() {
                let ok = Clipboard::has(fmt_opt.unwrap());
                result = "false";
                if ok { result = "true"; }
                did_handle = true;
            }
        }
    } else if method == "__clipboard:writeText" {
        if has_args {
            let txt_opt = args.get_string("text");
            if txt_opt.is_some() {
                Clipboard::write_text(txt_opt.unwrap());
            }
        }
        result = "null";
        did_handle = true;
    } else if method == "__clipboard:writeHtml" {
        if has_args {
            let h_opt = args.get_string("html");
            if h_opt.is_some() {
                Clipboard::write_html(h_opt.unwrap());
            }
        }
        result = "null";
        did_handle = true;
    } else if method == "__clipboard:clear" {
        Clipboard::clear();
        result = "null";
        did_handle = true;
    } else if method == "__clipboard:readImagePng" {
        // Returns base64 PNG, or empty string when no image present.
        // Encoded server-side in clipboard.m so this raw block stays
        // free of Foundation imports.
        let b64: string = "";
        raw {
            #ifdef __APPLE__
            char* encoded = darwin_clipboard_read_image_png_b64();
            #else
            extern char* windows_clipboard_read_image_png_b64(void);
            char* encoded = windows_clipboard_read_image_png_b64();
            #endif
            if (encoded) {
                static char* cb_last_b64 = NULL;
                if (cb_last_b64) free(cb_last_b64);
                cb_last_b64 = encoded;
                b64 = encoded;
            }
        }
        // Already a string — fall through to the JSON-string-envelope path.
        result = b64;
        is_string_result = true;
        did_handle = true;
    } else if method == "__clipboard:writeImagePng" {
        if has_args {
            let b64_opt = args.get_string("data");
            if b64_opt.is_some() {
                let b64: string = b64_opt.unwrap();
                raw {
                    #ifdef __APPLE__
                    darwin_clipboard_write_image_png_b64((const char*)b64);
                    #else
                    extern bool windows_clipboard_write_image_png_b64(const char* b64);
                    windows_clipboard_write_image_png_b64((const char*)b64);
                    #endif
                }
            }
        }
        result = "null";
        did_handle = true;
    }

    if !did_handle {
        dispatch_invoke_response(window_id, request_id, false, "UNKNOWN_CLIPBOARD");
        return;
    }

    if is_string_result {
        // Wrap plain string in JSON string literal so JS-side JSON.parse
        // gives back a string. Empty string → `""`.
        raw {
            static char cb_str_envelope[8192];
            // Minimal escape: backslash and quote. clipboard text could
            // contain newlines / tabs which JSON allows literally inside
            // strings on most parsers, but escaping them is safer.
            const char* src = (const char*)result;
            size_t j = 0;
            cb_str_envelope[j++] = '"';
            for (size_t i = 0; src[i] && j + 2 < sizeof(cb_str_envelope) - 1; i++) {
                char c = src[i];
                if (c == '\\') { cb_str_envelope[j++] = '\\'; cb_str_envelope[j++] = '\\'; }
                else if (c == '"') { cb_str_envelope[j++] = '\\'; cb_str_envelope[j++] = '"'; }
                else if (c == '\n') { cb_str_envelope[j++] = '\\'; cb_str_envelope[j++] = 'n'; }
                else if (c == '\r') { cb_str_envelope[j++] = '\\'; cb_str_envelope[j++] = 'r'; }
                else if (c == '\t') { cb_str_envelope[j++] = '\\'; cb_str_envelope[j++] = 't'; }
                else { cb_str_envelope[j++] = c; }
            }
            cb_str_envelope[j++] = '"';
            cb_str_envelope[j] = '\0';
            result = cb_str_envelope;
        }
    }
    dispatch_invoke_response(window_id, request_id, true, result);
}
