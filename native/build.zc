// Zapp v2 — Build directives + entry point
// ObjC implementations compiled via cflags (separate .m files)

// --- Platform Tags ---
//> macos: define: apple
//> windows: define: windows

// --- macOS ---
//> macos: framework: Cocoa
//> macos: framework: WebKit
//> macos: framework: CoreFoundation
//> macos: framework: JavaScriptCore
//> macos: framework: Security
//> macos: link: -lcompression
//> macos: cflags: -fobjc-arc -x objective-c
//> macos: cflags: platform/darwin/platform.m platform/darwin/window.m platform/darwin/webview.m platform/darwin/panel.m platform/darwin/screen.m

// --- Windows ---
//> windows: cflags: -DUNICODE -D_UNICODE -DCINTERFACE -DCOBJMACROS
//> windows: cflags: platform/windows/platform.c platform/windows/window.c platform/windows/webview.c
//> windows: cflags: platform/windows/dialog.c platform/windows/menu.c platform/windows/notification.c platform/windows/sync.c
//> windows: cflags: platform/windows/clipboard.c platform/windows/screen.c
//> windows: cflags: -I../vendor/webview2/include
//> windows: link: -lole32 -lshell32 -luuid -luser32 -lgdi32 -lcomctl32 -lcomdlg32 -lshlwapi
//> windows: link: -lwinhttp -lbcrypt -ladvapi32 -lrpcrt4 -lcrypt32 -lversion
//> windows: link: -lwindowscodecs -lshcore

import "app/app.zc";

// Build config stubs (standalone — normally generated by CLI)
fn zapp_build_initial_url() -> string { return ""; }
fn zapp_build_asset_root() -> string { return ""; }
fn zapp_build_use_embedded_assets() -> int { return 0; }
fn zapp_build_csp() -> string { return ""; }
fn zapp_build_is_dev() -> int { return 1; }
// Webview-prefs stubs — all `-1` so the platform code keeps the
// WKWebView defaults when the framework is built standalone (no app
// pointing at it via zapp.config.ts).
fn zapp_build_webview_autoplay_without_user_gesture() -> int { return -1; }
fn zapp_build_webview_back_forward_gestures() -> int { return -1; }
fn zapp_build_webview_text_interaction_enabled() -> int { return -1; }
fn zapp_build_webview_minimum_font_size() -> int { return -1; }

// Bootstrap stub (standalone — normally generated by CLI via bootstrap/codegen.ts)
fn zapp_webview_bootstrap_script() -> string { return ""; }
fn zapp_worker_bootstrap_script() -> string { return ""; }

// --- Test entry point ---

fn greet_service(_app: App*, _args: JsonValue*) -> string {
    return "{\"greeting\":\"hello from native\"}";
}

fn on_ready(_id: int, _handle: void*) -> void {
    println "Window ready!";
}

fn main() -> int {
    let config = AppConfig{
        name: "Zapp v2 Test",
        applicationShouldTerminateAfterLastWindowClosed: true,
        webContentInspectable: Zapp::inspectable_on(),
        maxWorkers: 0,
        qjsStackSize: 0,
    };
    let app = App::new(config);

    // Register a test service
    app.service.add("greet", greet_service);

    let opts = WindowOptions::create("Zapp v2");
    opts.width = 900;
    opts.height = 650;
    let win = app.window.create(&opts);
    win.on_ready(on_ready);

    return app.run();
}
