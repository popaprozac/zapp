// Service registry and RPC invocation.
// Services are native functions registered by name, callable from JS.
// Optional lifecycle: startup() in registration order, shutdown() in reverse.
//
// Handler ABI: services receive the pre-parsed args sub-object as a
// JsonValue* (the "a" field of the bridge message). This eliminates the
// double-parse that the old (App*, string) ABI required when handlers wanted
// to extract typed fields. `args` may be NULL if the caller sent no args.

import "std/result.zc";
import "std/json.zc";
import "../bridge/json_safe.zc";
import "string.h" as str;

struct App;

// Service implementation — bundles handler + optional lifecycle hooks.
struct ServiceImpl {
    handler: fn*(App*, JsonValue*) -> string;
    startup: fn*(void*) -> void;
    shutdown: fn*(void*) -> void;
}

raw {
    #include <pthread.h>
    #define SERVICE_MAX_BINDINGS 64

    typedef struct {
        char* name;
        void* handler;
        void* service_ptr;
        void (*startup)(void*);
        void (*shutdown)(void*);
        // Present for stateful services registered via `register()`.
        // Locked around handler calls to serialize access to service_ptr.
        // Stateless services registered via `add()` leave this zero and skip
        // the lock entirely (matching the zero-state contract).
        int has_lock;
        pthread_mutex_t lock;
    } ZappServiceEntry;

    static ZappServiceEntry g_services[SERVICE_MAX_BINDINGS] = {{0}};
    static int g_service_count = 0;
}

struct ServiceManager {
    app: App*;
}

impl ServiceManager {
    fn new() -> Self {
        return ServiceManager{ app: NULL };
    }

    // Register a simple stateless service (no lifecycle, no state).
    fn add(self, name: string, handler: fn*(App*, JsonValue*) -> string) -> void {
        raw {
            if (g_service_count >= SERVICE_MAX_BINDINGS) return;
            g_services[g_service_count].name = (char*)name;
            g_services[g_service_count].handler = (void*)handler;
            g_services[g_service_count].service_ptr = NULL;
            g_services[g_service_count].startup = NULL;
            g_services[g_service_count].shutdown = NULL;
            g_service_count++;
        }
    }

    // Register a stateful service with implementation (handler + lifecycle).
    // The dispatcher automatically serializes handler calls with a mutex so
    // concurrent workers can't race on `service_ptr`'s state. Services that
    // want finer-grained concurrency should use `add()` instead and manage
    // their own locking.
    fn register(self, name: string, service_ptr: void*, impl_ptr: ServiceImpl*) -> void {
        let handler = impl_ptr.handler;
        let startup = impl_ptr.startup;
        let shutdown = impl_ptr.shutdown;
        raw {
            if (g_service_count >= SERVICE_MAX_BINDINGS) return;
            int i = g_service_count;
            g_services[i].name = (char*)name;
            g_services[i].handler = (void*)handler;
            g_services[i].service_ptr = service_ptr;
            g_services[i].startup = (void (*)(void*))startup;
            g_services[i].shutdown = (void (*)(void*))shutdown;
            pthread_mutex_init(&g_services[i].lock, NULL);
            g_services[i].has_lock = 1;
            g_service_count++;
        }
    }
}

// Run startup() for all services with lifecycle, in registration order.
fn service_run_startup_all() -> void {
    raw {
        for (int i = 0; i < g_service_count; i++) {
            if (g_services[i].startup != NULL) {
                g_services[i].startup(g_services[i].service_ptr);
            }
        }
    }
}

// Run shutdown() for all services with lifecycle, in REVERSE registration order.
fn service_run_shutdown_all() -> void {
    raw {
        for (int i = g_service_count - 1; i >= 0; i--) {
            if (g_services[i].shutdown != NULL) {
                g_services[i].shutdown(g_services[i].service_ptr);
            }
        }
    }
}

// Webview path: caller already has parsed.args as a JsonValue* — pass it
// directly, no re-parse.
fn service_invoke(app: App*, method: string, args: JsonValue*) -> Result<string> {
    let idx: int = -1;
    raw {
        for (int i = 0; i < g_service_count; i++) {
            if (g_services[i].name && strcmp(g_services[i].name, (const char*)method) == 0) {
                idx = i;
                break;
            }
        }
    }

    if idx < 0 {
        return Result<string>::Err("NOT_FOUND");
    }

    let result: string = "";
    raw {
        typedef char* (*ServiceFnPtr)(void*, JsonValue*);
        ServiceFnPtr fn_ptr = (ServiceFnPtr)g_services[idx].handler;
        if (g_services[idx].has_lock) {
            // Stateful service — serialize handler calls so concurrent
            // workers don't race on the shared state in service_ptr.
            pthread_mutex_lock(&g_services[idx].lock);
            result = fn_ptr((void*)app, args);
            pthread_mutex_unlock(&g_services[idx].lock);
        } else {
            // Stateless service — no shared state, no lock overhead.
            result = fn_ptr((void*)app, args);
        }
    }

    return Result<string>::Ok(result);
}

// Worker zero-JSON path: caller already built a JsonValue* via a JS-engine
// walker (no JSON serialization). Just looks up the service and calls the
// handler directly. The caller owns `args` and is responsible for freeing it.
fn service_invoke_native(app_ptr: void*, method: string, args: JsonValue*) -> string {
    let app = (App*)app_ptr;
    if app == NULL { return ""; }
    let result = service_invoke(app, method, args);
    if result.is_ok() { return result.unwrap(); }
    return "";
}

// Worker JSON-string path: callers (jsc.m) hand us a JSON string. We parse it
// once here so handlers always see a JsonValue*. This gives the worker path
// one parse total (vs. the previous path where handlers had to re-parse).
fn service_invoke_sync(app_ptr: void*, method: string, args_json: string) -> string {
    let app = (App*)app_ptr;
    if app == NULL { return ""; }

    // Empty/null args → call with NULL JsonValue*
    let is_empty: bool = false;
    raw {
        is_empty = (!args_json || args_json[0] == '\0' ||
                    (args_json[0] == '{' && args_json[1] == '}' && args_json[2] == '\0'));
    }

    if is_empty {
        let result = service_invoke(app, method, (JsonValue*)NULL);
        if result.is_ok() { return result.unwrap(); }
        return "";
    }

    // zapp_json_parse — heap-allocating, handles large string tokens
    // (avatar data URLs, file contents, etc.) without the SIGABRT the
    // stdlib parser triggers on inputs > 4096 chars per string token.
    let parse_result = zapp_json_parse(args_json);
    if parse_result.is_err() {
        let result = service_invoke(app, method, (JsonValue*)NULL);
        if result.is_ok() { return result.unwrap(); }
        return "";
    }
    let parsed = parse_result.unwrap();
    let result = service_invoke(app, method, parsed);
    // NOTE: we leak `parsed` here. The result string returned from the
    // handler often points into it (e.g. greet returns args echoed). Freeing
    // would dangle. Worker call rate is low and this is a per-call leak we
    // accept for now — task 17 (zero-JSON path) will eliminate the parse
    // entirely.
    if result.is_ok() { return result.unwrap(); }
    return "";
}

// Get bindings manifest as JSON (for bootstrap injection).
fn service_get_manifest_json() -> string {
    raw {
        static char manifest[4096];
        int pos = 0;
        pos += snprintf(manifest + pos, sizeof(manifest) - pos, "{\"v\":1,\"services\":[");
        for (int i = 0; i < g_service_count; i++) {
            if (i > 0) pos += snprintf(manifest + pos, sizeof(manifest) - pos, ",");
            pos += snprintf(manifest + pos, sizeof(manifest) - pos,
                "{\"name\":\"%s\"}", g_services[i].name);
        }
        pos += snprintf(manifest + pos, sizeof(manifest) - pos, "]}");
        return manifest;
    }
    return "";
}
