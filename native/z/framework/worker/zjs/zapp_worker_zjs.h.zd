declare module "zapp_worker_zjs.h" {
  export function zapp_zjs_engine_create(): _ | null {
    deinit zapp_zjs_engine_destroy;
  }
  export function zapp_zjs_engine_evaluate_module(
    in engine: _,
    in source: _,
    in module_name: _
  ): _;
  export function zapp_zjs_engine_dispatch(
    in engine: _,
    in channel: _,
    in payload: _
  ): _;
  export function zapp_zjs_engine_has_pending_work(in engine: _): _;
  export function zapp_zjs_engine_next_wake_milliseconds(in engine: _): _;
  export function zapp_zjs_engine_pump(in engine: _): _;
  export function zapp_zjs_engine_result(in engine: _): _;
  export function zapp_zjs_engine_response_channel(
    in engine: _
  ): view cstring | null {
    borrowed from engine;
  }
  export function zapp_zjs_engine_response_payload(
    in engine: _
  ): view cstring | null {
    borrowed from engine;
  }
  export function zapp_zjs_engine_error(
    in engine: _
  ): view cstring | null {
    borrowed from engine;
  }
  export function zapp_zjs_engine_destroy(move engine: _): _;
  export function zapp_zjs_worker_start(
    in source: _,
    in worker_id: _,
    in module_name: _,
    move message: _,
    context: _,
    release: _,
    move service: _,
    service_context: _,
    service_release: _,
    move service_cancel: _,
    service_cancel_context: _,
    service_cancel_release: _
  ): _ {
    callback message {
      context context;
      deinit release;
      thread any;
      invoked repeatedly;
    }
    callback service {
      context service_context;
      deinit service_release;
      thread any;
      invoked repeatedly;
    }
    callback service_cancel {
      context service_cancel_context;
      deinit service_cancel_release;
      thread any;
      invoked repeatedly;
    }
  }
  export function zapp_zjs_worker_service_respond(ok: _, in payload: _): _;
  export function zapp_zjs_worker_service_defer(): _;
  export function zapp_zjs_worker_service_complete(
    identity: _,
    request_id: _,
    ok: _,
    in payload: _
  ): _;
  export function zapp_zjs_worker_cancel(identity: _): _;
  export function zapp_zjs_worker_dispatch(
    identity: _,
    in channel: _,
    in payload: _
  ): _;
  export function zapp_zjs_worker_join(identity: _): _;
  export function zapp_zjs_worker_destroy(identity: _): _;
