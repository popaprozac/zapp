{
  "package": {
    "name": "zapp",
    "version": "0.1.0-dev"
  },
  "library": {
    "entry": "api/zapp.zs",
    "exports": {
      "./window": "api/zapp/window.zs",
      "./dialog": "api/zapp/dialog.zs",
      "./clipboard": "api/zapp/clipboard.zs",
      "./notifications": "api/zapp/notifications.zs",
      "./shell": "api/zapp/shell.zs",
      "./menu": "api/zapp/menu.zs",
      "./service": "api/zapp/service.zs",
      "./worker": "framework/worker/worker-manager.zs"
    },
    "native": {
      "includeDirectories": [
        "framework/bridge",
        "framework/worker",
        "framework/worker/zjs",
        "framework/platform/macos"
      ],
      "link": {
        "frameworks": [
          "AppKit",
          "WebKit",
          "CoreFoundation",
          "UniformTypeIdentifiers",
          "UserNotifications"
        ]
      }
    }
  }
}
