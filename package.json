{
  "name": "zapp-monorepo",
  "private": true,
  "scripts": {
    "test": "bun test ./cli/src/*.test.ts ./runtime/*.test.ts",
    "test:native": "bun run cli/src/test-native.ts",
    "test:all": "bun run test && bun run test:native",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "5.7.2"
  }
}
