{
  "name": "zapp-monorepo",
  "private": true,
  "workspaces": [
    "cli",
    "runtime",
    "vite"
  ],
  "scripts": {
    "test": "bun test ./cli/src/*.test.ts ./runtime/*.test.ts",
    "test:native": "bun run cli/src/test-native.ts",
    "test:all": "bun run test && bun run test:native && bun run check",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.typetest.json",
    "spike:z-bridge": "bun run spikes/z-notes/bridge.ts",
    "spike:z-notes": "bun run spikes/z-notes/run.ts",
    "spike:z-notes:smoke": "bun run spikes/z-notes/run.ts --smoke",
    "spike:z-notes:dev": "bun run spikes/z-notes/dev.ts",
    "spike:z-notes:dev-smoke": "bun run spikes/z-notes/dev.ts --smoke",
    "spike:z-webview": "bun run spikes/z-notes/run.ts",
    "spike:z-webview:sanitize": "bun run spikes/z-notes/sanitize.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^25.9.1",
    "typescript": "5.7.2"
  }
}
