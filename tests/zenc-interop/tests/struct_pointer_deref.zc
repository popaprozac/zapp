// Test: Auto-dereference on struct pointers
// Zen-C: ptr.field auto-derefs (no -> needed)
// Raw blocks: must use ptr->field (C syntax)

raw {
    typedef struct Point {
        int32_t x;
        int32_t y;
    } Point;
}

fn sum(p: Point*) -> int {
    // Auto-deref: p.x instead of p->x
    return p.x + p.y;
}

fn mutate(p: Point*) -> void {
    // Can we assign through auto-deref?
    raw {
        p->x = 100;
        p->y = 200;
    }
}

fn main() -> int {
    raw {
        Point pt = {10, 20};
        int s = sum(&pt);
        if (s != 30) return 1;

        mutate(&pt);
        if (pt.x != 100) return 2;
        if (pt.y != 200) return 3;
    }

    return 0;
}
