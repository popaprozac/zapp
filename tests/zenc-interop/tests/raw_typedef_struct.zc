// Test: Raw typedef struct pattern
// When raw blocks need to stack-allocate a struct, it must be defined
// in a raw block (not as a Zen-C struct) so the complete type is available.

raw {
    #ifndef EVENT_DATA_DEFINED
    #define EVENT_DATA_DEFINED
    typedef struct EventData {
        int32_t code;
        int32_t x;
        int32_t y;
    } EventData;
    #endif
}

// Zen-C function can accept raw-defined struct as parameter
fn process(data: EventData*) -> int {
    return data.code + data.x + data.y;
}

fn main() -> int {
    // Raw block CAN stack-allocate because it's defined in a raw block
    raw {
        EventData data = {0};
        data.code = 1;
        data.x = 10;
        data.y = 20;

        int result = process(&data);
        if (result != 31) return 1;
    }

    return 0;
}
