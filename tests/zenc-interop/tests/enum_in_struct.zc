// Test: Enum field in a struct, accessed from both Zen-C and raw blocks

enum Priority {
    Low,
    Medium,
    High,
}

struct Task {
    name: string;
    priority: Priority;
}

fn is_high(t: Task*) -> bool {
    match t.priority {
        Priority::High => { return true; },
        Priority::Medium => { return false; },
        Priority::Low => { return false; },
    }
    return false;
}

fn main() -> int {
    let t = Task{ name: "test", priority: Priority::High() };

    // Zen-C access with auto-deref
    if !is_high(&t) {
        return 1;
    }

    // Raw block access
    raw {
        if (t.priority.tag != Priority_High_Tag) return 2;
    }

    return 0;
}
