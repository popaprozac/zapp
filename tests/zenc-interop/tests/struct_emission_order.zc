// Test: Zen-C struct definitions are emitted LATE in generated C
// Forward declarations come early, but struct bodies come after raw blocks.
// This means raw blocks can use Zen-C structs through pointers (forward decl ok)
// but CANNOT stack-allocate them (incomplete type).

struct MyData {
    value: int;
    name: string;
}

fn create_data() -> MyData {
    return MyData{ value: 42, name: "hello" };
}

fn read_data(d: MyData*) -> int {
    return d.value;
}

fn main() -> int {
    let d = create_data();

    // Access through pointer in raw block — works because forward decl is sufficient
    raw {
        int val = read_data(&d);
        if (val != 42) return 1;
    }

    // NOTE: The following would FAIL to compile:
    //   raw { MyData local = {0}; }  // Error: incomplete type
    // Because the struct body is emitted after this raw block in generated C.

    return 0;
}
