// Test: Function pointers in Zen-C
// Syntax: fn*(ArgType) -> RetType

raw {
    typedef struct Data {
        int32_t value;
    } Data;
}

fn double_it(d: Data*) -> int {
    return d.value * 2;
}

fn triple_it(d: Data*) -> int {
    return d.value * 3;
}

fn apply(d: Data*, f: fn*(Data*) -> int) -> int {
    return f(d);
}

fn main() -> int {
    raw {
        Data d = {10};

        int r1 = apply(&d, double_it);
        if (r1 != 20) return 1;

        int r2 = apply(&d, triple_it);
        if (r2 != 30) return 2;
    }
    return 0;
}
