// Test: Accessing enum values from raw blocks
// Enums compile to: struct { Tag tag; union {} data; }
// Raw blocks use .tag field and *_Tag C enum constants.

enum Direction {
    Up,
    Down,
    Left,
    Right,
}

struct Config {
    dir: Direction;
}

fn main() -> int {
    let cfg = Config{ dir: Direction::Right() };

    raw {
        // Access via .tag and C-generated tag constants
        if (cfg.dir.tag != Direction_Right_Tag) return 1;

        // Construct in raw block — need to call constructor function
        Direction up = Direction_Up();
        if (up.tag != Direction_Up_Tag) return 2;

        // Compare tags
        if (Direction_Left_Tag == Direction_Right_Tag) return 3;
    }

    return 0;
}
