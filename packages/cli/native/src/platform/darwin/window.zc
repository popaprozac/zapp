    raw {
#ifdef __APPLE__
        @autoreleasepool {
            void (^work)(void) = ^{
                NSWindow* nsWindow = (__bridge NSWindow*)window;
                if (nsWindow) {
                    [nsWindow deminiaturize:nil];
                }
            };
            if ([NSThread isMainThread]) {
                work();
            } else {
                dispatch_sync(dispatch_get_main_queue(), work);
