+/* Embedder helper: assign the libwebsockets cookie jar path on a runtime
+ * that wasn't initialized via the standard CLI bootstrap. tjs__lws_init
+ * asserts this is non-NULL on first WebSocket use, so embedders that use
+ * TJS_NewRuntimeWorker() (or TJS_NewRuntime() without running tjs.bootstrap)
+ * must call this once before any WebSocket constructor runs. */
+void TJS_SetCookieJarPath(TJSRuntime *qrt, const char *path) {
+    if (!qrt || !path) return;
+    if (qrt->lws.cookie_jar_path) return;  /* idempotent — first wins */
+    qrt->lws.cookie_jar_path = strdup(path);
+}
