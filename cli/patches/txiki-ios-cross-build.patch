diff --git a/CMakeLists.txt b/CMakeLists.txt
index 86e9502..9825e16 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -53,6 +53,13 @@ endmacro()

 xoption(BUILD_WITH_MIMALLOC "If ON (default), build with mimalloc" ON)
 xoption(BUILD_WITH_ASAN "Build with AddressSanitizer" OFF)
+# BUILD_WITH_FFI gates mod_ffi.c + libffi link. Must be OFF for iOS App
+# Store builds — Apple bans dlopen of arbitrary dylibs. Default ON to
+# preserve the existing macOS / Linux / Windows behavior.
+xoption(BUILD_WITH_FFI "If ON (default), build with FFI module (libffi). Must be OFF for iOS." ON)
+if(NOT BUILD_WITH_FFI)
+    add_compile_definitions(TJS_NO_FFI)
+endif()

 if(BUILD_WITH_ASAN)
     message(STATUS "AddressSanitizer enabled")
@@ -93,7 +100,6 @@ add_library(tjs STATIC
     src/httpserver.c
     src/mod_dns.c
     src/mod_engine.c
-    src/mod_ffi.c
     src/mod_fs.c
     src/mod_fswatch.c
     src/mod_hashing.c
@@ -115,8 +121,15 @@ add_library(tjs STATIC
     src/bundles/c/core/worker-bootstrap.c
 )

-if(UNIX)
+if(UNIX AND NOT IOS)
+    # mod_posix-socket pulls in libproc.h which is macOS-only — iOS SDK
+    # ships no libproc. Module is non-essential socket introspection,
+    # safe to omit on iOS.
     target_sources(tjs PUBLIC src/mod_posix-socket.c)
+else()
+    # vm.c calls tjs__mod_posix_socket_init unconditionally on UNIX —
+    # gate it via TJS_NO_POSIX_SOCKET when the source is excluded.
+    add_compile_definitions(TJS_NO_POSIX_SOCKET)
 endif()

 set_target_properties(tjs PROPERTIES
@@ -133,6 +146,10 @@ if(WIN32)
     target_compile_definitions(tjs PRIVATE WIN32_LEAN_AND_MEAN)
 endif()

+if(BUILD_WITH_FFI)
+    target_sources(tjs PRIVATE src/mod_ffi.c)
+endif()
+
 target_include_directories(tjs PUBLIC src)

 add_executable(tjs-cli
@@ -185,22 +202,28 @@ add_library(sqlite-test SHARED
 )
 target_link_libraries(sqlite-test sqlite3)

-if (WIN32)
-    find_package(unofficial-libffi CONFIG REQUIRED)
-    target_link_libraries(tjs PUBLIC unofficial::libffi::libffi)
-else()
-    find_library(FFI_LIB NAMES libffi ffi REQUIRED)
-    find_path(FFI_INCLUDE_DIR NAMES ffi.h PATH_SUFFIXES ffi REQUIRED)
-    target_include_directories(tjs PRIVATE ${FFI_INCLUDE_DIR})
-    target_link_libraries(tjs PUBLIC ${FFI_LIB})
-endif()
+if(BUILD_WITH_FFI)
+    if (WIN32)
+        find_package(unofficial-libffi CONFIG REQUIRED)
+        target_link_libraries(tjs PUBLIC unofficial::libffi::libffi)
+    else()
+        find_library(FFI_LIB NAMES libffi ffi REQUIRED)
+        find_path(FFI_INCLUDE_DIR NAMES ffi.h PATH_SUFFIXES ffi REQUIRED)
+        target_include_directories(tjs PRIVATE ${FFI_INCLUDE_DIR})
+        target_link_libraries(tjs PUBLIC ${FFI_LIB})
+    endif()

-add_library(ffi-test SHARED
-    tests/fixtures/ffi-test-lib.c
-)
+    add_library(ffi-test SHARED
+        tests/fixtures/ffi-test-lib.c
+    )
+endif()

 # Set consistent output for test libraries across all platforms (including MSVC multi-config)
-set_target_properties(ffi-test sqlite-test PROPERTIES
+set(_zapp_test_libs sqlite-test)
+if(BUILD_WITH_FFI)
+    list(APPEND _zapp_test_libs ffi-test)
+endif()
+set_target_properties(${_zapp_test_libs} PROPERTIES
     PREFIX "lib"
     RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}"
     LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}"
