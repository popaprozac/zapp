{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z Notes Benchmark Tauri",
  "version": "0.1.0",
  "identifier": "com.zapp.benchmark.z-notes-tauri",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Z Notes Benchmark",
        "width": 860,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
