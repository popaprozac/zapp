import "app/app.zc";
import "std/time.zc";

// Minimal ping service: returns {"pong": <timestamp_ms>}.
// Used by the benchmark bridge-perf test.
fn ping(_app: App*, _args: JsonValue*) -> string {
    let ms = Time::now();
    raw {
        static _Thread_local char buf[64];
        snprintf(buf, sizeof(buf), "{\"pong\":%llu}", (unsigned long long)ms);
        return buf;
    }
    return "";
}

fn on_ready(_id: int, _handle: void*) -> void {
    Window{id: _id, handle: _handle}.show();
}

fn run_app() -> int {
    let config = AppConfig{
        name: "bench-zapp-jsc",
        applicationShouldTerminateAfterLastWindowClosed: true,
        // Always inspectable — bench apps need devtools even in release
        // so bridge-bench.js can be pasted (same reason Wails benches
        // with DEV=true). This is bench scaffolding, not a real app.
        webContentInspectable: Zapp::inspectable_on(),
        maxWorkers: 0,
        qjsStackSize: 0,
    };
    let app = App::new(config);
    app.service.add("ping", ping);

    let opts = WindowOptions::create("Hello Zapp (JSC)");
    opts.width = 400;
    opts.height = 300;
    opts.visible = false;
    let win = app.window.create(&opts);
    win.on_ready(on_ready);

    return app.run();
}
