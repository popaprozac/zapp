// Build directives — host-bridge benchmark app. Enables bare-jsc by
// default for macOS benchmarks. To compare additional engines, add the
// corresponding define here AND a worker entry in zapp.config.ts.

//> macos: define: apple
//> macos: define: ZAPP_WORKER_ENGINE_BARE_JSC

//> macos: framework: Cocoa
//> macos: framework: WebKit
//> macos: framework: CoreFoundation
//> macos: framework: JavaScriptCore
//> macos: framework: Security
//> macos: framework: UserNotifications
//> macos: link: -lcompression
//> macos: cflags: -fobjc-arc

import "app.zc";

fn main() -> int {
    return run_app();
}
