static inline JSValue JS_NewInt64(JSContext *ctx, int64_t val)
{
    JSValue v;
    if (val >= 
# 743 "../../vendor/quickjs-ng/quickjs.h" 3 4
              (-2147483647 - 1) 
# 743 "../../vendor/quickjs-ng/quickjs.h"
                        && val <= 
# 743 "../../vendor/quickjs-ng/quickjs.h" 3 4
                                  2147483647
# 743 "../../vendor/quickjs-ng/quickjs.h"
                                           ) {
        v = JS_NewInt32(ctx, (int32_t)val);
    } else {
        v = JS_NewFloat64(ctx, (double)val);
    }
    return v;
}

static inline JSValue JS_NewUint32(JSContext *ctx, uint32_t val)
{
    JSValue v;
    if (val <= 
# 754 "../../vendor/quickjs-ng/quickjs.h" 3 4
              2147483647
# 754 "../../vendor/quickjs-ng/quickjs.h"
                       ) {
        v = JS_NewInt32(ctx, (int32_t)val);
    } else {
        v = JS_NewFloat64(ctx, (double)val);
    }
    return v;
}

