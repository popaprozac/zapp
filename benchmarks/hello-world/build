        JS_FreeValue(ctx, jsonStrVal);
        JS_FreeValue(ctx, stringify);
        JS_FreeValue(ctx, JSON);
        JS_FreeValue(ctx, global);
        JS_FreeCString(ctx, name);
        return (JSValue){ (JSValueUnion){ .int32 = 0 }, JS_TAG_UNDEFINED };
    }

