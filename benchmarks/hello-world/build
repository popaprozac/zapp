  extern __inline__ __attribute__((__always_inline__,__gnu_inline__)) WINBOOL IDListContainerIsConsistent(LPCITEMIDLIST p, UINT sz) {
    UINT c = sizeof (p->mkid.cb);

    while (c <= sz && p->mkid.cb >= sizeof (p->mkid.cb) && p->mkid.cb <= (sz - c)) {
      c += p->mkid.cb;
      p = ((LPITEMIDLIST)((void *) (((BYTE *) ((p)))+ (((p)->mkid.cb)))));
    }
    return c <= sz && p->mkid.cb == 0;
  }

