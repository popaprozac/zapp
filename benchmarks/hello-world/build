bool service_is_valid_name(string name)
{
    {
# 23 "C:/Users/Zach/code/zapp/src/service/service.zc"
if ((strcmp(name, "") == 0)) {
# 24 "C:/Users/Zach/code/zapp/src/service/service.zc"
    return false;
    }
# 26 "C:/Users/Zach/code/zapp/src/service/service.zc"

        const char* s = (const char*)name;
        int len = 0;
        while (*s != '\0') {
            char ch = *s;
            int ok =
                (ch >= 'a' && ch <= 'z') ||
                (ch >= 'A' && ch <= 'Z') ||
                (ch >= '0' && ch <= '9') ||
                ch == '.' || ch == '_' || ch == '-';
            if (!ok) return false;
            len++;
            if (len > SERVICE_MAX_NAME) return false;
            s++;
        }
        return len > 0;

    }
}
