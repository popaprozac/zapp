        JSValue global = JS_GetGlobalObject(ctx);
        JSValue JSON = JS_GetPropertyStr(ctx, global, "JSON");
        JSValue stringify = JS_GetPropertyStr(ctx, JSON, "stringify");
        JSValue jsonStrVal = JS_Call(ctx, stringify, JSON, 1, &argv[1]);
