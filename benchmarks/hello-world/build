        return default_val;
    }

    char* zapp_json_get_raw(const char* json, const char* key) {
        if (!json || !key) return 
# 8964 "build.c" 3 4
                                 ((void *)0)
# 8964 "build.c"
                                     ;
        char pattern[256];
        snprintf(pattern, sizeof(pattern), "\"%s\":", key);
        const char* start = strstr(json, pattern);
        if (!start) return 
# 8968 "build.c" 3 4
                          ((void *)0)
# 8968 "build.c"
                              ;
        start += strlen(pattern);
        while (*start == ' ') start++;

        if (*start == '"') {
            const char* end = start + 1;
            while (*end && *end != '"') {
                if (*end == '\\' && *(end + 1)) end++;
                end++;
            }
            if (*end == '"') end++;
            size_t len = (size_t)(end - start);
            char* result = (char*)malloc(len + 1);
            memcpy(result, start, len);
            result[len] = '\0';
            return result;
        }

        if (*start == '{' || *start == '[') {
            int depth = 0;
            const char* end = start;
            char open = *start;
            char close = (open == '{') ? '}' : ']';
            while (*end) {
                if (*end == open) depth++;
                else if (*end == close) { depth--; if (depth == 0) { end++; break; } }
                else if (*end == '"') {
                    end++;
                    while (*end && *end != '"') {
                        if (*end == '\\' && *(end + 1)) end++;
                        end++;
                    }
                }
                end++;
            }
            size_t len = (size_t)(end - start);
            char* result = (char*)malloc(len + 1);
            memcpy(result, start, len);
            result[len] = '\0';
            return result;
        }

        const char* end = start;
        while (*end && *end != ',' && *end != '}' && *end != ']') end++;
        size_t len = (size_t)(end - start);
        char* result = (char*)malloc(len + 1);
        memcpy(result, start, len);
        result[len] = '\0';
        return result;
    }





