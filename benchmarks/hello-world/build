    static const char* zapp_get_window_event_name_win(int event_id) {
        switch (event_id) {
            case 0: return "ready";
            case 1: return "focus";
            case 2: return "blur";
            case 3: return "resize";
            case 4: return "move";
            case 5: return "close";
            case 6: return "minimize";
            case 7: return "maximize";
            case 8: return "restore";
            case 9: return "fullscreen";
            case 10: return "unfullscreen";
            default: return "unknown";
        }
    }

