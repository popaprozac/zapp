    static wchar_t* zapp_build_filter_string(const char* json) {

        char* filtersRaw = zapp_json_get_raw(json, "filters");
        if (!filtersRaw || filtersRaw[0] != '[') { free(filtersRaw); return 
# 2190 "build.c" 3 4
                                                                           ((void *)0)
# 2190 "build.c"
                                                                               ; }



        static wchar_t buf[4096];
        int pos = 0;
        memset(buf, 0, sizeof(buf));

        const char* p = filtersRaw + 1;
        while (*p) {

            while (*p && *p != '{') p++;
            if (!*p) break;


            const char* nameKey = strstr(p, "\"name\"");
            char name[256] = "Files";
            if (nameKey) {
                nameKey = strchr(nameKey + 6, '"');
                if (nameKey) {
                    nameKey++;
                    int ni = 0;
                    while (*nameKey && *nameKey != '"' && ni < 255) name[ni++] = *nameKey++;
                    name[ni] = '\0';
                }
            }


            const char* extKey = strstr(p, "\"extensions\"");
            char extBuf[1024] = "";
            int extPos = 0;
            if (extKey) {
                const char* arrStart = strchr(extKey + 12, '[');
                if (arrStart) {
                    arrStart++;
                    while (*arrStart && *arrStart != ']') {
                        if (*arrStart == '"') {
                            arrStart++;
                            if (extPos > 0 && extPos < 1020) extBuf[extPos++] = ';';
                            extBuf[extPos++] = '*';
                            extBuf[extPos++] = '.';
                            while (*arrStart && *arrStart != '"' && extPos < 1020)
                                extBuf[extPos++] = *arrStart++;
                            if (*arrStart == '"') arrStart++;
                        } else {
                            arrStart++;
                        }
                    }
                }
            }
            extBuf[extPos] = '\0';

            if (extPos > 0) {

                int nLen = MultiByteToWideChar(
# 2244 "build.c" 3
                                              65001
# 2244 "build.c"
                                                     , 0, name, -1, buf + pos, 4096 - pos);
                pos += nLen;

                int eLen = MultiByteToWideChar(
# 2247 "build.c" 3
                                              65001
# 2247 "build.c"
                                                     , 0, extBuf, -1, buf + pos, 4096 - pos);
                pos += eLen;
            }


            int depth = 1;
            p++;
            while (*p && depth > 0) {
                if (*p == '{') depth++;
                else if (*p == '}') depth--;
                p++;
            }
        }

        free(filtersRaw);
        if (pos == 0) return 
# 2262 "build.c" 3 4
                            ((void *)0)
# 2262 "build.c"
                                ;
        buf[pos] = L'\0';
        return buf;
    }

