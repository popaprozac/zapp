// Build directives — platform tags and framework linking.
// .m file compilation is handled by the zapp CLI.

//> macos: define: apple
//> windows: define: windows
// Enable zjs (first-party engine — smallest binary, correct microtask
// semantics out of the box). To also enable a bare-* engine for workers
// that need bare-fetch / bare-tls etc., add the corresponding define:
//   ZAPP_WORKER_ENGINE_BARE_JSC (macOS/iOS default)
//   ZAPP_WORKER_ENGINE_BARE_V8  (Windows/Linux JIT opt-in)
//   ZAPP_WORKER_ENGINE_BARE_HERMES (AOT bytecode, iOS perf)
//> macos: define: ZAPP_WORKER_ENGINE_ZJS
// //> macos: define: ZAPP_WORKER_ENGINE_BARE_JSC
// //> macos: define: ZAPP_WORKER_ENGINE_BARE_HERMES

//> macos: framework: Cocoa
//> macos: framework: WebKit
//> macos: framework: CoreFoundation
//> macos: framework: JavaScriptCore
//> macos: framework: Security
//> macos: framework: UserNotifications
//> macos: link: -lcompression
//> macos: cflags: -fobjc-arc

//> windows: cflags: -DUNICODE -D_UNICODE -DCINTERFACE -DCOBJMACROS
// Windows platform .c files added by CLI via zapp_platform.zc
//> windows: link: -lole32 -lshell32 -luuid -luser32 -lgdi32 -lcomctl32 -lcomdlg32 -lshlwapi
//> windows: link: -lwinhttp -lbcrypt -ladvapi32 -lrpcrt4 -lcrypt32 -lversion

import "app.zc";

fn main() -> int {
    return run_app();
}
