// App entry point. Platform glue (frameworks, link flags, ObjC ARC,
// worker-engine wiring) is generated by the Zapp CLI into
// `.zapp/zapp_platform.zc` and `.zapp/zapp_engine_overlay.zc`, derived
// from `zapp.config.ts`. To link extra native things, use the
// `native: { frameworks, linkFlags, sources }` block in `zapp.config.ts`.
// (Power users can still drop raw `//>` directives here as an escape hatch.)

import "app.zc";

fn main() -> int {
    return run_app();
}
