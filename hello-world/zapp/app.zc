import "app/app.zc";

// @zapp:returns { greeting: string }
fn greet(_app: App*, args: JsonValue*) -> string {
    log("service: greet called");
    // Pre-parsed args — extract typed fields directly, no JSON parse needed.
    let name: string = "stranger";
    if args != NULL {
        let name_opt = args.get_string("name");
        if name_opt.is_some() { name = name_opt.unwrap(); }
    }
    raw {
        // Thread-local buffer: workers call this concurrently; a plain static
        // would race. _Thread_local gives each thread its own slot.
        static _Thread_local char buf[256];
        snprintf(buf, sizeof(buf), "{\"greeting\":\"hello, %s\"}", (const char*)name);
        return buf;
    }
    return "";
}

// noop — minimal-work service used by bench.ts to measure pure
// invokeService round-trip latency (worker → router → service → worker).
// Returns a constant JSON string; no logging, no arg parsing. Don't
// remove unless you also remove the bench harness in src/workers/bench.ts.
fn noop(_app: App*, _args: JsonValue*) -> string {
    return "{\"ok\":1}";
}

fn on_ready(_id: int, _handle: void*) -> void {
    log("window ready, showing");
    Window{id: _id, handle: _handle}.show();
}

// --- Native app-level event handlers ---

fn on_notification_click(_event: int, _data: string) -> void {
    logv("app event: notification clicked");
}

fn on_notification_action(_event: int, _data: string) -> void {
    logv("app event: notification action");
}

fn on_reopen(_event: int, _data: string) -> void {
    logv("app event: reopen");
}

fn on_open_url(_event: int, _data: string) -> void {
    logv("app event: deep link opened");
}

fn on_app_started(_event: int, _data: string) -> void {
    logv("app event: started");
}

fn on_became_active(_event: int, _data: string) -> void {
    logv("app event: became active");
}

fn on_resigned_active(_event: int, _data: string) -> void {
    logv("app event: resigned active");
}

// --- Native menu action callbacks ---

fn on_about() -> void {
    log("menu action: About");
}

fn on_new_window() -> void {
    log("menu action: New Window");
}

// --- Stateful service with lifecycle ---

struct CounterService {
    count: int;
    ready: int;
}

// Global instance (lives for app lifetime)
let counter_svc = CounterService{ count: 0, ready: 0 };

fn counter_startup(ptr: void*) -> void {
    let svc = (CounterService*)ptr;
    svc.count = 0;
    svc.ready = 1;
    logv("service lifecycle: counter started");
}

fn counter_shutdown(ptr: void*) -> void {
    let svc = (CounterService*)ptr;
    logv("service lifecycle: counter shutdown");
    svc.ready = 0;
}

fn counter_query(_app: App*, _args: JsonValue*) -> string {
    // Registered via `service.register()` which auto-serializes handler calls
    // with a per-service mutex, so `counter_svc.count += 1` is safe across
    // concurrent worker invocations.
    counter_svc.count += 1;
    let c = counter_svc.count;
    raw {
        static _Thread_local char buf[64];
        snprintf(buf, sizeof(buf), "{\"count\":%d}", c);
        return buf;
    }
    return "";
}

fn run_app() -> int {
    log("initializing app...");

    let config = AppConfig{
        name: "hello-world",
        applicationShouldTerminateAfterLastWindowClosed: false,
        webContentInspectable: Zapp::inspectable_auto(),
        maxWorkers: 4,
        qjsStackSize: 0,
    };
    let app = App::new(config);
    logv("app created");

    // Simple service (no state, no lifecycle)
    app.service.add("greet", greet);
    logv("service registered: greet");

    // Bench harness service — minimal handler that just returns a
    // constant JSON. Used by src/workers/bench.ts to measure
    // invokeService round-trip latency without service work skewing
    // the number.
    app.service.add("noop", noop);
    logv("service registered: noop");

    // Stateful service with lifecycle
    let counter_impl = ServiceImpl{
        handler: counter_query,
        startup: counter_startup,
        shutdown: counter_shutdown,
    };
    app.service.register("counter", (void*)&counter_svc, &counter_impl);
    logv("service registered: counter (with lifecycle)");

    // Register app-level event handlers
    app.on(AppEvent.STARTED, on_app_started);
    app.on(AppEvent.NOTIFICATION_CLICK, on_notification_click);
    app.on(AppEvent.NOTIFICATION_ACTION, on_notification_action);
    app.on(AppEvent.REOPEN, on_reopen);
    app.on(AppEvent.DID_BECOME_ACTIVE, on_became_active);
    app.on(AppEvent.DID_RESIGN_ACTIVE, on_resigned_active);
    app.on(AppEvent.OPEN_URL, on_open_url);
    logv("app events registered");

    // Build native menu
    let about = MenuItem::item_with_action("About hello-world", on_about);
    let new_win = MenuItem::item_with_action("New Window", on_new_window);
    new_win.accelerator = "CmdOrCtrl+N";
    let sep = MenuItem::separator();
    let hide = MenuItem::item_with_role("hide");
    let quit = MenuItem::item_with_role("quit");
    quit.label = "Quit hello-world";

    let file_items = [new_win];
    let file_menu = MenuItem::item("File");
    file_menu.submenu = &file_items[0];
    file_menu.submenu_count = 1;

    let app_items = [about, sep, hide, quit];
    let app_menu = MenuItem::item("hello-world");
    app_menu.submenu = &app_items[0];
    app_menu.submenu_count = 4;

    let edit_menu = MenuItem::item_with_role("editMenu");

    let menus = [app_menu, file_menu, edit_menu];
    app.menu.set(&menus[0], 3);
    logv("menu set: app, File, Edit");

    // Register notification category with action buttons (native-first
    // API). The reply text-input action is added automatically when
    // has_reply_field=1 — its label comes from reply_button_title.
    // Setting that to "Reply" makes the in-notification button match
    // user expectation. (A separate `reply_action_title` for the menu
    // button vs. the post-typing send button is on the wishlist.)
    let delete_action = NotificationAction{ id: "delete", title: "Delete", destructive: 1 };
    let notif_actions = [delete_action];
    let msg_category = NotificationCategory{
        id: "message",
        actions: &notif_actions[0],
        action_count: 1,
        has_reply_field: 1,
        reply_placeholder: "Type reply...",
        reply_button_title: "Reply",
    };
    app.notification.register_category(&msg_category);
    logv("notification category registered: message (delete, reply field)");

    // Create window
    let opts = WindowOptions::create("hello-world");
    opts.visible = false;
    let win = app.window.create(&opts);
    logv("window created");
    win.on_ready(on_ready);

    logv("starting event loop...");
    return app.run();
}
